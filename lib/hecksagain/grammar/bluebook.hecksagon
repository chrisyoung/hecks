# The Bluebook hexagon — a grammar chapter, held in memory.
#
# A self-description is read, exercised, and discarded ; nothing here is worth
# surviving a restart. Memory is the honest binding, and it is the same one
# `expression.hecksagon` chose for the same reason.
Hecks.hecksagon "Bluebook" do
  Bluebook::Bluebook.persisted_by("Memory")
  Bluebook::Aggregate.persisted_by("Memory")
  Bluebook::Command.persisted_by("Memory")
  Bluebook::Attribute.persisted_by("Memory")
  Bluebook::ValueObject.persisted_by("Memory")
end
