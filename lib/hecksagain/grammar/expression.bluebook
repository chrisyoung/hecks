
Hecks.bluebook "Expression" do
  vision "The subset of regular Ruby a predicate is allowed to be — small enough that every target can evaluate it, and carried as canonical text so Ruby and Rust agree."
  generic

  aggregate "Operator" do
    description "One admitted operation — its symbol, its precedence, and how it reads in every target that must evaluate it."

    identified_by :symbol

    attribute :symbol,     OperatorSymbol
    attribute :category,   Category
    attribute :precedence, Precedence
    attribute :arity,      Arity
    attribute :renderings, list_of(Rendering)

    lifecycle :status, default: "proposed" do
      transition "Admit"  => "admitted", from: "proposed"
      transition "Retire" => "retired",  from: "admitted"
    end

    value_object "OperatorSymbol" do
      attribute :value, String
      invariant("an operator is written as something") { !value.to_s.empty? }
    end

    value_object "Category" do
      attribute :value, String
      invariant("an operator belongs to a category") { !value.to_s.empty? }
    end

    value_object "Precedence" do
      attribute :value, Integer
      invariant("precedence binds at some level") { value > 0 }
    end

    value_object "Arity" do
      attribute :value, Integer
      invariant("an operator takes at least one operand") { value > 0 }
    end

    value_object "Target" do
      attribute :value, String
    end

    value_object "Form" do
      attribute :value, String
    end

    value_object "Rendering" do
      attribute :target, String
      attribute :form,   String

      invariant("a rendering must name its target") { !target.to_s.empty? }
      invariant("a rendering must have a form")     { !form.to_s.empty? }
    end

    command "Propose" do
      role "Language designer"
      goal "Put an operation forward for the sublanguage"

      attribute :symbol,     OperatorSymbol
      attribute :category,   Category
      attribute :precedence, Precedence
      attribute :arity,      Arity

      emits "OperatorProposed"
    end

    command "Render" do
      role "Language designer"
      goal "Declare how this operator reads in one target"

      reference_to Operator
      attribute :target, Target
      attribute :form,   Form

      given("a retired operator takes no new renderings") { status != "retired" }

      then_set :renderings, append: { target: :target, form: :form }

      emits "OperatorRendered"
    end

    command "Admit" do
      role "Language designer"
      goal "Accept the operation into the sublanguage"

      reference_to Operator

      given("an operator must read in every target before it is admitted") { renderings.size >= 2 }

      emits "OperatorAdmitted"
    end

    command "Retire" do
      role "Language designer"
      goal "Remove an operation from the sublanguage"

      reference_to Operator

      emits "OperatorRetired"
    end
  end

  aggregate "Normalisation" do
    description "One rule that turns written source into canonical text — its boundary condition, where it sits in the order, and how it reads in every target that must apply it."

    identified_by :name

    attribute :name,         RuleName
    attribute :strategy,     Strategy
    attribute :source_token, SourceToken
    attribute :replacement,  Replacement
    attribute :boundary,     Boundary
    attribute :position,     Position
    attribute :readings,     list_of(Reading)

    lifecycle :status, default: "proposed" do
      transition "Admit"  => "admitted", from: "proposed"
      transition "Retire" => "retired",  from: "admitted"
    end

    value_object "RuleName" do
      attribute :value, String
      invariant("a rule is named") { !value.to_s.empty? }
    end

    value_object "Strategy" do
      attribute :value, String
      invariant("a rule names a strategy") { !value.to_s.empty? }
    end

    value_object "SourceToken" do
      attribute :value, String
    end

    value_object "Replacement" do
      attribute :value, String
    end

    value_object "Boundary" do
      attribute :value, String, default: "none"
      invariant("a boundary condition is named") { !value.to_s.empty? }
    end

    value_object "Position" do
      attribute :value, Integer
      invariant("a rule sits somewhere in the order") { value > 0 }
    end

    value_object "Target" do
      attribute :value, String
    end

    value_object "Form" do
      attribute :value, String
    end

    value_object "Rule" do
      attribute :strategy,     String
      attribute :source_token, String
      attribute :replacement,  String
      attribute :boundary,     String
      attribute :position,     Integer

      one_of do
        member strategy: "collapse_whitespace", source_token: "", replacement: "", boundary: "none", position: 1
        member strategy: "replace", source_token: ".length", replacement: ".size", boundary: "word", position: 2
      end
    end

    value_object "Reading" do
      attribute :target, String
      attribute :form,   String

      invariant("a reading must name its target") { !target.to_s.empty? }
      invariant("a reading must have a form")     { !form.to_s.empty? }
    end

    command "Propose" do
      role "Language designer"
      goal "Put a normalisation rule forward for the canonical form"

      attribute :name,         RuleName
      attribute :strategy,     Strategy
      attribute :source_token, SourceToken
      attribute :replacement,  Replacement
      attribute :boundary,     Boundary
      attribute :position,     Position

      given("a rule must name a linked strategy") do
        strategy.value == "collapse_whitespace" || strategy.value == "replace"
      end

      given("a rule must state its boundary") { boundary.value == "none" || boundary.value == "word" }

      emits "NormalisationProposed"
    end

    command "Read" do
      role "Language designer"
      goal "Declare how this rule reads in one target"

      reference_to Normalisation
      attribute :target, Target
      attribute :form,   Form

      given("a retired rule takes no new readings") { status != "retired" }

      then_set :readings, append: { target: :target, form: :form }

      emits "NormalisationRead"
    end

    command "Admit" do
      role "Language designer"
      goal "Accept the rule into the canonical form"

      reference_to Normalisation

      given("a rule must read in every target before it is admitted") { readings.size >= 2 }

      emits "NormalisationAdmitted"
    end

    command "Retire" do
      role "Language designer"
      goal "Remove a rule from the canonical form"

      reference_to Normalisation

      emits "NormalisationRetired"
    end
  end

  aggregate "Expression" do
    description "One predicate extracted from regular Ruby — the source as written, the canonical text both runtimes evaluate, and the subject it reads against."

    attribute :description, Description
    attribute :source,      Source
    attribute :canonical,   Canonical
    attribute :subject,     Subject
    attribute :role,        ExpressionRole
    attribute :references,  list_of(Reference)

    lifecycle :status, default: "extracted" do
      transition "Admit"  => "admitted", from: "extracted"
      transition "Reject" => "rejected", from: "extracted"
    end

    value_object "Description" do
      attribute :value, String
      invariant("a predicate says what it is for") { !value.to_s.empty? }
    end

    value_object "Source" do
      attribute :value, String
    end

    value_object "Canonical" do
      attribute :value, String
    end

    value_object "Subject" do
      attribute :value, String
      invariant("a predicate reads against something") { !value.to_s.empty? }
    end

    value_object "ExpressionRole" do
      attribute :value, String, default: "given"
      invariant("a predicate plays a role") { !value.to_s.empty? }
    end

    value_object "ReferenceName" do
      attribute :value, String
      invariant("a reference must be named") { !value.to_s.empty? }
    end

    value_object "Kind" do
      attribute :value, String
      invariant("a reference is either an attribute or an argument") do
        value.to_s == "attribute" || value.to_s == "argument"
      end
    end

    value_object "Reason" do
      attribute :value, String
      invariant("a refusal gives a reason") { !value.to_s.empty? }
    end

    value_object "Reference" do
      attribute :name, String
      attribute :kind, String

      invariant("a reference must be named") { !name.to_s.empty? }
      invariant("a reference is either an attribute or an argument") do
        kind.to_s == "attribute" || kind.to_s == "argument"
      end
    end

    command "Extract" do
      role "System"
      goal "Lower a real Ruby predicate into the sublanguage"

      attribute :description, Description
      attribute :source,      Source
      attribute :canonical,   Canonical
      attribute :subject,     Subject

      emits "ExpressionExtracted"
    end

    command "Note" do
      role "System"
      goal "Record a name the expression reads"

      reference_to Expression
      attribute :name, ReferenceName
      attribute :kind, Kind

      then_set :references, append: { name: :name, kind: :kind }

      emits "ReferenceNoted"
    end

    command "Admit" do
      role "System"
      goal "Accept the expression as evaluable by every target"

      reference_to Expression

      given("an expression must have canonical text") { !canonical.value.to_s.empty? }
      given("an expression must know its subject")    { !subject.value.to_s.empty? }

      emits "ExpressionAdmitted"
    end

    command "Reject" do
      role "System"
      goal "Refuse a predicate that leaves the sublanguage"

      reference_to Expression
      attribute :reason, Reason

      emits "ExpressionRejected"
    end
  end

  aggregate "Agreement" do
    description "One expression evaluated by every runtime against the same state — the standing proof that Ruby and Rust mean the same thing."

    attribute :canonical, Canonical
    attribute :subject,   Subject
    attribute :verdicts,  list_of(Verdict)

    lifecycle :status, default: "open" do
      transition "Settle" => "settled", from: "open"
      transition "Split"  => "split",   from: "open"
    end

    value_object "Canonical" do
      attribute :value, String
    end

    value_object "Subject" do
      attribute :value, String
      invariant("an agreement is asked about something") { !value.to_s.empty? }
    end

    value_object "Runtime" do
      attribute :value, String
      invariant("a verdict must name its runtime") { !value.to_s.empty? }
    end

    value_object "Outcome" do
      attribute :value, String
      invariant("an outcome is true, false, or error") do
        value.to_s == "true" || value.to_s == "false" || value.to_s == "error"
      end
    end

    value_object "Reason" do
      attribute :value, String
      invariant("a split gives a reason") { !value.to_s.empty? }
    end

    value_object "Verdict" do
      attribute :runtime, String
      attribute :outcome, String

      invariant("a verdict must name its runtime") { !runtime.to_s.empty? }
      invariant("an outcome is true, false, or error") do
        outcome.to_s == "true" || outcome.to_s == "false" || outcome.to_s == "error"
      end
    end

    command "Ask" do
      role "System"
      goal "Put one expression to every runtime against the same state"

      attribute :canonical, Canonical
      attribute :subject,   Subject

      emits "AgreementAsked"
    end

    command "Answer" do
      role "System"
      goal "Record what one runtime said"

      reference_to Agreement
      attribute :runtime, Runtime
      attribute :outcome, Outcome

      given("a settled agreement takes no further answers") { status == "open" }

      then_set :verdicts, append: { runtime: :runtime, outcome: :outcome }

      emits "VerdictRecorded"
    end

    command "Settle" do
      role "System"
      goal "Record that every runtime reached the same verdict"

      reference_to Agreement

      given("agreement needs at least two runtimes") { verdicts.size >= 2 }

      emits "AgreementSettled"
    end

    command "Split" do
      role "System"
      goal "Record that the runtimes disagreed — a defect in the sublanguage"

      reference_to Agreement
      attribute :reason, Reason

      emits "AgreementSplit"
    end
  end
end
