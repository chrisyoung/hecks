Hecks.bluebook "Bluebook" do
  aggregate "Policy" do
    description "One policy — the event it watches, the command it fires, and the domain that command belongs to."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME. A policy hangs off the chapter rather
    # than an aggregate, so the chapter is the part above it.
    identified_by :bluebook, :name

    attribute :name,            PolicyName
    # WHICH HEAD DECLARED IT, empty for a reaction the chapter owns.
    #
    # A policy written inside an aggregate is hoisted onto the chapter by the
    # builder, and the chapter is where the runtime reads it — so nothing was ever
    # lost at runtime. What was lost is where it was WRITTEN, which is a fact about
    # the source, and facts about the source are what this language holds.
    # `Aggregate#to_h` does not carry it and does not need to: the wire format is
    # a contract, and the language may hold more than it.
    attribute :aggregate,       PolicyText
    attribute :on_event,        PolicyText
    attribute :trigger_command, PolicyText
    attribute :target_domain,   PolicyText
    # THE GUARD, CARRIED AS TEXT — same discipline `Command.givens`
    # already holds: the block that wrote it is never called at
    # runtime, only its EXTRACTED SOURCE is (Ports::Extraction), so
    # what the language holds is the string, not a live Proc no wire
    # format could carry. Optional — most policies fire unconditionally.
    attribute :where,           PolicyText, optional: true
    # THE FAN-OUT SOURCE — a query verb ("Aggregate.query_name" or
    # "Domain::Aggregate.query_name"), same text shape as
    # `trigger_command`/`target_domain` beside it. Optional — most
    # policies fire once, not once per row.
    attribute :for_each,        PolicyText, optional: true
    # WHAT THE TRIGGER IS GIVEN, when the event's own shape is not it.
    # Empty means the whole payload forwards verbatim — what every policy
    # did before this existed, and still the right default for a trigger
    # shaped like its event.
    #
    # The same `Binding` list a saga's own `Dispatch` carries, for the
    # same reason: a reaction crosses an aggregate boundary, and the
    # event on one side is under no obligation to be shaped like the
    # command on the other. Without it the target has to declare every
    # field the event happens to carry — banking's own `FreezeAccount`
    # grew an attribute it never reads, and Account grew two duplicated
    # value objects to type it, before this word existed.
    attribute :with_spec,       list_of(Binding)

    value_object "PolicyName" do
      attribute :value, String
      invariant("a policy is named") { !value.to_s.empty? }
    end

    value_object "PolicyText" do
      attribute :value, String
    end

    # DECLARED HERE RATHER THAN SHARED WITH `Dispatch`'s own — a value
    # object belongs to the aggregate that uses it, and everything that
    # walks an aggregate's own scope has nowhere else to look.
    value_object "Binding" do
      attribute :key,   String
      attribute :value, String
    end

    # The way back: everything DECLARED IN the chapter above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — the IR is a contract read straight from this file,
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook, PolicyText
      where(bluebook: :bluebook)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Declare a policy on a chapter"

      reference_to Bluebook
      attribute :name,            PolicyName
      attribute :aggregate,       PolicyText, optional: true
      attribute :on_event,        PolicyText
      attribute :trigger_command, PolicyText
      attribute :target_domain,   PolicyText, optional: true
      attribute :where,           PolicyText, optional: true
      attribute :for_each,        PolicyText, optional: true

      attribute :position, Position, optional: true
      emits "ReactionDeclared"
    end

    command "Bind" do
      role "Language"
      goal "Bind one argument of the triggered command"

      reference_to Policy
      attribute :key,   PolicyText
      attribute :value, PolicyText

      then_set :with_spec, append: { key: :key, value: :value }

      emits "TriggerBindingAttached"
    end
  end

  aggregate "ProcessManager" do
    description "One process manager — what correlates its instances, what starts and ends it, and the states it moves through."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME — the same shape a policy takes, and for
    # the same reason.
    identified_by :bluebook, :name

    attribute :name,      ProcessManagerName
    attribute :correlates_by, ProcessManagerText
    attribute :starts_on,     ProcessManagerText
    attribute :ends_on,       ProcessManagerText
    attribute :states,    list_of(SagaState)

    value_object "ProcessManagerName" do
      attribute :value, String
      invariant("a process manager is named") { !value.to_s.empty? }
    end

    value_object "ProcessManagerText" do
      attribute :value, String
    end

    value_object "SagaState" do
      attribute :name, String
    end

    # The way back: everything DECLARED IN the chapter above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — the IR is a contract read straight from this file,
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook, ProcessManagerText
      where(bluebook: :bluebook)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a process manager on a chapter"

      reference_to Bluebook
      attribute :name,      ProcessManagerName
      attribute :correlates_by, ProcessManagerText
      attribute :starts_on,     ProcessManagerText
      # A PROCEDURE NEED NOT DECLARE AN ENDING. The runtime has always held
      # this optional — ProcessManagerBuilder defaults `@ends_on` to nil,
      # validates only correlates_by/starts_on/states/handlers,
      # and fills it only if the line is written. The
      # language was the one saying it was required, and nothing in the corpus
      # had to disagree because every procedure in it happens to end.
      attribute :ends_on,       ProcessManagerText, optional: true

      attribute :position, Position, optional: true
      emits "SagaDeclared"
    end

    command "State" do
      role "Language"
      goal "Attach one state to the process manager"

      reference_to ProcessManager
      attribute :name, ProcessManagerText

      then_set :states, append: { name: :name }

      emits "SagaStateAttached"
    end
  end

  aggregate "Handler" do
    description "One handler inside a process manager — the event it answers, the state move it makes, and the commands it sends. Its own root because a handler holds nested dispatches, which hold nested bindings."

    reference_to ProcessManager

    # THE PROCESS MANAGER IT IS IN, AND THE EVENT IT ANSWERS. A saga answers each
    # event once, so the event names the leg. The judge keyed this by POSITION
    # ("#{parent}##{index}"), which is a mint : insert a leg above and every leg
    # below is renamed. The event does not move.
    identified_by :process_manager, :event_type

    # No `saga` field. It named the old word for a process manager, held nothing —
    # ProcessManagerHandler has no such reader, so every Handler record's saga
    # was empty — and repeated the parent that `process_manager_id` already
    # carries. A field that names the wrong thing, holds nothing, and duplicates
    # the reference beside it.
    #
    # `event_type` is an event name, or one of the Trigger vocabulary's members
    # when the leg answers something no aggregate announces.
    attribute :event_type, HandlerText
    attribute :from_state, HandlerText
    attribute :to_state,   HandlerText

    value_object "HandlerText" do
      attribute :value, String
    end

    # The way back: everything DECLARED IN the process manager above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — the IR is a contract read straight from this file,
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :process_manager, HandlerText
      where(process_manager: :process_manager)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a handler inside a process manager"

      reference_to ProcessManager
      attribute :event_type, HandlerText
      # A LEG ALWAYS SAYS WHERE IT MOVES FROM. There is no wildcard leg to be
      # optional for: `on "Event", transition: { from => to }` is the only
      # spelling the runtime reads, and it refuses anything else —
      # `single_transition` raises unless the hash holds exactly one from => to
      # pair, so a leg without one
      # is never built at all. `optional: true` here was
      # the language admitting a leg the runtime cannot parse.
      attribute :from_state, HandlerText
      attribute :to_state,   HandlerText

      attribute :position, Position, optional: true
      emits "LegDeclared"
    end
  end

  aggregate "Dispatch" do
    description "One command a handler dispatches, with the arguments it binds. Its own root because the bindings are an open map, which no value object can hold."

    reference_to Handler

    # THE HANDLER IT IS IN, AND THE COMMAND IT SENDS — keyed by position before,
    # for the same want of a way to say this. `handler` resolves through the
    # reference above, the same way Handler's own `process_manager` does —
    # not a duplicate text attribute (that collided with the bare reference's
    # own mint under ADR 0025, and clobbered it in the args hash: the two
    # shared one key, and whichever attribute's coercion ran last won).
    identified_by :handler, :command_name

    attribute :command_name, DispatchText
    attribute :with_spec,    list_of(Binding)

    value_object "DispatchText" do
      attribute :value, String
    end

    value_object "Binding" do
      attribute :key,   String
      attribute :value, String
    end

    # The way back: everything DECLARED IN the handler above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — the IR is a contract read straight from this file,
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :handler, DispatchText
      where(handler: :handler)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a dispatch inside a handler"

      reference_to Handler
      attribute :command_name, DispatchText

      attribute :position, Position, optional: true
      emits "SendDeclared"
    end

    command "Bind" do
      role "Language"
      goal "Bind one argument of the dispatched command"

      reference_to Dispatch
      attribute :key,   DispatchText
      attribute :value, DispatchText

      then_set :with_spec, append: { key: :key, value: :value }

      emits "BindingAttached"
    end
  end
end
