Hecks.bluebook "Hecksagon" do
  aggregate "PortOperation" do
    description "One operation a port exposes — the same shape a command's payload has (attributes in, an event out) with none of a command's given/ensures/sets : a port operation is the translation boundary itself, not a second place business rules live. Those stay on whichever command a policy triggers in reaction to the event it emits."

    identified_by OperationName, as: :name

    attribute :attributes, list_of(PortOperationField)
    attribute :emits,      list_of(EmittedEvent)

    # THE TWO ENDINGS OF AN `asks`, held by the language about itself.
    #
    # `emits` above is what an inbound `tells` says once the fact is in.
    # These two are the outbound half: what the adapter came back with, and
    # what it said instead. Singular where `emits` is a list, because an ask
    # has exactly one of each — a call that could answer two different ways
    # is two calls.
    #
    # Empty on every `tells`, which is why neither carries an invariant
    # demanding a value; `PortOperationBuilder` refuses the wrong word for
    # the direction long before a record gets here.
    attribute :answers,    AnsweringEvent
    attribute :refuses,    RefusingEvent

    value_object "OperationName" do
      attribute :value, String
      invariant("an operation is named") { !value.to_s.empty? }
    end

    value_object "PortOperationField" do
      attribute :name, String
      attribute :type, String
    end

    value_object "EmittedEvent" do
      attribute :value, String
      invariant("an emitted event is named") { !value.to_s.empty? }
    end

    value_object "AnsweringEvent" do
      attribute :value, String
    end

    value_object "RefusingEvent" do
      attribute :value, String
    end

    # HOW PORTOPERATION IS SPELLED. These rows live with the concept
    # they describe; SyntaxBoot discovers every aggregate-local seed table.
    # Contexts represented here: PortOperation.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "reference_to",    context: "PortOperation", body: "none",     inner: "",              opens: "",              fills: "attributes", calls: "reference_to_impl"
      member word: "attribute",       context: "PortOperation", body: "none",     inner: "",              opens: "",              fills: "attributes", calls: "attribute_impl"
      member word: "emits",           context: "PortOperation", body: "none",     inner: "",              opens: "",              fills: "emits"
      member word: "answers",         context: "PortOperation", body: "none",     inner: "",              opens: "",              fills: "answers"
      member word: "refuses",         context: "PortOperation", body: "none",     inner: "",              opens: "",              fills: "refuses"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "reference_to",    context: "PortOperation", at: "1", named: "", kind: "constant", required: "true", fills: "type"
      member keyword: "reference_to",    context: "PortOperation", at: "",  named: "as", kind: "symbol", required: "false", fills: "name"
      member keyword: "attribute",       context: "PortOperation", at: "1", named: "",        kind: "symbol",   required: "true",  fills: "name"
      member keyword: "attribute",       context: "PortOperation", at: "2", named: "",        kind: "constant", required: "true",  fills: "type"
      member keyword: "attribute",       context: "PortOperation", at: "",  named: "default",  kind: "literal",  required: "false", fills: "default"
      member keyword: "attribute",       context: "PortOperation", at: "",  named: "optional", kind: "flag",     required: "false", fills: "optional"
      member keyword: "attribute",       context: "PortOperation", at: "",  named: "pattern",  kind: "text",     required: "false", fills: "pattern"
      member keyword: "attribute",       context: "PortOperation", at: "",  named: "admits",   kind: "text",     required: "false", fills: "admits"
      member keyword: "attribute",       context: "PortOperation", at: "",  named: "one_of",   kind: "list",     required: "false", fills: "one_of"
      member keyword: "emits",           context: "PortOperation", at: "1", named: "", kind: "text", required: "true", fills: "emits"
      member keyword: "answers",         context: "PortOperation", at: "1", named: "", kind: "text", required: "true", fills: "answers"
      member keyword: "refuses",         context: "PortOperation", at: "1", named: "", kind: "text", required: "true", fills: "refuses"

    end
  end
end
