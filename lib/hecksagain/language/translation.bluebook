Hecks.bluebook "Translation" do
  vision "The data_translation language, declared in itself. A translation names how one era of a domain's own stored data becomes the next — per aggregate, a table of rules (rename, move, convert, drop, retype, compute, rekey, backfill) or a deliberate acknowledgment that a rule is still unresolved."
  core

  aggregate "Translation" do
    description "One translations/*.bluebook edge — a domain moving from one pinned era to the next, aggregate by aggregate."

    identified_by :domain, :from, :to

    attribute :domain, TranslationDomainName
    attribute :from,   TranslationEraName
    attribute :to,     TranslationEraName
    attribute :retired, list_of(TranslationName)

    value_object "TranslationDomainName" do
      attribute :value, String
      invariant("a translation names its domain") { !value.to_s.empty? }
    end

    value_object "TranslationEraName" do
      attribute :value, String
      invariant("a translation names its own era") { !value.to_s.empty? }
    end

    value_object "TranslationName" do
      attribute :value, String
      invariant("a name says something") { !value.to_s.empty? }
    end

    # ARBITRARY, UNVALIDATED CAPTURE — `convert`'s own `values:` table and
    # `backfill`'s own `default:` are open-ended (any literal a real
    # migration needs), the same shape `AggregateBuilder#provenance`/
    # `CommandBuilder#provenance` already capture as plain, unvalidated
    # text (`LiteralText`, aggregate.bluebook) rather than a fixed
    # attribute shape a closed self-hosted record could enumerate.
    value_object "TranslationLiteralText" do
      attribute :value, String
    end

    command "Declare" do
      role "Deployment"
      goal "Open a domain's own move from one pinned era to the next"

      attribute :domain, TranslationDomainName
      attribute :from,   TranslationEraName
      attribute :to,     TranslationEraName

      emits "TranslationDeclared"
    end

    command "Retire" do
      role "Deployment"
      goal "Name an aggregate the new era drops outright, not renamed"

      reference_to Translation
      attribute :value, TranslationName

      sets :retired, append: { value: :value }

      emits "TranslationAggregateRetired"
    end
  end

  aggregate "TranslationAggregate" do
    description "One aggregate's own move from one pinned era to the next — a table of rules, or a deliberate acknowledgment that a rule is still unresolved."

    identified_by :name

    # `TranslationAggregateName` — a DEDICATED type for the identity
    # field, not the shared `TranslationName` every non-identity field
    # below uses. Found live, not by inspection: reusing one value-
    # object type for BOTH an aggregate's own identity field and a
    # sibling non-identity field on the same aggregate broke the
    # single-field-VO identity-unwrap path — the stored `id` came back
    # as a stringified Hash (`"{:value=>\"Account\"}"`) instead of the
    # bare scalar (`"Account"`), so a self-reference to this aggregate
    # could never find the record `Declare` had just created. Reusing
    # the SAME type across MULTIPLE identity fields (Translation's own
    # `TranslationEraName`, for both `from` and `to`) is unaffected —
    # confirmed directly, not assumed — so the real trigger is identity
    # + non-identity sharing, not reuse itself. A genuine framework bug,
    # out of scope to fix here; every other self-hosted construct in
    # this language already avoids it by convention (a dedicated type
    # per identity field), which this now matches too.
    attribute :name, TranslationAggregateName
    attribute :was,  TranslationName, optional: true

    value_object "TranslationAggregateName" do
      attribute :value, String
      invariant("a translation aggregate names itself") { !value.to_s.empty? }
    end

    attribute :renames,   list_of(TranslationRename)
    attribute :moves,     list_of(TranslationMove)
    attribute :converts,  list_of(TranslationConvert)
    attribute :drops,     list_of(TranslationName)
    attribute :retypes,   list_of(TranslationRetype)
    attribute :computes,  list_of(TranslationCompute)
    attribute :rekeys,    list_of(TranslationRekey)
    attribute :backfills, list_of(TranslationBackfill)

    # Field names throughout mirror lib/hecksagain/bluebook/translation.rb
    # EXACTLY (`Struct.new(:from, :to)` etc.) — the real Ruby records
    # TranslationJudge dispatches from, not the builder's own local
    # parameter names (`move(old_path, to:)`'s `old_path` becomes the
    # struct's own `from`).
    value_object "TranslationRename" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationMove" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationConvert" do
      attribute :from,   TranslationName
      attribute :to,     TranslationName
      attribute :values, TranslationLiteralText
    end

    value_object "TranslationRetype" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationCompute" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
      attribute :sql,  TranslationLiteralText
    end

    value_object "TranslationRekey" do
      attribute :sql, TranslationLiteralText
    end

    value_object "TranslationBackfill" do
      attribute :name,    TranslationName
      attribute :default, TranslationLiteralText
    end

    command "Declare" do
      role "Deployment"
      goal "Open one aggregate's own move from one pinned era to the next"

      attribute :name, TranslationAggregateName
      attribute :was,  TranslationName, optional: true

      emits "TranslationAggregateDeclared"
    end

    command "AddRename" do
      role "Deployment"
      goal "Move data at an old field name to its new one, unchanged"

      reference_to TranslationAggregate
      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :renames, append: { from: :from, to: :to }

      emits "TranslationRenameAdded"
    end

    command "AddMove" do
      role "Deployment"
      goal "Move data at an old path to a new one, unchanged"

      reference_to TranslationAggregate
      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :moves, append: { from: :from, to: :to }

      emits "TranslationMoveAdded"
    end

    command "AddConvert" do
      role "Deployment"
      goal "Move data at an old path to a new one, translating its own values through an exhaustive table"

      reference_to TranslationAggregate
      attribute :from,   TranslationName
      attribute :to,     TranslationName
      attribute :values, TranslationLiteralText

      sets :converts, append: { from: :from, to: :to, values: :values }

      emits "TranslationConvertAdded"
    end

    command "AddDrop" do
      role "Deployment"
      goal "Acknowledge, deliberately, that a field's own data does not survive"

      reference_to TranslationAggregate
      attribute :value, TranslationName

      sets :drops, append: { value: :value }

      emits "TranslationDropAdded"
    end

    command "AddRetype" do
      role "Deployment"
      goal "Declare that an old type name and a new one mean the same shape"

      reference_to TranslationAggregate
      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :retypes, append: { from: :from, to: :to }

      emits "TranslationRetypeAdded"
    end

    command "AddCompute" do
      role "Deployment"
      goal "Move data at an old path to a new one, transformed by a real SQL expression"

      reference_to TranslationAggregate
      attribute :from, TranslationName
      attribute :to,   TranslationName
      attribute :sql,  TranslationLiteralText

      sets :computes, append: { from: :from, to: :to, sql: :sql }

      emits "TranslationComputeAdded"
    end

    command "AddRekey" do
      role "Deployment"
      goal "Recompute this aggregate's own identity by a real SQL expression"

      reference_to TranslationAggregate
      attribute :sql, TranslationLiteralText

      sets :rekeys, append: { sql: :sql }

      emits "TranslationRekeyAdded"
    end

    command "AddBackfill" do
      role "Deployment"
      goal "Name a newly required attribute and the value an existing record reads until written for real"

      # `as: :aggregate` — REQUIRED here, the same reason Wiring.Set's
      # own `reference_to World, as: :world_ref` is (world.bluebook): this
      # command ALSO holds an ordinary `name` text attribute below (the
      # backfilled FIELD's own name, a value rather than a reference), so
      # the bare reference name would collide with it.
      reference_to TranslationAggregate, as: :aggregate
      attribute :name,    TranslationName
      attribute :default, TranslationLiteralText

      sets :backfills, append: { name: :name, default: :default }

      emits "TranslationBackfillAdded"
    end
  end
end
