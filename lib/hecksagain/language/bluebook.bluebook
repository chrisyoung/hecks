Hecks.bluebook "Meta" do
  vision "The bluebook language, declared in itself. Loading a domain becomes dispatching commands into this meta-domain ; the IR it stores must equal the IR the DSL builder produces. The floor that stays hand-written is the interpreter — evaluating a predicate held as data — and IO."
  core

  # A WHOLE BLUEBOOK, handed back in one read.
  #
  # The twelve `DeclaredIn` queries below can walk the tree a level at a time, and
  # a caller stitching twelve reads together is a caller reimplementing this. The
  # language already knows how to say "gather these heads around that spine" —
  # it is what a read model IS — so the reconstruction is DECLARED rather than
  # coded, and the shape of what comes back is a fact about the language instead
  # of a fact about whoever wrote the reader.
  #
  # Spined on Bluebook because a bluebook is what you ask for. Everything else
  # hangs off it, down to a Member's pairs and a Dispatch's bindings.
  read_model "WholeBluebook" do
    description "Every declaration of one chapter, gathered around the chapter itself — the way back, in a single read."
    reference_to Bluebook

    include Bluebook
    include Aggregate
    include Command
    include ValueObject
    include Query
    include Entity
    include Member
    include Policy
    include ProcessManager
    include Handler
    include Dispatch
    include ReadModel
  end

  aggregate "Bluebook" do
    description "One .bluebook file — the root a domain declaration hangs from."

    # A CHAPTER IS KNOWN BY ITS NAME, which is what anyone would have said.
    #
    # It was not, and the reason it was not is worth keeping : the runtime read the
    # identity out of the payload under its head's own name, so a command that both
    # REACHED a bluebook and carried a name could not say both, and `Normalise`
    # could never name what it acts on. The answer at the time was to duck it —
    # keep `name` a plain field and be reached by a minted `id` like nothing else
    # in the language.
    #
    # The duck is what is gone. A command reaches its root through the REFERENCE it
    # declares (`bluebook_id`), which is a different key from any argument it
    # carries, so the two cannot collide however they are spelled. The fallback was
    # hiding a lookup bug ; removing it made the bug visible, and the bug was the
    # smaller thing.
    identified_by { name.value }

    attribute :name,           BluebookName
    attribute :vision,         Vision
    attribute :classification, Classification
    # A domain CONTRACT version, pinned per chapter — `Hecks.bluebook "Pizzas",
    # version: "v2"`. Held here because the language must hold everything the
    # runtime runs on, and this was the one field it did not: the round trip sliced
    # its comparison by the reconstruction's own keys, so a version was excluded
    # from the check rather than failing it, and a chapter assembled purely from
    # these records would have lost it in silence. Most chapters declare none, and
    # ABSENT IS NOT EMPTY — an unversioned chapter offers nothing here at all.
    attribute :version,        Version
    attribute :normalisations, list_of(NormalisationRule)

    value_object "RuleText" do
      # deliberately permissive : source_token and replacement are legitimately
      # empty for the collapse_whitespace rule
      attribute :value, String
    end

    value_object "NormalisationRule" do
      attribute :strategy,     String
      attribute :source_token, String
      attribute :replacement,  String
      attribute :boundary,     String
      attribute :position,     String
    end

    value_object "BluebookName" do
      attribute :value, String
      invariant("a chapter is named") { !value.to_s.empty? }
    end

    value_object "Vision" do
      attribute :value, String
      invariant("a vision says something") { !value.to_s.empty? }
    end

    value_object "Classification" do
      attribute :value, String
      invariant("a chapter is core, supporting, or generic") do
        value.to_s == "core" || value.to_s == "supporting" || value.to_s == "generic"
      end
    end

    value_object "Version" do
      attribute :value, String
      invariant("a version says something") { !value.to_s.empty? }
    end

    command "Declare" do
      role "Language"
      goal "Open a chapter"

      attribute :name,           BluebookName
      attribute :vision,         Vision, optional: true
      attribute :classification, Classification, optional: true
      attribute :version,        Version, optional: true

      emits "ChapterDeclared"
    end

    # THE WAY BACK.
    #
    # Until these existed the meta-domain was write-only: twelve categories, 34
    # verbs, and not one query. A bluebook could be dispatched in and never read
    # out, which is exactly as much as JUDGING requires — offer every declaration,
    # collect the refusals, throw the records away. It is also why the language
    # could only validate. A store you cannot read cannot be the source of
    # anything, and "loading a domain becomes dispatching commands into this
    # meta-domain" — the vision at the top of this file — needs the records to
    # come back out as the IR the runtime runs.
    # Named to finish a sentence about the thing, the way every other query in the
    # corpus is — pizzas COSTING LESS THAN a ceiling, orders PENDING, cards
    # ACTIVE. So: the bluebook CALLED "Pizzas".
    query "Called" do
      attribute :name, BluebookName
      where(name: :name)
    end

    command "Normalise" do
      role "Language"
      goal "Attach one canonical-form rule to the chapter"

      reference_to Bluebook
      attribute :strategy,     RuleText
      attribute :source_token, RuleText
      attribute :replacement,  RuleText
      attribute :boundary,     RuleText
      attribute :position,     RuleText, optional: true

      then_set :normalisations, append: {
        strategy: :strategy, source_token: :source_token,
        replacement: :replacement, boundary: :boundary, position: :position
      }

      emits "NormalisationAttached"
    end
  end

  aggregate "Aggregate" do
    description "One aggregate inside a chapter — the head a domain's declarations attach to."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME. `Order` names nothing on its own — two
    # chapters may both declare one — so the chapter is part of the identity, not
    # context around it. This is the derivation `MetaValidator::Judge#identify`
    # spelled by hand as "#{parent_id}::#{name}" for as long as the language could
    # not say it.
    identified_by do
      bluebook_id
      name.value
    end

    # SPELLED AS THE IR SPELLS THEM — see the note on Command's fields.
    attribute :name,          AggregateName
    attribute :description,   Description
    # SEVERAL PATHS, because the identity is their JOIN. One is the ordinary case ;
    # more than one is what anything named BENEATH another thing needs, and the
    # language's own chapters are all of that kind — a command is not named by
    # `Declare`, which every aggregate here spells, but by the aggregate it belongs
    # to AND that name. Held as a list for the same reason attributes are : the
    # order is a fact about the source, and the join reads in it.
    attribute :identified_by, list_of(IdentityPath)
    attribute :attributes,    list_of(Field)
    attribute :value_objects, list_of(ValueName)
    attribute :state_field,   IdentityField
    attribute :state_start,   IdentityField
    attribute :transitions,   list_of(Transition)

    value_object "AggregateName" do
      attribute :value, String
      invariant("an aggregate is named") { !value.to_s.empty? }
    end

    value_object "Description" do
      attribute :value, String
      invariant("a description says something") { !value.to_s.empty? }
    end

    value_object "IdentityField" do
      attribute :value, String
    end

    # ONE PART OF AN IDENTITY — a path down to the SCALAR that carries it, like
    # "number.value". A part on its own is not an identity ; the identity is every
    # part joined, in the order they were declared.
    #
    # Its field is `value`, like every other one-field value object in this
    # language, because that is the name the judge wraps a cell under. Spelling it
    # `path` made `path.path` read nothing, and a given that reads nothing does not
    # fail — it refuses everything, which is a far quieter way to be wrong.
    value_object "IdentityPath" do
      attribute :value, String
    end

    value_object "Field" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      # Held as a LITERAL, written so its type survives — 0.0 rather than "0.0".
      # Without this an aggregate attribute's default was simply dropped, and the
      # reconstruction hardcoded nil, which happened to match every corpus member
      # and would have lied about the first one that declared a default.
      attribute :default, String
    end

    value_object "ValueName" do
      attribute :name, String
    end

    value_object "Transition" do
      attribute :command,    String
      attribute :from_state, String
      attribute :to_state,   String
    end

    command "Declare" do
      role "Language"
      goal "Open an aggregate inside a chapter"

      reference_to Bluebook
      attribute :name,          AggregateName
      attribute :description,   Description, optional: true

      attribute :position, Position, optional: true
      emits "RootDeclared"
    end

    # ONE PART OF THE IDENTITY, attached the way one attribute is. It was an
    # argument on Declare while an identity was a single field ; a list cannot be
    # carried by one argument, and every other list in this language is filled by
    # a verb of its own, so this is the shape that was already here.
    command "Identify" do
      role "Language"
      goal "Attach one part of the aggregate's identity"

      reference_to Aggregate
      attribute :path, IdentityPath

      # AN IDENTITY PART REACHES A SCALAR. This rule used to sit on Seal reading
      # `empty? || == "id" || includes(".")` — two escapes and a check. The escapes
      # were the whole of it : `empty?` let an aggregate say nothing and be given a
      # minted `id`, and `== "id"` let it name that slot outright. Both are gone,
      # so what is left is the rule itself, and it now runs on every part rather
      # than on whichever one a single field happened to hold.
      #
      # TWO WAYS TO REACH ONE. A path opens a value object and names the field
      # inside it — `number.value`. A REFERENCE is already a scalar : it holds
      # another root's id, so there is nothing to open, which is precisely what the
      # retired `== "id"` escape was true about and wrong to generalise from. The
      # language MINTS the `_id` ending itself in `reference_to`, so reading it here
      # is reading the language's own spelling, not guessing at a convention.
      #
      # Said with `include?` rather than `end_with?` because `include?` is a word
      # the predicate sublanguage HAS and `end_with?` is not — and a given written
      # in words the sublanguage cannot read does not fail loudly, it simply refuses
      # everything, which is how the first draft of this rule refused `name.value`.
      given("an identity part reaches a scalar") { path.value.to_s.include?(".") || path.value.to_s.include?("_id") }

      then_set :identified_by, append: { value: :path }
      emits "RootIdentified"
    end

    # The way back, one level down: the aggregates DECLARED IN a chapter, found by
    # the chapter that declared them. The parent reference IS the query.
    #
    # `bluebook_id` is an IdentityField, not an AggregateName — it holds the id of
    # the chapter above, and calling that a name for aggregates was sloppiness that
    # would read as a lie the first time somebody looked.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook_id, IdentityField
      where(bluebook_id: :bluebook_id)
      order_by :position
    end

    command "Attribute" do
      role "Language"
      goal "Attach one attribute to the aggregate"

      reference_to Aggregate
      # The TYPE is a reference to the value object it names. An attribute
      # naming an undeclared value object then fails REFERENCE RESOLUTION —
      # "no Shape with id …" — with no predicate at all.
      #
      # This is the rule "attributes must use value-object types", which could
      # not be a `given` : it needs, for each element of a list, a check against
      # another list, and the sublanguage has no quantifier and cannot see
      # inside a list element. As a reference it stops being a predicate and
      # becomes a consequence of the model.
      reference_to ValueObject, as: :type
      attribute :name,    FieldName
      attribute :list,    ListFlag
      attribute :optional, ListFlag, optional: true
      attribute :pattern,  ListFlag, optional: true
      attribute :default, LiteralText, optional: true

      then_set :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "AttributeAttached"
    end

    # An attribute that points at ANOTHER aggregate's head.
    #
    # `Attribute` types its type as `reference_to ValueObject`, which is what makes
    # "attributes use value-object types" a consequence of the model rather than a
    # predicate. A cross-aggregate reference cannot go through it: its type is
    # `Reference<Customer>`, which is not a value object and never will be. So the
    # judge SKIPPED every one of them, and the meta-domain did not hold
    # Account#customer_id at all — the way back was lossy for exactly one
    # construct, and the comment excusing it said "the language does not model
    # reference-typed attributes yet".
    command "Reference" do
      role "Language"
      goal "Attach an attribute that points at another aggregate's head"

      reference_to Aggregate
      # POINTS AT a declared head, and that is the whole rule.
      #
      # This carried `attribute :type, ReferenceType` — a STRING — with an invariant
      # apologising for itself, because the shape that actually tells a reference
      # from a value object (`Reference<Something>`) is unsayable in the predicate
      # sublanguage. That was never a sublanguage gap; a string was simply the wrong
      # model. As a reference it stops being a predicate and becomes a consequence
      # of the model, exactly as Attribute's type does — and it is STRONGER than the
      # prefix match, which only ever checked that the text looked right.
      reference_to Aggregate, as: :points_at
      attribute :name,    FieldName
      attribute :list,    ListFlag
      attribute :optional, ListFlag, optional: true
      attribute :pattern,  ListFlag, optional: true
      attribute :default, LiteralText, optional: true

      then_set :attributes, append: { name: :name, type: :points_at, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "ReferenceAttached"
    end

    # An attribute whose type names a PIECE this aggregate holds.
    #
    # `Account#ledger` is a list of LedgerEntry — neither a value object nor another
    # aggregate's head — so it fitted no verb and the walk skipped it, the last
    # construct the way back could not carry. Same trick as Reference: point at the
    # entity's own declaration, and "an aggregate holds a piece it declared" costs
    # no predicate at all. Entities are declared before attributes are offered, so
    # the reference resolves.
    command "Holds" do
      role "Language"
      goal "Attach an attribute whose type is a piece of this aggregate"

      reference_to Aggregate
      reference_to Entity, as: :holds
      attribute :name,    FieldName
      attribute :list,    ListFlag
      attribute :optional, ListFlag, optional: true
      attribute :pattern,  ListFlag, optional: true
      attribute :default, LiteralText, optional: true

      then_set :attributes, append: { name: :name, type: :holds, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "PieceHeld"
    end

    # THE ONLY RULE THAT CAN REFUSE AN UNNAMED ATTRIBUTE, and it lives here.
    #
    # Attribute, Reference and Holds each carried `given("… is named")` beside
    # this, and not one of them could ever fire: an EMPTY name builds the value
    # object and this invariant refuses first, while an ABSENT name builds no
    # value object and the given did not refuse at all — probed, not reasoned.
    # Three rules that read as rules and were decoration. A predicate cannot
    # guard what a type already guards.
    value_object "FieldName" do
      attribute :value, String
      invariant("an attribute is named") { !value.to_s.empty? }
    end

    value_object "TypeName" do
      attribute :value, String
      invariant("a type is named") { !value.to_s.empty? }
    end

    # A literal written the way it can be read back — see Readings#encode_literal.
    value_object "LiteralText" do
      attribute :value, String
    end

    value_object "ListFlag" do
      attribute :value, String
      invariant("list is true or false") { value.to_s == "true" || value.to_s == "false" }
    end

    command "Lifecycle" do
      role "Language"
      goal "Name the field this aggregate's state machine runs on"

      reference_to Aggregate
      attribute :state_field, FieldName
      attribute :state_start, FieldName

      then_set :state_field, to: :state_field
      then_set :state_start, to: :state_start

      emits "LifecycleNamed"
    end

    command "Transition" do
      role "Language"
      goal "Attach one transition to the state machine"

      reference_to Aggregate
      attribute :command,    FieldName
      attribute :from_state, FieldName, optional: true
      attribute :to_state,   FieldName

      then_set :transitions, append: { command: :command, from_state: :from_state, to_state: :to_state }

      emits "TransitionAttached"
    end

    command "Seal" do
      role "Language"
      goal "Close an aggregate — the checks that need every declaration present"

      # The builders validate at `build`, once everything is collected. A given
      # fires at DISPATCH, when later declarations do not exist yet. So the
      # whole-document rules live on a command dispatched after the aggregate
      # is fully declared. This is the shape the tier-3 rules need ; whether
      # the sublanguage can express their CONTENT is the open question.
      reference_to Aggregate

      # THE RULE THAT WAS HERE WAS NOT TRUE, and nothing could tell us while Seal
      # went undispatched. `given("an aggregate declares at least one attribute")`
      # was invented for this command — it is not one of the rules ported from the
      # builders, so no bluebook was ever written against it. The first time it
      # ran it refused twenty-five of them, including every aggregate whose state
      # is a `lifecycle` rather than an `attribute` : a state machine declares no
      # attribute and is perfectly well formed.
      #
      # Seal stays. It is the right SHAPE for a whole-document rule — dispatched
      # once every declaration is present — and it is now actually dispatched, so
      # the next rule put here will be seen refusing instead of sitting decorative.
      # The rule waiting for it is "a mutation names a field the aggregate has",
      # which lives in AggregateBuilder today because saying it here needs to reach
      # a list on another root.
      # AN AGGREGATE SAYS WHAT IT IS KNOWN BY. Nothing falls back to `id` any more.
      #
      # The fallback was never a default — it was a MINT. An aggregate that said
      # nothing got an id invented for it, so the same declaration named a
      # different record on the next run, and nothing outside the runtime could
      # name a record at all. The rule that stood here permitted it in as many
      # words (`empty? || == "id"`), and the comment named exactly who was
      # leaning on it : the language's own chapters, all fourteen of them.
      #
      # They derive now, like everything else does. What each PART must look like
      # is Identify's rule ; this one only asks that there be one.
      given("an aggregate says what it is known by") { !identified_by.empty? }

      emits "RootSealed"
    end

    command "Value" do
      role "Language"
      goal "Declare a value object belonging to this aggregate"

      reference_to Aggregate
      attribute :name, FieldName

      then_set :value_objects, append: { name: :name }

      emits "ValueDeclared"
    end
  end

  aggregate "Command" do
    description "One command declared on an aggregate — its arguments, its rules, and what it announces."

    reference_to Aggregate

    # WHICH PIECE DECLARED IT, when a piece did. A command argument with no
    # attribute to land in does not persist — the same lesson `disputed_by` taught
    # on CardPayment — so the field has to exist here for Command.Declare's
    # `entity_id` to be held at all.
    reference_to Entity, as: :entity_id

    # SPELLED AS THE IR SPELLS THEM. The judge walks a built IR and offers each
    # field by name, so a field named differently here would need a translation
    # table between two vocabularies for the same thing — and a table is a place
    # to be wrong quietly. One spelling, and the walk reads straight through.
    # THE IMMEDIATE OWNER, AND ITS NAME. Almost every chapter declares a
    # `Declare` ; the owner is what tells one from another.
    #
    # `owner_id` NOT `aggregate_id` : a command declared on an ENTITY is that
    # entity's, not its aggregate's — `Banking:Account:LedgerEntry:Amend` is
    # LedgerEntry's Amend, and `Banking:Account:LedgerEntry` is what tells it
    # apart from a same-named command on some OTHER entity of the same
    # aggregate. `aggregate_id` (kept, below, as data) still names the true
    # root, for the DeclaredIn walk that gathers every command under a
    # chapter’s aggregate whichever piece declared it ; `owner_id` names only
    # whichever declared THIS one. `owner_id` is not a declared attribute —
    # it is the WALK's immediate parent, read the same way `position` is.
    identified_by do
      owner_id
      name.value
    end

    attribute :name,       CommandName
    attribute :role,       Actor
    attribute :goal,       Goal
    attribute :emits,      list_of(Announcement)
    attribute :references, EventName
    attribute :attributes, list_of(Argument)
    attribute :givens,     list_of(Rule)
    attribute :mutations,  list_of(Change)

    value_object "CommandName" do
      attribute :value, String
      invariant("a command is named") { !value.to_s.empty? }
    end

    value_object "Actor" do
      attribute :value, String
      # RELAXED for the experiment : banking leaves 19 of 40 commands without a
      # role, and the hand-written CommandBuilder never required one. Whether
      # role/goal are mandatory is a language decision — the meta-domain found
      # the drift the moment it enforced uniformly.
    end

    value_object "Goal" do
      attribute :value, String
      # RELAXED — see Actor above.
    end

    value_object "EventName" do
      attribute :value, String
    end

    value_object "Announcement" do
      attribute :name, String
    end

    value_object "Argument" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      attribute :default, String
    end

    value_object "Rule" do
      attribute :description, String
      attribute :canonical,   String
    end

    value_object "Change" do
      attribute :target, String
      attribute :op,     String
      attribute :field,  String
      attribute :kind,   String
      attribute :source, String
    end

    # A plain string holder, for the id of the aggregate above. Command had no
    # generic text value object and the alternatives all meant something else —
    # RuleText is a predicate, FieldRef is a field, ArgType is a type. Reusing one
    # of those would read as a lie, the way `bluebook_id` typed AggregateName did.
    value_object "CommandText" do
      attribute :value, String
    end
    # The way back: everything DECLARED IN the aggregate above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate_id, CommandText
      where(aggregate_id: :aggregate_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a command on an aggregate"

      reference_to Aggregate
      # DECLARED ON AN AGGREGATE, or on one of its ENTITIES. The IR uses the same
      # Command for both — an entity's commands are IR::Command objects — so the
      # language uses the same Command, and says which piece declared it when a piece
      # did. Absent for an aggregate's own commands, and ABSENT is not EMPTY.
      reference_to Entity, as: :entity_id, optional: true
      attribute :name,  CommandName
      attribute :role,  Actor, optional: true
      attribute :goal,  Goal, optional: true

      attribute :position, Position, optional: true
      emits "VerbDeclared"
    end

    command "Argument" do
      role "Language"
      goal "Attach one argument to the command"

      reference_to Command
      attribute :name,    ArgName
      attribute :type,    ArgType
      attribute :list,    ArgType
      attribute :optional, ArgType, optional: true
      attribute :pattern,  ArgType, optional: true
      attribute :default, ArgType, optional: true

      then_set :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "ArgumentAttached"
    end

    # An argument that points at ANOTHER aggregate's head — the same word
    # `reference_to`, written on a command instead of on the head.
    #
    # `Argument` types its type as text, so a reference argument arrived as the
    # STRING "Reference<Customer>" and the language held a spelling rather than a
    # reference. That left "a reference points at a declared head" enforceable
    # only by a `raise Malformed` in the DSL, for three of the four places the
    # word can be written. As a reference it is a consequence of the model here
    # too, exactly as Aggregate.Reference made it one on a head.
    command "Reference" do
      role "Language"
      goal "Attach an argument that points at another aggregate's head"

      reference_to Command
      reference_to Aggregate, as: :points_at
      # No `given` that the name is present : ArgName already carries that
      # invariant, and a value object's invariant fires during coercion — before
      # any given is reached. A rule that cannot be the one to refuse is
      # decoration, and this language has paid for that mistake before.
      attribute :name,    ArgName
      attribute :list,    ArgType
      attribute :optional, ArgType, optional: true
      attribute :pattern,  ArgType, optional: true
      attribute :default, ArgType, optional: true

      then_set :attributes, append: { name: :name, type: :points_at, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "ArgumentReferenceAttached"
    end

    value_object "ArgName" do
      attribute :value, String
      invariant("an argument is named") { !value.to_s.empty? }
    end

    value_object "ArgType" do
      attribute :value, String
      # list / default reuse this shape and are legitimately empty
    end

    command "Rule" do
      role "Language"
      goal "Attach one given to the command"

      reference_to Command
      attribute :description, RuleText, optional: true
      attribute :canonical,   RuleText

      given("a rule says what it means")  { !description.value.to_s.empty? }
      given("a rule survives extraction") { !canonical.value.to_s.empty? }

      then_set :givens, append: { description: :description, canonical: :canonical }

      emits "RuleAttached"
    end

    value_object "RuleText" do
      attribute :value, String
    end

    command "Change" do
      role "Language"
      goal "Attach one mutation to the command"

      reference_to Command
      attribute :target, FieldRef
      attribute :op,     OpName
      attribute :field,  FieldRef
      attribute :kind,   FieldRef
      attribute :source, FieldRef

      given("a mutation names a target")     { !target.value.to_s.empty? }
      given("a mutation does something")     { !op.value.to_s.empty? }

      then_set :mutations, append: { target: :target, op: :op, field: :field, kind: :kind, source: :source }

      emits "ChangeAttached"
    end

    value_object "FieldRef" do
      attribute :value, String
    end

    value_object "OpName" do
      attribute :value, String
      invariant("an op is one the runtime applies") do
        value.to_s == "set" || value.to_s == "append" || value.to_s == "increment" || value.to_s == "decrement"
      end
    end

    command "ActsOn" do
      role "Language"
      goal "Name the aggregate this command reaches through"

      reference_to Command
      # NAMED `root`, not `references` : a command argument SHADOWS the aggregate
      # field of the same name inside a given, so a once-only rule cannot read
      # the state it guards unless the two differ.
      attribute :root, EventName

      given("a command names what it acts on") { !root.value.to_s.empty? }
      given("a command acts on ONE root")      { references.value.to_s.empty? }

      then_set :references, to: :root

      emits "ReferenceNamed"
    end

    command "Announce" do
      role "Language"
      goal "Name the event this command emits"

      reference_to Command
      attribute :announces, EventName

      given("an event is named") { !announces.value.to_s.empty? }

      then_set :emits, append: { name: :announces }

      emits "AnnouncementNamed"
    end
  end

  aggregate "ValueObject" do
    description "One value object declared on an aggregate — its fields and the rules they must satisfy. Its own root because a value object holds nested lists, which no list element can."

    reference_to Aggregate

    # THE AGGREGATE IT BELONGS TO, AND ITS NAME. A value object belongs to one
    # aggregate by rule, and `Name` or `Amount` is spelled in half the chapters
    # there are.
    identified_by do
      aggregate_id
      name.value
    end

    attribute :name,       ValueObjectName
    attribute :attributes, list_of(ShapeField)
    attribute :invariants, list_of(Assertion)
    attribute :rows,       RowCount

    value_object "RowCount" do
      attribute :value, Integer
    end

    value_object "ValueObjectName" do
      attribute :value, String
      invariant("a value object is named") { !value.to_s.empty? }
    end

    value_object "ShapeField" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      attribute :default, String
    end

    value_object "Assertion" do
      attribute :description, String
      attribute :canonical,   String
    end

    # The way back: everything DECLARED IN the aggregate above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate_id, ValueObjectText
      where(aggregate_id: :aggregate_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a value object on an aggregate"

      reference_to Aggregate
      attribute :name, ValueObjectName

      attribute :position, Position, optional: true
      emits "ShapeDeclared"
    end

    command "Field" do
      role "Language"
      goal "Attach one field to the value object"

      reference_to ValueObject
      attribute :name,    ValueObjectName
      attribute :type,    ValueObjectName
      attribute :list,    ValueObjectName
      attribute :optional, ValueObjectName, optional: true
      attribute :pattern,  ValueObjectName, optional: true
      attribute :default, ValueObjectText, optional: true

      then_set :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "ShapeFieldAttached"
    end

    command "Close" do
      role "Language"
      goal "Declare that this value object admits a closed set of rows"

      # Dispatched only when the bluebook declared a one_of — so an EMPTY closed
      # set is visible where it used to be invisible : a shape that is closed
      # and admits nothing. Members live in their own root (a row is a list of
      # pairs inside a list of rows), so the count is offered rather than read.
      reference_to ValueObject
      attribute :rows, RowCount

      given("a closed set admits a member") { rows.value > 0 }

      then_set :rows, to: :rows

      emits "ShapeClosed"
    end

    command "Assert" do
      role "Language"
      goal "Attach one invariant to the value object"

      reference_to ValueObject
      attribute :description, ValueObjectText, optional: true
      attribute :canonical,   ValueObjectText

      given("a rule says what it means")  { !description.value.to_s.empty? }
      given("a rule survives extraction") { !canonical.value.to_s.empty? }

      then_set :invariants, append: { description: :description, canonical: :canonical }

      emits "AssertionAttached"
    end

    value_object "ValueObjectText" do
      attribute :value, String
    end
  end

  aggregate "Vocabulary" do
    # These are DECLARATIONS, not runtime state — a language's admitted sets are
    # fixed when the language is defined, which is what one_of means. They carry
    # no commands on purpose : nothing dispatches a vocabulary, the conformance
    # check READS them from the IR and holds each runtime's own table to them.
    #
    # Every one of these is a set two runtimes must agree on, and every one has
    # already drifted or leaked at least once :
    #   Comparison            went disjoint from the grammar chapter's operator table
    #   NormalisationStrategy is the third, unchecked copy of the canonical-form table
    #   Primitive             is what "primitives live in value objects only" is ABOUT
    #   DomainRefusal         is the boundary three raw Ruby TypeErrors crossed tonight
    description "The closed sets the language admits — the whole of what any runtime may accept, declared once."

    # ITS NAME, and nothing else. A vocabulary hangs under no other thing — the
    # closed sets are the language's own, declared once — so one path is the whole
    # identity.
    identified_by { name.value }

    attribute :name, VocabularyName

    value_object "VocabularyName" do
      attribute :value, String
      invariant("a vocabulary is named") { !value.to_s.empty? }
    end

    # Expression::Evaluator::COMPARISONS — six operators, all reduced by both
    # runtimes to two primitives (less_than, equal) combined with a small boolean
    # algebra: compares_less_than and compares_equal choose which primitive(s) OR
    # together, negated inverts the result. `compare` reads this table instead of
    # hardcoding a six-way case statement — see Evaluator::COMPARISONS.
    value_object "Comparison" do
      attribute :symbol,             String
      attribute :compares_less_than, String
      attribute :compares_equal,     String
      attribute :negated,            String

      one_of do
        member symbol: ">=", compares_less_than: "true",  compares_equal: "false", negated: "true"
        member symbol: "<=", compares_less_than: "true",  compares_equal: "true",  negated: "false"
        member symbol: "<",  compares_less_than: "true",  compares_equal: "false", negated: "false"
        member symbol: ">",  compares_less_than: "true",  compares_equal: "true",  negated: "true"
        member symbol: "==", compares_less_than: "false", compares_equal: "true",  negated: "false"
        member symbol: "!=", compares_less_than: "false", compares_equal: "true",  negated: "true"
      end
    end

    # Expression::Resolver::SIGN_TESTS
    # Each sign test is comparing against the literal 0, using an operator
    # Comparison already declares — compares_via names which one, so a sign
    # test is sugar for an existing operator rather than a second algebra
    # beside it. `positive?` = value > 0, `negative?` = value < 0, `zero?` =
    # value == 0.
    value_object "SignTest" do
      attribute :name,         String
      attribute :compares_via, String
      one_of do
        member name: "positive?", compares_via: ">"
        member name: "negative?", compares_via: "<"
        member name: "zero?",     compares_via: "=="
      end
    end

    # `.include?`'s haystack type decides its behaviour : Array does
    # membership (the same equal? primitive Comparison's == uses), String
    # does an exact substring match and refuses a non-String needle. Anything
    # else is always false — not declared here, since it is the fallback
    # every OTHER haystack type shares, not a case of its own.
    value_object "IncludeHaystack" do
      attribute :type,     String
      attribute :strategy, String
      one_of do
        member type: "Array",  strategy: "membership"
        member type: "String", strategy: "substring"
      end
    end

    # `.to_s` admits exactly these scalar types, and every one of them uses
    # the SAME rule (Ruby's own to_s — nil renders "", a bool its name, a
    # number its digits, a string itself) — a closed set to admit into, not a
    # table of different rules per type.
    value_object "ToStringType" do
      attribute :type, String
      one_of do
        member type: "String"
        member type: "Integer"
        member type: "Float"
        member type: "TrueClass"
        member type: "FalseClass"
        member type: "NilClass"
      end
    end

    # `.size` and `.empty?` admit exactly the same closed set — a list, a
    # string, or an open map — and each just calls the one Ruby/Rust method
    # already named for it. One declaration for both, since the set itself is
    # the only thing either needed to say.
    value_object "SizedType" do
      attribute :type, String
      one_of do
        member type: "Array"
        member type: "String"
        member type: "Hash"
      end
    end

    # IR::Attribute::PRIMITIVES — the scalars a value object may bottom out in
    value_object "Primitive" do
      attribute :name, String
      one_of do
        member name: "String"
        member name: "Integer"
        member name: "Float"
        member name: "TrueClass"
        member name: "FalseClass"
      end
    end

    # Expression::CanonicalForm::STRATEGIES
    value_object "NormalisationStrategy" do
      attribute :name, String
      one_of do
        member name: "collapse_whitespace"
        member name: "replace"
      end
    end

    # the ops Runtime::CommandInterpreter applies. `sign` is the arithmetic
    # delta increment/decrement share one primitive by — CommandRules#arithmetic
    # (Ruby) and mutations.rs' `arithmetic` (Rust) both apply `current + sign *
    # amount`, differing only in which sign. set and append do no arithmetic,
    # so they carry no sign — ABSENT IS NOT EMPTY, same reading as elsewhere in
    # this file.
    value_object "MutationOp" do
      attribute :name, String
      attribute :sign, String
      one_of do
        member name: "set",       sign: ""
        member name: "append",    sign: ""
        member name: "increment", sign: "1"
        member name: "decrement", sign: "-1"
      end
    end

    # QuerySpecification::Common::Comparators::COMPARATORS — a where-clause's
    # admitted operators. Unlike Comparison, these do not reduce to one shared
    # boolean algebra (eq/ne compare values, gt/gte/lt/lte order them, in/contains
    # test membership in opposite directions), so this stays a flat closed set —
    # the same shape MutationOp had before it grew a sign.
    value_object "QueryComparator" do
      attribute :name, String
      one_of do
        member name: "eq"
        member name: "ne"
        member name: "gt"
        member name: "gte"
        member name: "lt"
        member name: "lte"
        member name: "in"
        member name: "contains"
      end
    end

    # Adapters::Driven::Folder::DOMAIN_ORDER — declarations load in this order
    value_object "LoadOrder" do
      attribute :glob, String
      one_of do
        member glob: "*.port"
        member glob: "*.adapter"
        member glob: "*.bluebook"
        member glob: "*.hecksagon"
        member glob: "*.world"
      end
    end

    # CommandInterpreter#call / dispatcher.rs::dispatch — an aggregate command's
    # own interpretation, ending at the events it emits. Reaction (policies,
    # sagas) is a structurally separate phase in both runtimes and is not part
    # of this : Ruby returns from CommandInterpreter#call before it runs, in a
    # different class ; Rust runs it after, inside the same function, but it is
    # still what a command's OWN emitted events cause, not what interpreting
    # the command does. Two conditional steps — assign_creation_attributes only
    # fires for a creating command, advance_lifecycle only when a transition
    # applies — so this is the order a command that does both follows,
    # confirmed by tracing a real dispatch, not read off the source.
    value_object "AggregateDispatchOrder" do
      attribute :step, String
      one_of do
        member step: "refuse_unknown_arguments"
        member step: "refuse_absent_arguments"
        member step: "normalize_args"
        member step: "resolve_references"
        member step: "hydrate"
        member step: "enforce_givens"
        member step: "admissible_transition"
        member step: "assign_creation_attributes"
        member step: "apply_mutations"
        member step: "advance_lifecycle"
        member step: "save"
        member step: "emit"
      end
    end

    # EntityInterpreter#call / dispatcher.rs::dispatch_entity — the same shape
    # one level down, on a piece an aggregate holds rather than the aggregate
    # itself. Shorter than AggregateDispatchOrder because an entity is never
    # CREATED through this path (no assign_creation_attributes) and inherits
    # its aggregate's own argument gate rather than running one of its own (no
    # refuse_unknown_arguments) — hydrating the parent and locating the
    # element replace a single hydrate. resolve_references stayed, though —
    # an entity command can declare a reference-typed attribute the same way
    # an aggregate command can (CommandRules#resolve_references is shared by
    # both interpreters), even though nothing in the real corpus does yet.
    value_object "EntityDispatchOrder" do
      attribute :step, String
      one_of do
        member step: "normalize_args"
        member step: "resolve_references"
        member step: "hydrate_parent"
        member step: "locate_element"
        member step: "enforce_givens"
        member step: "admissible_transition"
        member step: "apply_mutations"
        member step: "advance_lifecycle"
        member step: "save"
        member step: "emit"
      end
    end

    # Runtime::Errors::DOMAIN_REFUSALS — what counts as the domain judging,
    # as opposed to the runtime breaking. Anything outside this set that reaches
    # a refusal list is a bug wearing a refusal's clothes.
    value_object "DomainRefusal" do
      attribute :name, String
      one_of do
        member name: "AbsentArgument"
        member name: "GivenNotMet"
        member name: "InvariantViolation"
        member name: "LifecycleRefused"
        member name: "NotFound"
        member name: "TypeMismatch"
        member name: "UnknownArgument"
        member name: "UnknownVerb"
      end
    end

    # SagaInterpreter::REFUSED, and its counterpart in the Rust dispatcher.
    #
    # A leg answers an EVENT — `on "AccountDebited"` — or it answers one of these,
    # which are not events at all: no aggregate announces that a leg the procedure
    # dispatched was declined. `on :refused` is the compensating leg, and without
    # this declaration the word lived only as a magic string in two runtimes
    # agreeing by coincidence, and a reader of the language could not discover the
    # trigger existed.
    value_object "Trigger" do
      attribute :name, String
      one_of do
        member name: "refused"
      end
    end
  end

  aggregate "Query" do
    description "One query declared on an aggregate — what it filters on, how it orders, and how many it returns."

    reference_to Aggregate

    # Which piece declared it — see Command's entity_id.
    reference_to Entity, as: :entity_id

    # THE IMMEDIATE OWNER, AND ITS NAME — the same derivation Command takes
    # (see the note there), because an ask sits exactly where a verb does and
    # an entity's asks are its own the same way its verbs are.
    identified_by do
      owner_id
      name.value
    end

    attribute :name,        QueryName
    attribute :description, QueryText
    attribute :order_field, QueryText
    attribute :order_way,   QueryText
    attribute :limit,       QueryText
    attribute :wheres,      list_of(Filter)
    attribute :attributes,  list_of(AskArgument)
    # EVERY OTHER OPTION A QUERY CAN CARRY, as an open map rather than a field
    # each. `offset`, `cursor`, `nulls`, `authorize`, `consistency`, `freshness`,
    # `inspect_query` and `use_index` are eight more specifications, several of them
    # compound — authorize names a policy AND a tenant, freshness a mode AND a max
    # age. Eleven more fields would have to be added here one at a time, and the
    # ninth option would need a twelfth.
    #
    # So they ride as rows: the option's NAME, the KEY within it, and the value. The
    # language already models an open map exactly this way twice — a member's pairs
    # and a world's settings — and both are their own root for the same reason, that
    # no value object can hold a map. Held here as a list because an option belongs
    # to the ask rather than standing alone.
    attribute :options,     list_of(AskOption)

    value_object "QueryName" do
      attribute :value, String
      invariant("a query is named") { !value.to_s.empty? }
    end

    value_object "QueryText" do
      attribute :value, String
    end

    value_object "Filter" do
      attribute :field, String
      attribute :op,    String
      attribute :value, String
    end

    value_object "AskArgument" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      attribute :default, String
    end

    # One entry of one option. `option` names which specification it belongs to
    # (offset, freshness, authorization), `key` the part within it (value, mode,
    # max_age, policy, tenant), and `value` what was declared. A single-valued
    # option is one row ; a compound is one row per part ; a repeated one — an index
    # hint — is one row per occurrence, told apart by `at`.
    value_object "AskOption" do
      attribute :option, String
      attribute :key,    String
      attribute :value,  String
      attribute :at,     String
    end

    # The way back: everything DECLARED IN the aggregate above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate_id, QueryText
      where(aggregate_id: :aggregate_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a query on an aggregate"

      reference_to Aggregate
      # Declared on an aggregate or on one of its entities — see Command.Declare.
      reference_to Entity, as: :entity_id, optional: true
      attribute :name,        QueryName
      attribute :description, QueryText, optional: true
      attribute :order_field, QueryText, optional: true
      attribute :order_way,   QueryText, optional: true
      attribute :limit,       QueryText, optional: true

      attribute :position, Position, optional: true
      emits "AskDeclared"
    end

    command "Filter" do
      role "Language"
      goal "Attach one where-clause to the query"

      reference_to Query
      attribute :field, QueryText
      attribute :op,    QueryText
      attribute :value, QueryText

      then_set :wheres, append: { field: :field, op: :op, value: :value }

      emits "FilterAttached"
    end

    command "Option" do
      role "Language"
      goal "Attach one part of one specification option to the query"

      reference_to Query
      attribute :option, QueryText
      attribute :key,    QueryText
      # AN OPTION MAY HAVE NO VALUE. `consistency :snapshot` with no timeout is a
      # complete declaration, and an option is judged one key at a time — so the
      # `timeout` row arrives carrying nothing. Requiring a value here made every
      # such declaration unbuildable, which is a rule about the LANGUAGE, not
      # about the one spec that noticed.
      attribute :value,  QueryText, optional: true
      attribute :at,     QueryText, optional: true

      given("an option is named") { !option.value.to_s.empty? }

      then_set :options, append: { option: :option, key: :key, value: :value, at: :at }

      emits "OptionAttached"
    end

    command "Argument" do
      role "Language"
      goal "Attach one parameter to the query"

      reference_to Query
      attribute :name,    QueryText
      attribute :type,    QueryText
      attribute :list,    QueryText
      attribute :optional, QueryText, optional: true
      attribute :pattern,  QueryText, optional: true
      attribute :default, QueryText, optional: true

      then_set :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "AskArgumentAttached"
    end

  end

  aggregate "Policy" do
    description "One policy — the event it watches, the command it fires, and the domain that command belongs to."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME. A policy hangs off the chapter rather
    # than an aggregate, so the chapter is the part above it.
    identified_by do
      bluebook_id
      name.value
    end

    attribute :name,            PolicyName
    # WHICH HEAD DECLARED IT, empty for a reaction the chapter owns.
    #
    # A policy written inside an aggregate is hoisted onto the chapter by the
    # builder, and the chapter is where the runtime reads it — so nothing was ever
    # lost at runtime. What was lost is where it was WRITTEN, which is a fact about
    # the source, and facts about the source are what this language holds.
    # `Aggregate#to_h` does not carry it and does not need to: the wire format is the
    # contract with the other runtime, and the language may hold more than it.
    attribute :aggregate,       PolicyText
    attribute :on_event,        PolicyText
    attribute :trigger_command, PolicyText
    attribute :target_domain,   PolicyText

    value_object "PolicyName" do
      attribute :value, String
      invariant("a policy is named") { !value.to_s.empty? }
    end

    value_object "PolicyText" do
      attribute :value, String
    end

    # The way back: everything DECLARED IN the chapter above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook_id, PolicyText
      where(bluebook_id: :bluebook_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Declare a policy on a chapter"

      reference_to Bluebook
      attribute :name,            PolicyName
      attribute :aggregate,       PolicyText, optional: true
      attribute :on_event,        PolicyText
      attribute :trigger_command, PolicyText
      attribute :target_domain,   PolicyText, optional: true

      attribute :position, Position, optional: true
      emits "ReactionDeclared"
    end
  end

  aggregate "ProcessManager" do
    description "One process manager — what correlates its instances, what starts and ends it, and the states it moves through."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME — the same shape a policy takes, and for
    # the same reason.
    identified_by do
      bluebook_id
      name.value
    end

    attribute :name,      ProcessManagerName
    attribute :correlates_by, ProcessManagerText
    attribute :starts_on,     ProcessManagerText
    attribute :ends_on,       ProcessManagerText
    attribute :states,    list_of(SagaState)

    value_object "ProcessManagerName" do
      attribute :value, String
      invariant("a process manager is named") { !value.to_s.empty? }
    end

    value_object "ProcessManagerText" do
      attribute :value, String
    end

    value_object "SagaState" do
      attribute :name, String
    end

    # The way back: everything DECLARED IN the chapter above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook_id, ProcessManagerText
      where(bluebook_id: :bluebook_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a process manager on a chapter"

      reference_to Bluebook
      attribute :name,      ProcessManagerName
      attribute :correlates_by, ProcessManagerText
      attribute :starts_on,     ProcessManagerText
      attribute :ends_on,       ProcessManagerText

      attribute :position, Position, optional: true
      emits "SagaDeclared"
    end

    command "State" do
      role "Language"
      goal "Attach one state to the process manager"

      reference_to ProcessManager
      attribute :name, ProcessManagerText

      then_set :states, append: { name: :name }

      emits "SagaStateAttached"
    end
  end

  aggregate "Handler" do
    description "One handler inside a process manager — the event it answers, the state move it makes, and the commands it sends. Its own root because a handler holds nested dispatches, which hold nested bindings."

    reference_to ProcessManager

    # THE PROCESS MANAGER IT IS IN, AND THE EVENT IT ANSWERS. A saga answers each
    # event once, so the event names the leg. The judge keyed this by POSITION
    # ("#{parent}##{index}"), which is a mint : insert a leg above and every leg
    # below is renamed. The event does not move.
    identified_by do
      process_manager_id
      event_type.value
    end

    # No `saga` field. It named the old word for a process manager, held nothing —
    # IR::ProcessManagerHandler has no such reader, so every Handler record's saga
    # was empty — and repeated the parent that `process_manager_id` already
    # carries. A field that names the wrong thing, holds nothing, and duplicates
    # the reference beside it.
    #
    # `event_type` is an event name, or one of the Trigger vocabulary's members
    # when the leg answers something no aggregate announces.
    attribute :event_type, HandlerText
    attribute :from_state, HandlerText
    attribute :to_state,   HandlerText

    value_object "HandlerText" do
      attribute :value, String
    end

    # The way back: everything DECLARED IN the process manager above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :process_manager_id, HandlerText
      where(process_manager_id: :process_manager_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a handler inside a process manager"

      reference_to ProcessManager
      attribute :event_type, HandlerText
      attribute :from_state, HandlerText, optional: true
      attribute :to_state,   HandlerText

      attribute :position, Position, optional: true
      emits "LegDeclared"
    end
  end

  aggregate "Dispatch" do
    description "One command a handler dispatches, with the arguments it binds. Its own root because the bindings are an open map, which no value object can hold."

    reference_to Handler

    # THE HANDLER IT IS IN, AND THE COMMAND IT SENDS — keyed by position before,
    # for the same want of a way to say this.
    identified_by do
      handler_id
      command_name.value
    end

    attribute :handler,      DispatchText
    attribute :command_name, DispatchText
    attribute :with_spec,    list_of(Binding)

    value_object "DispatchText" do
      attribute :value, String
    end

    value_object "Binding" do
      attribute :key,   String
      attribute :value, String
    end

    # The way back: everything DECLARED IN the handler above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :handler_id, DispatchText
      where(handler_id: :handler_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a dispatch inside a handler"

      reference_to Handler
      attribute :handler,      DispatchText
      attribute :command_name, DispatchText

      attribute :position, Position, optional: true
      emits "SendDeclared"
    end

    command "Bind" do
      role "Language"
      goal "Bind one argument of the dispatched command"

      reference_to Dispatch
      attribute :key,   DispatchText
      attribute :value, DispatchText

      then_set :with_spec, append: { key: :key, value: :value }

      emits "BindingAttached"
    end
  end

  aggregate "ReadModel" do
    description "One read model — the aggregate heads it gathers and the reference it hangs from."

    reference_to Bluebook

    # THE CHAPTER IT IS IN, AND ITS NAME.
    identified_by do
      bluebook_id
      name.value
    end

    attribute :name,             ReadModelName
    attribute :description,      ProjectionPurpose
    attribute :query_name,       ReadModelText
    attribute :reference_name,   ReadModelText
    attribute :reference_target, ReadModelText
    attribute :aggregate_heads,  list_of(Head)
    # The same open map a query carries — see Query's AskOption. A read model
    # inherits every specification option an ask has, so it holds them the same way.
    attribute :options,          list_of(ProjectionOption)

    value_object "ReadModelName" do
      attribute :value, String
      invariant("a read model is named") { !value.to_s.empty? }
    end

    value_object "ReadModelText" do
      # deliberately permissive : query_name / ref_name / ref_target are
      # legitimately empty on a read model that has not named them yet
      attribute :value, String
    end

    value_object "ProjectionPurpose" do
      attribute :value, String
      invariant("a description says something") { !value.to_s.empty? }
    end

    value_object "Head" do
      attribute :aggregate, String
      attribute :as,        String
      attribute :many,      String
    end

    value_object "ProjectionOption" do
      attribute :option, String
      attribute :key,    String
      attribute :value,  String
      attribute :at,     String
    end

    # The way back: everything DECLARED IN the chapter above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :bluebook_id, ReadModelText
      where(bluebook_id: :bluebook_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a read model on a chapter"

      reference_to Bluebook
      attribute :name,             ReadModelName
      attribute :description,      ProjectionPurpose, optional: true
      attribute :query_name,       ReadModelText
      attribute :reference_name,   ReadModelText
      attribute :reference_target, ReadModelText

      attribute :position, Position, optional: true
      emits "ProjectionDeclared"
    end

    command "Gather" do
      role "Language"
      goal "Attach one aggregate head to the read model"

      reference_to ReadModel
      attribute :aggregate, ReadModelText, optional: true
      attribute :as,        ReadModelText
      attribute :many,      ReadModelText

      given("a read model gathers heads only after its reference") { !reference_target.value.to_s.empty? }

      then_set :aggregate_heads, append: { aggregate: :aggregate, as: :as, many: :many }

      emits "HeadGathered"
    end

    command "Option" do
      role "Language"
      goal "Attach one part of one specification option to the read model"

      reference_to ReadModel
      attribute :option, ReadModelText
      attribute :key,    ReadModelText
      # Same reading as Query.Option above — an option key may stand alone.
      attribute :value,  ReadModelText, optional: true
      attribute :at,     ReadModelText, optional: true

      given("an option is named") { !option.value.to_s.empty? }

      then_set :options, append: { option: :option, key: :key, value: :value, at: :at }

      emits "OptionAttached"
    end
  end

  aggregate "Entity" do
    description "One entity inside an aggregate — an element with its own identity, state machine, commands and queries. Its own root because it repeats the aggregate's whole shape one level down."

    reference_to Aggregate

    # THE AGGREGATE IT IS IN, AND ITS NAME. Note this is the identity of the RECORD
    # describing a piece, which is a different thing from the identity that piece
    # itself declares (`identified_by`, the list below).
    identified_by do
      aggregate_id
      name.value
    end

    attribute :owner,         EntityText
    attribute :name,          EntityName
    attribute :description,   EntityName
    # SEVERAL PATHS, joined — a piece spells an identity exactly as a head does,
    # which is the whole point of it being its own root.
    attribute :identified_by, list_of(IdentityPath)
    attribute :attributes,    list_of(PieceField)
    attribute :state_field, EntityText
    attribute :state_start, EntityText
    attribute :transitions, list_of(PieceTransition)

    value_object "EntityName" do
      attribute :value, String
      invariant("an entity is named") { !value.to_s.empty? }
    end

    value_object "EntityText" do
      attribute :value, String
    end

    # A piece's identity is made of parts the same way a head's is, so it holds
    # the same shape. Declared here rather than shared because a value object
    # belongs to the aggregate that uses it.
    value_object "IdentityPath" do
      attribute :value, String
    end

    value_object "PieceField" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      attribute :default, String
    end

    value_object "PieceTransition" do
      attribute :command,    String
      attribute :from_state, String
      attribute :to_state,   String
    end

    # The way back: everything DECLARED IN the aggregate above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate_id, EntityText
      where(aggregate_id: :aggregate_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open an entity inside an aggregate"

      reference_to Aggregate
      attribute :owner,         EntityText
      attribute :name,          EntityName
      attribute :description,   EntityName, optional: true

      attribute :position, Position, optional: true
      emits "PieceDeclared"
    end

    # ONE PART OF THE PIECE'S IDENTITY, attached exactly as an aggregate's is.
    #
    # A PIECE MUST SAY WHAT IT IS KNOWN BY — the rule, where the language keeps
    # its rules. An entity is an element with an identity of ITS OWN ; that is
    # the whole difference between a piece and a value object, so a command
    # acting on one must be able to say which one. Undeclared, the two runtimes
    # each invented a different answer (Ruby fell through to nothing, Rust
    # assumed `id`) and agreed only because every entity in the corpus happened
    # to declare it — `bin/undeclared` reported precisely that, a divergence the
    # declaration was masking. Requiring it removes the default there was to
    # disagree about. That requirement now sits on Seal, where a whole-document
    # rule belongs ; what stays here is the shape of each part.
    command "Identify" do
      role "Language"
      goal "Attach one part of the entity's identity"

      reference_to Entity
      attribute :path, IdentityPath

      # Two ways to reach a scalar — see Aggregate.Identify, where the same rule
      # is written out in full.
      given("an identity part reaches a scalar") { path.value.to_s.include?(".") || path.value.to_s.include?("_id") }

      then_set :identified_by, append: { value: :path }
      emits "PieceIdentified"
    end

    command "Seal" do
      role "Language"
      goal "Close an entity — the checks that need every declaration present"

      # A piece gets the whole-document shape a head has, for the same reason :
      # "it said SOMETHING" cannot be asked while the parts are still arriving.
      reference_to Entity

      given("an entity says what it is known by") { !identified_by.empty? }

      emits "PieceSealed"
    end

    command "Attribute" do
      role "Language"
      goal "Attach one attribute to the entity"

      reference_to Entity
      attribute :name,    EntityText
      attribute :type,    EntityText
      attribute :list,    EntityText
      attribute :optional, EntityText, optional: true
      attribute :pattern,  EntityText, optional: true
      attribute :default, EntityText, optional: true

      then_set :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern }

      emits "PieceAttributeAttached"
    end


    command "Lifecycle" do
      role "Language"
      goal "Name the field this entity's state machine runs on"

      reference_to Entity
      attribute :state_field, EntityText
      attribute :state_start, EntityText

      then_set :state_field, to: :state_field
      then_set :state_start, to: :state_start

      emits "PieceLifecycleNamed"
    end

    command "Transition" do
      role "Language"
      goal "Attach one transition to the entity's state machine"

      reference_to Entity
      attribute :command,    EntityText
      attribute :from_state, EntityText, optional: true
      attribute :to_state,   EntityText

      then_set :transitions, append: { command: :command, from_state: :from_state, to_state: :to_state }

      emits "PieceTransitionAttached"
    end
  end

  aggregate "Member" do
    description "One admitted row of a value object's one_of — a whole combination of field values, not a per-field choice. Its own root because a row is a list of pairs inside a list of rows."

    reference_to ValueObject

    # THE VALUE OBJECT IT IS ADMITTED BY, AND WHERE IT SITS AMONG THE ROWS.
    #
    # A member has no other distinguishing fact : its pairs are an OPEN MAP, which
    # is the whole reason it is a root, and a map cannot be a path. Position is not
    # a mint — it is read straight out of the source file, the same fact the
    # language already holds deliberately so that an ask ordered any other way
    # cannot take declaration order away.
    identified_by do
      value_object_id
      position.value
    end

    attribute :shape, MemberText
    attribute :pairs, list_of(Pair)

    value_object "MemberText" do
      attribute :value, String
    end

    value_object "Pair" do
      attribute :key,   String
      attribute :value, String
    end

    # The way back: everything DECLARED IN the value object above. The parent
    # reference IS the query.
    # WHERE IT SITS AMONG ITS SIBLINGS. Declaration order is a FACT ABOUT THE
    # SOURCE — Rust reads it straight out of the file, and the IR is a contract
    # field for field AND INDEX FOR INDEX. So the language HOLDS it, instead of
    # inheriting it from whatever order a store happens to iterate: an ask that
    # does not say how it is ordered is answered in identity order, which is
    # right for every other ask and fatal for the one that is the SOURCE.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :value_object_id, MemberText
      where(value_object_id: :value_object_id)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open one admitted row on a value object"

      reference_to ValueObject
      attribute :shape, MemberText

      attribute :position, Position, optional: true
      emits "MemberDeclared"
    end

    command "Pair" do
      role "Language"
      goal "Bind one field of the admitted row"

      reference_to Member
      attribute :key,   MemberText
      attribute :value, MemberText

      given("an admitted row binds a named field") { !key.value.to_s.empty? }

      then_set :pairs, append: { key: :key, value: :value }

      emits "PairBound"
    end
  end
end
