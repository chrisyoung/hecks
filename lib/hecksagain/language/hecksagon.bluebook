Hecks.bluebook "Hecksagon" do
  vision "The .hecksagon language, declared in itself. A hecksagon is a SIBLING of a bluebook, not part of one — it binds a domain's aggregates to the ports/adapters that carry them, and those bindings belong to the deployment's wiring rather than to the domain's own rules. So it is described in its own file, as its own thing, the same reasoning world.bluebook already carries for .world."
  core

  aggregate "Hecksagon" do
    description "One .hecksagon — the events a domain subscribes to, and the root every binding hangs off. A sibling artifact to the bluebook, not part of it."

    identified_by :domain

    attribute :domain,             HecksagonName
    attribute :subscriptions,      list_of(Subscription)
    attribute :framework_members,  list_of(FrameworkMember)
    attribute :vendored_bluebooks, list_of(VendoredBluebook)

    value_object "HecksagonName" do
      attribute :value, String
      invariant("a hecksagon names its domain") { !value.to_s.empty? }
    end

    value_object "Subscription" do
      attribute :value, String
      invariant("a subscription names an event") { !value.to_s.empty? }
    end

    # A `framework/bluebook/` member this hecksagon attaches — Governance,
    # Identity, whatever else lands beside them. Same shape as
    # `Subscription` beside it, one word over.
    value_object "FrameworkMember" do
      attribute :value, String
      invariant("a framework member is named") { !value.to_s.empty? }
    end

    # A vendored, external bluebook this hecksagon attaches — one level
    # further out than `FrameworkMember`: not a member shipped inside
    # hecksagain's own lib/, but a separate package vendored into the
    # consuming project's own checkout. Same shape as `FrameworkMember`
    # beside it, one word over — see EmbryonautBluebook's own header.
    value_object "VendoredBluebook" do
      attribute :value, String
      invariant("a vendored bluebook is named") { !value.to_s.empty? }
    end

    command "Declare" do
      role "Deployment"
      goal "Open a hecksagon for a domain"

      attribute :domain, HecksagonName

      emits "HecksagonDeclared"
    end

    command "Subscribe" do
      role "Deployment"
      goal "Take a hecksagon's own event, from outside the domain's own bluebook"

      reference_to Hecksagon
      attribute :event, Subscription

      sets :subscriptions, append: { value: :event }

      emits "SubscriptionAdded"
    end

    command "UsesFramework" do
      role "Deployment"
      goal "Attach a framework/bluebook/ member to this hecksagon"

      reference_to Hecksagon
      attribute :member, FrameworkMember

      sets :framework_members, append: { value: :member }

      emits "FrameworkMemberAttached"
    end

    command "UsesEmbryonautBluebook" do
      role "Deployment"
      goal "Attach a vendored, external bluebook to this hecksagon"

      reference_to Hecksagon
      attribute :package, VendoredBluebook

      sets :vendored_bluebooks, append: { value: :package }

      emits "VendoredBluebookAttached"
    end
  end

  aggregate "AdapterBinding" do
    description "One aggregate-to-adapter binding inside a hecksagon — the verb it answers, the adapter it names. Its own root because a hecksagon's binds are an open set of verbs (one per declared port), which no value object can hold — the same reasoning Wiring carries for a world's settings."

    reference_to Hecksagon

    # THE HECKSAGON IT IS IN, THE AGGREGATE IT NAMES, THE VERB IT ANSWERS.
    # One hecksagon binds one adapter per (aggregate, verb) pair — that is
    # what a binding IS — so the triple identifies it.
    identified_by :hecksagon, :aggregate, :verb

    attribute :hecksagon, BindingText
    attribute :aggregate, BindingText
    attribute :verb,      BindingText
    attribute :adapter,   BindingText
    attribute :role,      BindingText, optional: true

    value_object "BindingText" do
      attribute :value, String
    end

    command "Bind" do
      role "Deployment"
      goal "Name the adapter one aggregate answers one verb through"

      reference_to Hecksagon
      attribute :aggregate, BindingText
      attribute :verb,      BindingText
      attribute :adapter,   BindingText
      attribute :role,      BindingText, optional: true

      given("a binding names its verb") { !verb.value.to_s.empty? }

      emits "Bound"
    end
  end

  aggregate "DomainPort" do
    description "A primary port — the boundary between a domain and its adapters, in hexagonal terms, is exactly what a hecksagon already IS for every other port. Root-level (belongs to the chapter) or aggregate-scoped (reached the same way persisted_by is, through the open Const.verb(...) door). One of two shapes, never both: a list of operations translating an inbound fact into this domain's own events, or a bare verb naming a swappable resource port (the same Hecks.port a project's own .port file declares, reached from inside the hecksagon instead)."

    identified_by :name

    attribute :name, PortName
    attribute :verb, PortVerb, optional: true

    value_object "PortName" do
      attribute :value, String
      invariant("a port is named") { !value.to_s.empty? }
    end

    value_object "PortVerb" do
      attribute :value, String
      invariant("a verb is named") { !value.to_s.empty? }
    end
  end

  aggregate "PortOperation" do
    description "One operation a port exposes — the same shape a command's payload has (attributes in, an event out) with none of a command's given/ensures/sets : a port operation is the translation boundary itself, not a second place business rules live. Those stay on whichever command a policy triggers in reaction to the event it emits."

    identified_by :name

    attribute :name,       OperationName
    attribute :attributes, list_of(PortOperationField)
    attribute :emits,      list_of(EmittedEvent)

    # THE TWO ENDINGS OF AN `asks`, held by the language about itself.
    #
    # `emits` above is what an inbound `tells` says once the fact is in.
    # These two are the outbound half: what the adapter came back with, and
    # what it said instead. Singular where `emits` is a list, because an ask
    # has exactly one of each — a call that could answer two different ways
    # is two calls.
    #
    # Empty on every `tells`, which is why neither carries an invariant
    # demanding a value; `PortOperationBuilder` refuses the wrong word for
    # the direction long before a record gets here.
    attribute :answers,    AnsweringEvent
    attribute :refuses,    RefusingEvent

    value_object "OperationName" do
      attribute :value, String
      invariant("an operation is named") { !value.to_s.empty? }
    end

    value_object "PortOperationField" do
      attribute :name, String
      attribute :type, String
    end

    value_object "EmittedEvent" do
      attribute :value, String
      invariant("an emitted event is named") { !value.to_s.empty? }
    end

    value_object "AnsweringEvent" do
      attribute :value, String
    end

    value_object "RefusingEvent" do
      attribute :value, String
    end
  end
end
