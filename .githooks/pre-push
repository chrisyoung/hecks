#!/bin/sh
#
# pre-push — the corpus must AGREE before anything leaves this machine.
#
# `bin/parity` is the only thing that reads the corpus, and until now it was
# hand-run: no hook, no CI. So a corpus member could stop executing entirely
# and the suite people do run would stay green. Both happened in one tree —
# the grammar chapter stopped parsing, and pizzas' parity script ran zero
# steps while parity reported AGREED.
#
# rspec + cargo stay OUT of this hook on purpose: they are the fast loop, run
# constantly, and `spec/corpus_spec.rb` already boots every corpus member in
# well under a second. What this adds is the slow, whole-truth check — two
# runtimes, three domains, four stages — which is worth ~40s once per push and
# far too slow per commit.
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git push --no-verify   (say why — a red corpus is a real answer)

set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)

printf '\n[pre-push] parity — three domains, two runtimes\n\n'

if ! "$ROOT/bin/parity"; then
  printf '\n[pre-push] BLOCKED — the corpus does not agree.\n'
  printf '           SPLIT  = the two runtimes answered differently.\n'
  printf '           SILENT = a domain executed nothing ; agreement over an\n'
  printf '                    empty run is not agreement.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  exit 1
fi

printf '\n[pre-push] corpus agrees.\n\n'
