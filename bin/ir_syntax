#!/usr/bin/env ruby

# THE LANGUAGE'S OWN SPELLING, PROJECTED INTO RUST SOURCE.
#
# `language/bluebook/syntax.bluebook` declares `Syntax::Keyword` — every word a
# bluebook may use, the body it opens, and where it may be typed. This projects
# the slice of it Rust's parser needs today: every word admitted directly in an
# AGGREGATE's own body, so a construct the permissive parser cannot read can
# still be told apart from a typo of one it can (runtime::strict_boot).
#
# `strict_boot.rs`'s own comment said its hand-written list "exists ONLY
# because nothing declares what the keywords are". Something does now, and the
# hand-written copy had drifted from it in the dangerous direction: five of its
# twelve words — `view`, `rule`, `factory`, `create`, and `invariant` (a real
# word, but typed in a VALUE OBJECT, not an aggregate) — are not words the
# language admits at aggregate-body level at all. A word ON the list is
# treated as KNOWN and passed straight through, so `factory do` was waved
# through by the very check meant to catch it, then raised a Ruby-side
# NoMethodError with no warning. spec/syntax_conformance_spec.rb is what found
# this, by reading the same rows this script does and holding the checked-in
# list to them.
#
# THAT FIRST PASS ONLY COVERED WORDS THAT OPEN A `do` BLOCK — seven of the ten.
# `attribute`, `description` and the bare-symbol form of `identified_by` never
# open one, so a typo of THEM (`atribute :cost, Money`) fell through the same
# hole the twelve-word list was built to close : silently, exactly like any
# other alien construct. There is nothing about "opens a block" that makes a
# word more or less worth catching a typo of, so this now projects every word
# the language admits at aggregate-body level, block-opening or not.
#
# WHOLE FILE, NEVER A PATCH — same rule as bin/ir_vocabulary and bin/ir_structs.
#
# Regenerate with:
#
#   bin/ir_syntax > rust/src/bluebook/ir_syntax.rs
#
# spec/ir_syntax_export_spec.rb holds the checked-in file equal to this
# script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

syntax = Hecksagain::Bluebook::MetaValidator
         .grammar_registry.bluebook("Bluebook").aggregate("Syntax")

keyword = syntax.value_object("Keyword") or raise "the language declares no Syntax::Keyword to project"

# EVERY WORD ADMITTED DIRECTLY IN AN AGGREGATE'S OWN BODY — not filtered by
# `body`, because a word that opens nothing is exactly as real a keyword as one
# that opens a `do` block, and a typo of either is worth catching. `context`
# already draws the line this needs : a word typed one level DEEPER (inside a
# nested `command`, `query`, `value_object`, `entity` or `policy` body) belongs
# to that context instead, and strict_boot's own depth tracking is what keeps
# this list from being consulted there.
words = keyword.members
               .map(&:to_h)
               # A proposed or retired word reaches no projected table — to a
               # projected reader it does not exist. Deprecated still reads.
               .reject { |row| %w[proposed retired].include?(row[:status].to_s) }
               .select { |row| row.fetch(:context) == "Aggregate" }
               # A renamed word's OLD spelling stays recognized — see `was:`.
               .flat_map { |row| [row.fetch(:word), row[:was].to_s.empty? ? nil : row[:was]].compact }
               .uniq
               .sort

raise "Syntax::Keyword admits no word at aggregate-body level" if words.empty?

puts <<~RUST
  // GENERATED BY bin/ir_syntax — DO NOT EDIT BY HAND.
  //
  // Every word admitted directly in an AGGREGATE's own body, projected from
  // the language's own declared syntax.
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook (Syntax::Keyword,
  // rows where context = "Aggregate").
  // Regenerate: bin/ir_syntax > rust/src/bluebook/ir_syntax.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_syntax_export_spec.rb, and held equal to the language's own
  // declaration (in both directions) by spec/syntax_conformance_spec.rb — so
  // this list cannot drift from what a bluebook may actually type the way the
  // hand-written copy in runtime::strict_boot did.

  pub const AGGREGATE_KEYWORDS: &[&str] = &[
  #{words.map { |word| "    \"#{word}\"," }.join("\n")}
  ];
RUST
