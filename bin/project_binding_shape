#!/usr/bin/env ruby

# PRD 10 follow-up (ADR 0030's own Slice-2 stop-condition check) — writes
# rust/src/kernel/binding/mod.rs (the `Literal`/`Reference`/`Source`/
# `ExecutableBinding` struct/enum definitions ONLY — no interpretation
# logic, which stays hand-written in rust/src/kernel/binding/logic.rs,
# the same "generate structure, handwrite meaning" split
# bin/project_kernel_capabilities already draws) from ONE definition:
# Hecksagain::Bluebook::Expression::BindingShape
# (lib/hecksagain/bluebook/expression/binding_shape.rb) — see that
# file's own header for why this is a plain manifest rather than a
# self-hosted admission ledger like Operator's.
#
# WRITES ITS OWN FILE, NEVER `>` — same reasoning bin/expression_
# projection's own header gives: a shell redirection truncates the
# target before this script's own `require` chain (which does not, in
# this case, read the target back) could matter, but the atomic-rename
# discipline is worth keeping uniform across every generator in this
# repo rather than a special case for the one that happens not to need
# it.
#
#   bin/project_binding_shape

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/bluebook/expression/binding_shape"
require "fileutils"
require "tempfile"

ROOT = File.expand_path("..", __dir__)
Shape = Hecksagain::Bluebook::Expression::BindingShape

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

def struct_def(name, fields)
  members = fields.map { |f| "    pub #{f.name}: #{f.rust_type}," }.join("\n")
  <<~RUST
    #[derive(Debug, Clone, PartialEq)]
    pub struct #{name} {
    #{members}
    }
  RUST
end

def node_variant(name, fields)
  members = fields.map { |f| "#{f.name}: #{f.rust_type}" }.join(", ")
  "    #{name} { #{members} },"
end

node_variants = Shape.node_names.map { |name| node_variant(name, Shape::NODES.fetch(name)) }.join("\n")

content = <<~RUST
  // GENERATED by bin/project_binding_shape from Hecksagain::Bluebook::
  // Expression::BindingShape (lib/hecksagain/bluebook/expression/
  // binding_shape.rb). Do not hand-edit — re-run bin/project_binding_shape
  // instead. Interpretation logic (`lower`/`resolve`) stays hand-written
  // in logic.rs, re-exported below — this file is structure only, the
  // same split bin/project_kernel_capabilities already draws for
  // expression_operators/attribute_shapes.

  use crate::kernel::expr::Value;

  #[derive(Debug, Clone, PartialEq)]
  pub enum Source {
  #{node_variants}
  }

  #{struct_def('ExecutableBinding', Shape::EXECUTABLE_BINDING)}
  mod logic;
  pub use logic::{lower, resolve, SourceBucket, Sources};
RUST

write_atomically(File.join(ROOT, "rust/src/kernel/binding/mod.rs"), content)
