#!/usr/bin/env ruby

# STRUCTURED QUERIES AGAINST THE LANGUAGE'S OWN IR — for a session
# working ON the language (adding a resolution rule, checking a
# propagation checklist) rather than a domain running on top of it.
# `bin/ir` already dumps a whole domain's raw JSON; this answers the
# SPECIFIC questions that recurred across five real feature rounds
# (docs/decisions/0028-.../ and .claude/skills/bluebook-construct-
# creator/SKILL.md) without hand-grepping corpus text or hand-reading
# Ruby source each time. This is a THIN TEXT FRONT END — the real
# logic AND the text formatting live in Hecksagain::QueryIR
# (lib/hecksagain/query_ir.rb), shared with
# bin/hecksagain_query_ir_mcp so the two front ends can never drift
# into two different answers — or two different renderings of the
# same answer — for the same question.
#
#   bin/query_ir constructs [Name ...]
#     For each Ruby IR class (or just the one named), the real
#     STRUCTURAL diff between what it emits and what the self-hosted
#     meta-domain declares for it. Answers "does Entity already have
#     field X" without opening entity.rb AND entity.bluebook by hand.
#
#   bin/query_ir duplicates [--meta] [domain_dir ...]
#     Every given/ensures/invariant DECLARATION across the given
#     domains (all real examples + the self-hosted meta-domain by
#     default), grouped by (kind, description, canonical), reporting
#     every group with more than one independently-declared rule.
#
# Boots the lightweight way (Hecksagain::Codemod's own path) — no live
# Postgres needed for a Postgres-backed domain like compliance.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"
require "hecksagain/query_ir"

def run_constructs(args)
  puts Hecksagain::QueryIR.format_constructs(Hecksagain::QueryIR.constructs(args))
rescue ArgumentError => e
  warn e.message
  exit 1
end

def run_duplicates(args)
  use_meta = args.delete("--meta") || args.empty?
  domains  = args.empty? ? nil : args

  puts Hecksagain::QueryIR.format_duplicates(Hecksagain::QueryIR.duplicates(domains: domains, include_meta: use_meta))
end

command = ARGV.shift
case command
when "constructs" then run_constructs(ARGV)
when "duplicates" then run_duplicates(ARGV)
else
  warn <<~USAGE
    Usage:
      bin/query_ir constructs [Name ...]
      bin/query_ir duplicates [--meta] [domain_dir ...]
  USAGE
  exit 1
end
