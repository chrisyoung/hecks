#!/usr/bin/env ruby

# Regenerates docs/reference/ from the language's own Syntax chapter —
# the tables from the declaration, the prose preserved from the
# committed pages. The golden spec refuses a tree where the two drifted.
#
# Goes through the projector registry (Projections::Reference), which is
# the first projection to emit a TREE rather than one artifact — see its
# own `emits: :files`. README's generated indexes are a SECOND output,
# rooted elsewhere, so they stay a separate call rather than being
# folded into a map keyed by paths from two different roots.
#
#   bin/reference

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

root      = File.expand_path("..", __dir__)
directory = File.join(root, "docs/reference")
chapter   = Hecksagain::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")

written = Hecksagain::Projector.write(
  Hecksagain::Projector.call(:reference, bluebook: chapter, options: { from: directory }),
  directory, as: :files
)
Hecksagain::Doc::Reference.write_readme!(root)

puts "wrote #{written.size} pages to docs/reference/, and regenerated README.md's own indexes"

missing = Hecksagain::Doc::Reference.undocumented(directory)
if missing.empty?
  puts "every live word carries prose."
else
  puts "#{missing.size} word(s) still carry no prose:"
  missing.each { |word| puts "  #{word}" }
end
