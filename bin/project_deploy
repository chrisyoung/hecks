#!/usr/bin/env ruby

# The AWS DEPLOYMENT projector — docs/decisions/0018-rehydrate-replay-lambda-host.md.
# Generates the SAM template and build Makefile for rust/host (the
# wasmtime+Postgres Lambda entry point) from the domain's own `.world`
# file, the same way bin/project_wasm generates the .wasm artifact from
# the domain's own `.bluebook` — no hand-authored deployment config for
# any given domain, only a generator run against whatever it declares.
#
# `deployed_to("AwsLambda") { region "..."; memory 512; timeout 10 }` is
# a NEW verb in a domain's `.world` file, but needs no framework change
# at all: `Hecks.world`'s own settings-bag is already fully generic
# (lib/hecksagain/bluebook/dsl/world_builder.rb#method_missing) — the
# same mechanism `persisted_by`/`projected_by` already use.
#
#   bin/project_deploy <domain>
#
# Produces deploy/<domain>/template.yaml and deploy/<domain>/Makefile —
# `sam build && sam deploy --guided` from there. PackageType: Zip,
# Runtime: provided.al2023 — no container, no Docker, no ECR.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"
require "fileutils"

domain = ARGV.shift or abort "usage: bin/project_deploy <domain>"
root = File.expand_path("..", __dir__)
domain_name = File.basename(domain)
world_file = File.join(domain, "bluebook", "#{domain_name}.world")

File.exist?(world_file) or abort "#{world_file} does not exist — a domain needs a .world file to declare deployed_to(\"AwsLambda\")"

registry = Hecksagain::Runtime::Registry.new
Hecksagain.with_registry(registry) { Kernel.load(world_file) }

# The declared world's own name, not the directory's — same distinction
# bin/project_rust draws between a domain PATH and its bluebook's own
# declared name (registry.bluebooks.keys.first, not File.basename).
world = registry.worlds.values.first or
  abort "#{world_file} declares no Hecks.world block at all"

deploy_settings = world.for_verb("deployed_to")
deploy_settings[:adapter] == "AwsLambda" or
  abort <<~MSG
    #{world_file} declares no deployed_to("AwsLambda") block. Add one, e.g.:

        deployed_to("AwsLambda") do
          region "us-east-1"
          memory 512
          timeout 10
        end

    then re-run bin/project_deploy #{domain}.
  MSG

region  = deploy_settings.fetch(:region) { abort "deployed_to(\"AwsLambda\") declares no region" }
memory  = deploy_settings.fetch(:memory, 512)
timeout = deploy_settings.fetch(:timeout, 10)

out_dir = File.join(root, "deploy", domain_name)
FileUtils.mkdir_p(out_dir)

logical_id = "#{domain_name.split(/[_-]/).map(&:capitalize).join}Function"

File.write(File.join(out_dir, "template.yaml"), <<~YAML)
  # GENERATED by bin/project_deploy #{domain} — re-run it to refresh
  # this file rather than hand-editing. Source: #{world_file}'s own
  # deployed_to("AwsLambda") block.
  AWSTemplateFormatVersion: '2010-09-09'
  Transform: AWS::Serverless-2016-10-31
  Description: >
    #{domain_name} — dispatched through hecksagain's rust/host, a
    wasmtime-sandboxed Rust binary with a rehydrate-and-replay Postgres
    journal (docs/decisions/0018). PackageType Zip, no container.

  Parameters:
    DatabaseUrl:
      Type: String
      NoEcho: true
      Description: postgres:// connection string rust/host's journal reads/writes.
    # BOTH OPTIONAL, BOTH BLANK BY DEFAULT — a Lambda with no VPC config
    # reaches the public internet fine; it can only reach a PRIVATE-VPC
    # Postgres instance (a normal RDS setup) once these are supplied.
    # Left blank, this template behaves exactly as it did before these
    # existed — real values are a `sam deploy --guided` answer, not a
    # generator change, once a VPC/RDS instance actually exists to point at.
    VpcSubnetIds:
      Type: CommaDelimitedList
      Default: ""
      Description: Optional — private subnet IDs for reaching a VPC-only Postgres instance.
    VpcSecurityGroupIds:
      Type: CommaDelimitedList
      Default: ""
      Description: Optional — security group IDs allowing this function to reach Postgres.

  Conditions:
    HasVpcConfig: !Not [!Equals [!Select [0, !Ref VpcSubnetIds], ""]]

  Resources:
    #{logical_id}:
      Type: AWS::Serverless::Function
      Metadata:
        BuildMethod: makefile
      Properties:
        PackageType: Zip
        Runtime: provided.al2023
        Architectures: [arm64]
        Handler: bootstrap
        MemorySize: #{memory}
        Timeout: #{timeout}
        Environment:
          Variables:
            DATABASE_URL: !Ref DatabaseUrl
            HECKS_WASM_PATH: !Sub "/var/task/#{domain_name}.wasm"
        VpcConfig: !If
          - HasVpcConfig
          - SubnetIds: !Ref VpcSubnetIds
            SecurityGroupIds: !Ref VpcSecurityGroupIds
          - !Ref "AWS::NoValue"
        # AWS_IAM, not NONE — this dispatches real domain commands
        # (cap-table/governance-shaped data, for Embryonaut's own use);
        # an unauthenticated public URL is the wrong default for that,
        # even though it's the simpler one to demo with.
        FunctionUrlConfig:
          AuthType: AWS_IAM

  Outputs:
    FunctionUrl:
      Value: !GetAtt #{logical_id}Url.FunctionUrl
YAML

File.write(File.join(out_dir, "Makefile"), <<~MAKE)
  # GENERATED by bin/project_deploy #{domain} — re-run it to refresh
  # this file rather than hand-editing.
  #
  # `sam build` invokes the build-<LogicalId> target below (SAM's own
  # BuildMethod: makefile convention — see template.yaml's Metadata).
  # `cargo lambda` (https://www.cargo-lambda.info) cross-compiles
  # rust/host for arm64 Lambda without Docker or a hand-configured
  # cross-linker — install once with `pip3 install cargo-lambda` or
  # `brew install cargo-lambda`.

  HOST_DIR := #{File.join(root, "rust", "host")}
  WASM     := #{File.join(root, "rust", "dist", "#{domain_name}.wasm")}

  build-#{logical_id}:
  \t@command -v cargo-lambda >/dev/null 2>&1 || { \\
  \t\techo "cargo-lambda isn't installed. Install it once with: pip3 install cargo-lambda"; \\
  \t\texit 1; \\
  \t}
  \ttest -f $(WASM) || (cd #{root} && bin/project_wasm #{domain})
  \tcd $(HOST_DIR) && cargo lambda build --release --arm64
  \tcp $(HOST_DIR)/target/lambda/bootstrap/bootstrap $(ARTIFACTS_DIR)/bootstrap
  \tcp $(WASM) $(ARTIFACTS_DIR)/#{domain_name}.wasm
MAKE

puts "wrote #{out_dir}/template.yaml"
puts "wrote #{out_dir}/Makefile"
puts
puts "deploy from #{out_dir}:"
puts "    sam build && sam deploy --guided"
