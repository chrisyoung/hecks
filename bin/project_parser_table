#!/usr/bin/env ruby

# Generates rust/parser/src/keywords.rs FROM syntax.bluebook — the direct
# mechanism for "the parser's own grammar knowledge is DERIVED from
# hecksagain's self-description, not hand-typed a second time" (the core
# anti-drift idea the whole Rust-parser plan is built around).
#
# Reads the SAME source spec/syntax_conformance_spec.rb already reads to
# hold Ruby's own builders honest — Bluebook::MetaValidator.grammar_registry,
# the Syntax aggregate's Keyword/Argument/Context/Body/ArgumentKind/
# PairsShape/Status closed sets — and writes it out as a checked-in Rust
# table, never hand-edited. spec/parser_table_spec.rb regenerates this into
# memory and asserts byte equality with the committed file, so grammar
# drift (syntax.bluebook changes without regenerating keywords.rs) fails
# the NORMAL `bundle exec rspec` suite immediately.
#
#   bin/project_parser_table

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/bluebook/meta_validator"
require "fileutils"

module ParserTableProjection
  module_function

  def syntax
    meta = Hecksagain::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
    meta.aggregates.find { |a| a.hecks_name == "Syntax" }
  end

  # Every cell as text — exactly spec/syntax_conformance_spec.rb's own
  # `rows` helper, reused rather than re-derived: a member's fields decode
  # back through typed literal decoding on the way out of reconstruction,
  # and this reads it back as what was written.
  def rows(name)
    syntax.value_objects.find { |vo| vo.hecks_name == name }
          .members.map { |row| row.to_h.transform_values(&:to_s) }
  end

  def closed_set_members(name) = rows(name).map { |row| row[:name] }

  KEYWORD_FIELDS  = %i[word context body inner opens fills status was].freeze
  ARGUMENT_FIELDS = %i[keyword context at named kind required fills selects
                       pair_key_fills pair_value_fills pairs_shape status].freeze

  # A Rust string literal for one field's value — every field here is
  # plain ASCII (a word, a context name, a digit, "true"/"false"), so this
  # only has to be safe against the two characters Rust string literals
  # themselves reserve.
  def rust_string(value) = "\"#{value.to_s.gsub('\\', '\\\\\\\\').gsub('"', '\\"')}\""

  def keyword_row(row)
    fields = KEYWORD_FIELDS.map { |field| rust_string(row[field]) }
    "    KeywordRow { #{KEYWORD_FIELDS.zip(fields).map { |name, value| "#{name}: #{value}" }.join(', ')} },"
  end

  def argument_row(row)
    fields = ARGUMENT_FIELDS.map { |field| rust_string(row[field]) }
    "    ArgumentRow { #{ARGUMENT_FIELDS.zip(fields).map { |name, value| "#{name}: #{value}" }.join(', ')} },"
  end

  def const_str_array(name, values)
    lines = values.map { |value| "    #{rust_string(value)}," }
    "pub static #{name}: &[&str] = &[\n#{lines.join("\n")}\n];\n"
  end

  def render
    keywords  = rows("Keyword")
    arguments = rows("Argument")

    <<~RUST
      // GENERATED by bin/project_parser_table from
      // lib/hecksagain/language/bluebook/syntax.bluebook — DO NOT EDIT BY HAND.
      //
      // Re-run `bin/project_parser_table` after any change to syntax.bluebook.
      // spec/parser_table_spec.rb regenerates this into memory and fails the
      // normal `bundle exec rspec` suite the moment this file drifts from what
      // syntax.bluebook currently declares — see that spec and
      // bin/project_parser_table's own header for why this file is never
      // hand-edited.

      #[derive(Debug, Clone, Copy)]
      pub struct KeywordRow {
          pub word: &'static str,
          pub context: &'static str,
          pub body: &'static str,
          pub inner: &'static str,
          pub opens: &'static str,
          pub fills: &'static str,
          pub status: &'static str,
          pub was: &'static str,
      }

      #[derive(Debug, Clone, Copy)]
      pub struct ArgumentRow {
          pub keyword: &'static str,
          pub context: &'static str,
          pub at: &'static str,
          pub named: &'static str,
          pub kind: &'static str,
          pub required: &'static str,
          pub fills: &'static str,
          pub selects: &'static str,
          pub pair_key_fills: &'static str,
          pub pair_value_fills: &'static str,
          pub pairs_shape: &'static str,
          pub status: &'static str,
      }

      impl KeywordRow {
          /// An absent status reads as admitted — the grown-column convention
          /// syntax_conformance_spec.rb's own `status_of`/`live?` already use.
          pub fn live(&self) -> bool {
              matches!(self.status, "" | "admitted" | "deprecated")
          }
      }

      impl ArgumentRow {
          pub fn live(&self) -> bool {
              matches!(self.status, "" | "admitted" | "deprecated")
          }
      }

      pub static KEYWORDS: &[KeywordRow] = &[
      #{keywords.map { |row| keyword_row(row) }.join("\n")}
      ];

      pub static ARGUMENTS: &[ArgumentRow] = &[
      #{arguments.map { |row| argument_row(row) }.join("\n")}
      ];

      #{const_str_array('CONTEXTS', closed_set_members('Context'))}
      #{const_str_array('BODIES', closed_set_members('Body'))}
      #{const_str_array('ARGUMENT_KINDS', closed_set_members('ArgumentKind'))}
      #{const_str_array('PAIRS_SHAPES', closed_set_members('PairsShape'))}
      #{const_str_array('STATUSES', closed_set_members('Status'))}
    RUST
  end
end

if $PROGRAM_NAME == __FILE__
  out_path = File.expand_path("../rust/parser/src/keywords.rs", __dir__)
  FileUtils.mkdir_p(File.dirname(out_path))
  File.write(out_path, ParserTableProjection.render)
  puts "wrote #{out_path}"
end
