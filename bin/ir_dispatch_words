#!/usr/bin/env ruby

# WHICH WORD OPENS WHICH CATEGORY — projected into Rust source, one context at
# a time.
#
# `language/bluebook/syntax.bluebook` already declares this : `Syntax::Keyword`
# holds a row per word, and `opens` names the category a word with a nested
# body declares. `bin/ir_syntax` reads the SAME table for a different job
# (catching a typo of a word at aggregate-body level) ; this reads it to
# generate the RECOGNITION ITSELF — the word-list a parser's own dispatch
# function currently hand-maintains, one `if line.starts_with(...)` per word.
#
# THE FIRST RUNG OF PROJECTING THE PARSER, not the whole thing. Only WORD
# RECOGNITION is generated here — which word a line starts with, and which
# category that word opens. What happens once a category opens (which Rust
# function parses its body, what it builds) stays hand-written ; so does every
# word's ARGUMENT shape. A generator that also tried to build the record
# itself would need a code-generation strategy for eight different argument
# kinds (`text`, `symbol`, `constant`, `flag`, `literal`, `pairs`, `list`,
# `number`) grouped by CONTEXT, not by category — a materially harder problem
# solved separately, if it is solved at all. This rung is deliberately small
# enough that its correctness is nearly free to check: the words recognized
# and the functions called do not change, only where the word LIST lives, so
# the existing test suite is the verification with nothing new to write.
#
# ONE CONTEXT PER COMMIT, not the whole language at once — `CONTEXTS` below is
# the explicit list to grow, in the same spirit as bin/ir_structs' own
# explicit `ROOTS`/`CATEGORIES` rather than a sorted glob.
#
# AGGREGATE'S FIVE ARE NOT ISOLATED THE WAY BLUEBOOK'S FOUR WERE. Bluebook's
# opens-bearing words live in their own small function (`dispatch_block`),
# checked uniformly (`keyword_matches`) and nothing else. Aggregate's five
# (`command`, `entity`, `policy`, `query`, `value_object`) are interleaved in
# ONE loop with eight words that fill a field instead of opening a category
# (`attribute`, `description`, `identified_by`, `reference_to`, `has_many`,
# `has_one`, `belongs_to`, `lifecycle`), and three of the five were checked
# with a bare `line.starts_with(literal)` — no word-boundary guard at all —
# while a fourth (`policy`) used a hand-rolled space-or-tab check instead of
# the shared `keyword_matches` helper. Normalized to `keyword_matches`
# uniformly when this context's table was wired in : verified against the
# whole corpus, since tightening a loose prefix check is a real behavior
# change in principle even where no real bluebook exercises the difference.
#
# WHOLE FILE, NEVER A PATCH — same rule as bin/ir_syntax, bin/ir_vocabulary,
# and bin/ir_structs.
#
# Regenerate with:
#
#   bin/ir_dispatch_words > rust/src/bluebook/ir_dispatch_words.rs
#
# spec/ir_dispatch_words_export_spec.rb holds the checked-in file equal to
# this script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

syntax = Hecksagain::Bluebook::MetaValidator
         .grammar_registry.bluebook("Bluebook").aggregate("Syntax")

keyword = syntax.value_object("Keyword") or raise "the language declares no Syntax::Keyword to project"

CONTEXTS = %w[Bluebook Aggregate Entity ProcessManager Handler OneOf].freeze

def table_name(context) = "#{Hecksagain::Naming.snake(context).upcase}_WORDS"

def words_for(keyword, context)
  rows = keyword.members
                .map(&:to_h)
                .select { |row| row.fetch(:context) == context && !row.fetch(:opens).to_s.empty? }
                .uniq { |row| row.fetch(:word) }
                .sort_by { |row| row.fetch(:word) }

  raise "Syntax::Keyword admits no word that opens something in context #{context}" if rows.empty?

  rows
end

tables = CONTEXTS.map do |context|
  rows = words_for(keyword, context)
  entries = rows.map { |row| "    (\"#{row.fetch(:word)}\", \"#{row.fetch(:opens)}\"),\n" }.join
  "pub const #{table_name(context)}: &[(&str, &str)] = &[\n#{entries}];\n"
end

puts <<~RUST
  // GENERATED BY bin/ir_dispatch_words — DO NOT EDIT BY HAND.
  //
  // Which word opens which category, per context — projected from the
  // language's own declared syntax (Syntax::Keyword, rows where `opens` is not
  // empty).
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook
  // Regenerate: bin/ir_dispatch_words > rust/src/bluebook/ir_dispatch_words.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_dispatch_words_export_spec.rb.

  #{tables.join("\n")}
RUST
