#!/usr/bin/env ruby

# THE LANGUAGE, PROJECTED INTO RUST SOURCE.
#
# `bin/operators` and `bin/mutation_ops` export a vocabulary as DATA — a JSON
# table Rust embeds and parses. This exports one as CODE: the Rust enum
# declarations themselves, emitted from the closed sets the language declares
# about itself in `Vocabulary` (lib/hecksagain/language/bluebook/vocabulary.bluebook).
#
# Rust held its own hand-written copies of both, and both had drifted — MutationOp
# carried eleven variants where the language admits four, and WhereOp carried a
# ninth the language never declared. A copy nothing compares is a copy that
# drifts, which is the finding this whole arc keeps making. Generating them
# removes the copy rather than checking it.
#
# WHOLE FILE, NEVER A PATCH. This writes a complete module ; it does not reach
# into ir.rs and rewrite a region, because a generator that edits hand-written
# source is a regex patch wearing a better name.
#
# Regenerate with:
#
#   bin/ir_vocabulary > rust/src/bluebook/ir_vocabulary.rs
#
# spec/ir_vocabulary_export_spec.rb holds the checked-in file equal to this
# script's current output, so a forgotten regeneration goes red rather than
# compiling against a stale table.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

# WHICH RUST ENUM EACH CLOSED SET BECOMES — said once, beside this script, because
# bin/ir_structs reads the same table to type a field from its `admits:`.
require_relative "vocabulary_projections"

vocabulary = Hecksagain::Bluebook::MetaValidator
             .grammar_registry.bluebook("Bluebook").aggregate("Vocabulary")

enums = PROJECTIONS.map do |declared, rust_name|
  shape = vocabulary.value_object(declared) or
    raise "the language declares no Vocabulary::#{declared} to project"

  variants = shape.members.map { |row| Hecksagain::Naming.pascal(row.to_h.fetch(:name)) }
  raise "Vocabulary::#{declared} admits nothing, so #{rust_name} would be uninhabited" if variants.empty?

  <<~ENUM.chomp
    /// `Vocabulary::#{declared}`, as the language declares it.
    #[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
    pub enum #{rust_name} {
    #{variants.map { |variant| "    #{variant}," }.join("\n")}
    }
  ENUM
end

puts <<~RUST
  // GENERATED BY bin/ir_vocabulary — DO NOT EDIT BY HAND.
  //
  // The closed sets the language declares about itself, projected into Rust.
  // Source: lib/hecksagain/language/bluebook/vocabulary.bluebook (Vocabulary).
  // Regenerate: bin/ir_vocabulary > rust/src/bluebook/ir_vocabulary.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_vocabulary_export_spec.rb, and held equal to each runtime's live
  // table by spec/vocabulary_conformance_spec.rb — so the language, Ruby and
  // Rust cannot disagree about what these sets admit.

  #{enums.join("\n\n")}
RUST
