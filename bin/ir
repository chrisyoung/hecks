#!/usr/bin/env ruby

# Prints a booted domain's IR as JSON — the same `to_h` the golden
# specs pin and StorageShape hashes into an era, for reading rather
# than asserting on.
#
#   bin/ir <domain> [--translations]

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

translations_only = ARGV.delete("--translations")
domain  = ARGV.shift || File.expand_path("../examples/pizzas", __dir__)
runtime = Hecks.boot(domain)

if translations_only
  puts Hecksagain::Projector::Exporter.translations_json(runtime.registry)
else
  puts Hecksagain::Projector::Exporter.json(runtime.registry)
end
