#!/usr/bin/env ruby
# frozen_string_literal: true

# Export a domain's IR as JSON.
#
#   bin/ir examples/pizzas > /tmp/pizzas.ir.json
#
# The work is in Hecksagain::Projector::Exporter ; this is only the handle.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

domain  = ARGV.shift || File.expand_path("../examples/pizzas", __dir__)
runtime = Hecks.boot(domain)

puts Hecksagain::Projector::Exporter.json(runtime.registry)
