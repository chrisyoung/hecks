#!/usr/bin/env ruby

# WHICH NAMED ARGUMENTS ARE TEXT — projected into Rust source, the same
# shape bin/ir_syntax_flags established for kind "flag", one kind further.
#
# `language/bluebook/syntax.bluebook` already declares this: `Syntax::Argument`
# holds a `kind` per row, and `"text"` means "a quoted string, read as-is".
# Unlike `flag`, no single Rust function owns every text-kind read —
# `admits:`/`pattern:` go through `parse_quoted_kwarg`, `version:` through
# `extract_kwarg_string` — so this generates an ASSERTION each call site
# checks itself against (`assert_text_kwarg`, parse_blocks.rs), not a single
# reader to route through.
#
# `from:` IS DECLARED TWICE, ON PURPOSE, AND EXCLUDED HERE BY NAME.
# `transition`'s `from:` is legitimately BOTH kind "text" (one prior state)
# and kind "list" (several) — the one named argument in the corpus where
# "kind" genuinely depends on how many values are given, not on which
# argument it is. A table keyed by name alone cannot say which kind a call
# site meant, so `from` stays outside this generator the same way `pairs`
# stays outside argument generation entirely: named, not silently dropped.
#
# THIS DOES NOT GENERATE THE READER. Each call site keeps its own existing
# extractor (`parse_quoted_kwarg` or `extract_kwarg_string`) ; what changes
# is that it asserts against this table first, the same discipline
# `parse_flag_kwarg` already holds flag-kind arguments to.
#
# Regenerate with:
#
#   bin/ir_syntax_text > rust/src/bluebook/ir_syntax_text.rs
#
# spec/ir_syntax_text_export_spec.rb holds the checked-in file equal to this
# script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

syntax = Hecksagain::Bluebook::MetaValidator
         .grammar_registry.bluebook("Bluebook").aggregate("Syntax")

argument = syntax.value_object("Argument") or raise "the language declares no Syntax::Argument to project"

# named ARGUMENTS DECLARED BOTH "text" AND SOME OTHER KIND AT THE SAME
# KEYWORD+CONTEXT — see `from:` above. Excluded from every kind's table,
# not just text's, since a name this ambiguous is not safely assertable
# against any single kind.
def dual_kind_names(argument)
  rows = argument.members.map(&:to_h).reject { |row| row.fetch(:named).to_s.empty? }
  rows.group_by { |row| row.fetch(:named) }
      .select { |_, group| group.map { |row| row.fetch(:kind) }.uniq.size > 1 }
      .keys
end

def kind_argument_names(argument, kind)
  ambiguous = dual_kind_names(argument)

  rows = argument.members
                 .map(&:to_h)
                 # A proposed or retired argument reaches no projected table —
                 # to a projected reader it does not exist. Deprecated reads.
                 .reject { |row| %w[proposed retired].include?(row[:status].to_s) }
                 .select { |row| row.fetch(:kind) == kind }
                 .reject { |row| row.fetch(:named).to_s.empty? }
                 .reject { |row| ambiguous.include?(row.fetch(:named)) }
                 .uniq { |row| row.fetch(:named) }
                 .sort_by { |row| row.fetch(:named) }

  raise "Syntax::Argument admits no argument of kind #{kind.inspect}" if rows.empty?

  rows.map { |row| row.fetch(:named) }
end

names = kind_argument_names(argument, "text")
entries = names.map { |n| "    \"#{n}\",\n" }.join

puts <<~RUST
  // GENERATED BY bin/ir_syntax_text — DO NOT EDIT BY HAND.
  //
  // Every named argument the language declares as kind "text" — a quoted
  // string, read as-is. `from:` is declared but excluded: it is ALSO kind
  // "list" at the same keyword+context (transition's from: takes one state
  // or several), so no single kind table can assert it correctly.
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook
  // Regenerate: bin/ir_syntax_text > rust/src/bluebook/ir_syntax_text.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_syntax_text_export_spec.rb. Checked at every call by
  // assert_text_kwarg itself (parse_blocks.rs) — a kwarg name reaching that
  // assertion which this table does not list is a reader/declaration
  // mismatch, not a missing feature.

  pub const TEXT_ARGUMENTS: &[&str] = &[
  #{entries}];
RUST
