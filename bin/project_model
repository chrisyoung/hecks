#!/usr/bin/env ruby

# Projects the model's holding half from the language that declares it.
# Behaviour::X is hand-written and untouched; `settle` is the seam.
#
#   bin/project_model

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

chapter = Hecksagain::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
out     = File.expand_path("../lib/hecksagain/bluebook", __dir__)

written = Hecksagain::Projector.write(
  Hecksagain::Projector.call(:model, bluebook: chapter), out, as: :files
)
written.each { |path| puts "wrote #{path}" }
