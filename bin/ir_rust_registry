#!/usr/bin/env ruby

# EVERY PROJECTED DOMAIN, AS ONE TABLE — the registry `projected/mod.rs`
# used to hand-maintain in five separate spots (a `pub mod` line, a match
# arm in `by_source`, a match arm in `by_name`, an entry in `names()`, and a
# second hand-built list inside its own test module) every time a domain was
# projected. All five collapse onto one generated function; `mod.rs` reads
# it generically and never needs another hand-edit.
#
# WHAT IT READS. Not the language's own declared syntax, unlike every other
# `bin/ir_*` generator — there is no schema row for "which domains are
# projected." It reads the PROJECTED FILES THEMSELVES
# (`rust/src/bluebook/projected/*.rs`, `bin/ir_rust`'s own output), as text,
# for two facts each already carries: its `CHAPTER` constant and its
# `SOURCE_SHA` constant. Both are required to be present, or this refuses
# loudly rather than silently emitting a partial registry — a projected file
# with no `CHAPTER` is a file this generator does not know how to trust, not
# one to skip past.
#
# ALWAYS EVERY DOMAIN — selection is a BUILD-TIME FLAG, not a different
# generated file. Every discovered chapter is always declared here, each
# behind its own `#[cfg(feature = "...")]` (item-level cfg — stable ;
# `#[cfg]` on individual elements of a slice LITERAL is not, on stable
# Rust, which is why the table below is built by a function with per-push
# cfg guards rather than a `const` array). `rust/Cargo.toml` names one
# feature per domain plus `default` carrying all of them, so a plain
# `cargo build`/`cargo test` keeps linking everything, unchanged ; a
# deployment wanting only Banking builds with `--no-default-features
# --features banking` instead. This file's own SHAPE never depends on what
# you last built for.
#
# WHOLE FILE, NEVER A PATCH — same rule as every other generator here.
#
# Regenerate with:
#
#   bin/ir_rust_registry > rust/src/bluebook/projected/registry.rs
#
# spec/ir_rust_registry_export_spec.rb holds the checked-in file equal to
# this script's current output.

ROOT = File.expand_path("..", __dir__)
PROJECTED_DIR = File.join(ROOT, "rust/src/bluebook/projected")

files = Dir.glob(File.join(PROJECTED_DIR, "*.rs")).reject do |path|
  %w[mod.rs registry.rs].include?(File.basename(path))
end.sort

raise "no projected/*.rs files found under #{PROJECTED_DIR} — nothing to register" if files.empty?

Domain = Struct.new(:stem, :chapter, :sha)

domains = files.map do |path|
  text = File.read(path)
  stem = File.basename(path, ".rs")

  chapter = text[/pub const CHAPTER: &str = "([^"]+)";/, 1] or
    raise "#{path} declares no `pub const CHAPTER` — regenerate it with bin/ir_rust first"
  sha = text[/pub const SOURCE_SHA: &str = "([^"]+)";/, 1] or
    raise "#{path} declares no `pub const SOURCE_SHA` — regenerate it with bin/ir_rust first"

  Domain.new(stem, chapter, sha)
end.sort_by(&:chapter)

mod_decls = domains.map { |d| "#[cfg(feature = \"#{d.stem}\")]\npub mod #{d.stem};" }.join("\n")
pushes = domains.map do |d|
  "    #[cfg(feature = \"#{d.stem}\")]\n" \
    "    items.push(Projected { chapter: \"#{d.chapter}\", sha: #{d.stem}::SOURCE_SHA, domain: #{d.stem}::domain });"
end.join("\n")

puts <<~RUST
  // GENERATED BY bin/ir_rust_registry — DO NOT EDIT BY HAND.
  //
  // Every domain `bin/ir_rust` has projected into this binary, as one table
  // — always all of them, declared here ; WHICH ones actually compile in is
  // a Cargo feature (`rust/Cargo.toml`'s own `[features]`, one per domain,
  // `default` carrying all six), not a different generated file. `mod.rs`
  // reads this generically (`by_source`/`by_name`/`names()`) instead of
  // hand-matching each chapter — adding a projected domain means running
  // `bin/ir_rust`, then this, then naming its feature in `rust/Cargo.toml`
  // and `rust/cli/Cargo.toml`, and touching no hand-written logic at all.
  //
  // Source: rust/src/bluebook/projected/*.rs (each file's own `CHAPTER` and
  // `SOURCE_SHA` constants — bin/ir_rust emits both).
  // Regenerate: bin/ir_rust_registry > rust/src/bluebook/projected/registry.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_rust_registry_export_spec.rb.

  #{mod_decls}

  pub struct Projected {
      pub chapter: &'static str,
      pub sha: &'static str,
      pub domain: fn() -> crate::ir::Domain,
  }

  /// A FUNCTION, NOT A `const` SLICE — `#[cfg]` on one PUSH per domain is
  /// stable ; `#[cfg]` on individual elements of a `&[...]` literal is not,
  /// on stable Rust (`stmt_expr_attributes`, still nightly-only). Called
  /// once per lookup rather than held as a static table — a handful of
  /// domains, never on a hot path — is the price of that, and it is a small
  /// one.
  pub fn registry() -> Vec<Projected> {
      let mut items = Vec::new();
  #{pushes}
      items
  }
RUST
