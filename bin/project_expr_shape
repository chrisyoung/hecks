#!/usr/bin/env ruby

# PRD 11 — writes the `Expr` enum declaration ONLY (structure, not
# interpretation) from ONE definition:
# Hecksagain::Bluebook::Expression::NodeShapeRust
# (lib/hecksagain/bluebook/expression/node_shape_rust.rb — see that
# file's own header for why its ground truth is the CURRENT, WORKING
# `rust/src/kernel/expr.rs` enum, read directly, not inferred).
#
# WHERE THIS WRITES, ON PURPOSE. `rust/src/kernel/expr/mod.rs` — NOT a
# straight overwrite of the existing flat `expr.rs`. Converting `expr.rs`
# into a directory (`mod.rs` for the generated enum, `logic.rs` for
# hand-written `interpret`/`category_of`/`dispatch_operator`/`Value`/
# `Field`/etc.) is a one-time manual step this script does not perform —
# the same `mod.rs` + `logic.rs` split `bin/project_binding_shape`
# already established for `binding/`, kept consistent rather than
# inventing a second convention for the larger grammar.
#
#   bin/project_expr_shape

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/bluebook/expression/node_shape_rust"
require "fileutils"
require "tempfile"

ROOT = File.expand_path("..", __dir__)
Shape = Hecksagain::Bluebook::Expression::NodeShapeRust

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

def variant_line(name, node)
  case node.kind
  when :unit
    "    #{node.rust_name},"
  when :tuple
    types = node.fields.map(&:rust_type).join(", ")
    "    #{node.rust_name}(#{types}),"
  when :struct
    members = node.fields.map { |field| "#{field.rust_name}: #{field.rust_type}" }.join(", ")
    "    #{node.rust_name} { #{members} },"
  else
    raise "no emitter for node kind #{node.kind.inspect} (#{name}) — add one before this manifest can produce it"
  end
end

variants = Shape.rust_node_names.map { |name| variant_line(name, Shape::RUST_NODES.fetch(name)) }.join("\n")

content = <<~RUST
  // GENERATED by bin/project_expr_shape from Hecksagain::Bluebook::
  // Expression::NodeShapeRust (lib/hecksagain/bluebook/expression/
  // node_shape_rust.rb). Do not hand-edit — re-run bin/project_expr_shape
  // instead. Interpretation logic (`interpret`/`category_of`/
  // `dispatch_operator`, `Value`, `Field`/`Fielded`, `EvalContext`, etc.)
  // stays hand-written in logic.rs, re-exported below — this file is
  // structure only, the same split binding/mod.rs already draws.
  //
  // `Resolve` and `ArrayLiteral` are real Ruby nodes with no variant
  // here on purpose — see NodeShapeRust's own header for why.
  //
  // `Comparison` re-exported here, `pub`, not just `use`d — external
  // callers reach it as `crate::kernel::expr::Comparison` (the same
  // path it always had, before `expr.rs` became a directory), and the
  // `Expr` enum's own `Compare`/`SignTest` fields need it in scope
  // either way.

  pub use crate::kernel::expression_operators::comparison::Comparison;

  #[derive(Debug, Clone)]
  #[allow(dead_code)]
  pub enum Expr {
  #{variants}
  }

  mod logic;
  pub use logic::*;
RUST

write_atomically(File.join(ROOT, "rust/src/kernel/expr/mod.rs"), content)
