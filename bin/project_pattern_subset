#!/usr/bin/env ruby

# Projects Hecksagain::Bluebook::PatternSubset::REASONS/::CONSTRUCTS
# (lib/hecksagain/bluebook/pattern_subset.rb) into rust/parser/src/build/
# pattern_subset/reasons.rs — the refusal-wording DATA `PatternSubset
# .validate`'s own Rust port (build/pattern_subset/mod.rs) reads, found
# hand-copied verbatim rather than generated (a real, if small, drift
# risk this closes the same way bin/project_field_hints/bin/
# project_parser_table already close the identical risk for their own
# Ruby-declared-but-Rust-consumed vocabularies). `validate` itself stays
# hand-written — see that file's own header for why.
#
#   bin/project_pattern_subset

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/bluebook/pattern_subset"
require "fileutils"
require "tempfile"

ROOT   = File.expand_path("..", __dir__)
Subset = Hecksagain::Bluebook::PatternSubset

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# Ruby `Hash` iteration order is insertion order — REASONS/CONSTRUCTS are
# both declared with the SAME key order in pattern_subset.rb, so zipping
# by iterating REASONS's own keys reproduces that order exactly, the
# identical order the hand-written table (this generator replaces) was
# already written in.
entries = Subset::REASONS.map do |key, reason|
  construct = Subset::CONSTRUCTS.fetch(key)
  <<~RUST.chomp
    (
        #{key.to_s.inspect},
        #{construct.inspect},
        #{reason.inspect},
    ),
  RUST
end

content = <<~RUST
  // GENERATED by bin/project_pattern_subset from Hecksagain::Bluebook::
  // PatternSubset::REASONS/::CONSTRUCTS (lib/hecksagain/bluebook/
  // pattern_subset.rb). Do not hand-edit — re-run
  // bin/project_pattern_subset instead. `validate` (../mod.rs) stays
  // hand-written; only this refusal-wording data is generated.

  pub const REASONS: &[(&str, &str, &str)] = &[
  #{entries.join("\n").gsub(/^/, '    ')}
  ];
RUST

write_atomically(File.join(ROOT, "rust/parser/src/build/pattern_subset/reasons.rs"), content)
