#!/usr/bin/env ruby

# Dumps the mutation-op table both runtimes' arithmetic reads instead of
# hardcoding an increment/decrement ternary. Ruby reads
# CommandRules::MUTATION_OPS directly ; Rust cannot run this file, so its
# copy is this script's output, checked in at
# rust/src/runtime/mutation_ops.json and embedded at compile time.
# Regenerate with:
#
#   bin/mutation_ops > rust/src/runtime/mutation_ops.json
#
# spec/vocabulary_conformance_spec.rb holds CommandRules::MUTATION_OPS equal
# to what the language declares (Vocabulary::MutationOp) ;
# spec/operators_export_spec.rb holds the checked-in JSON equal to this
# script's own output, so regenerate it any time MUTATION_OPS changes.

require "json"
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

rows = Hecksagain::Runtime::CommandRules::MUTATION_OPS.map do |op|
  { name: op.name, sign: op.sign }
end

puts JSON.pretty_generate(rows)
