#!/usr/bin/env ruby

# A live discovery session — one declaration at a time, the language's
# OWN refusals as the interview's feedback, rendered as an event-storming
# wall (docs/event-storming-policies.md's mapping: aggregate/yellow,
# command/blue, event/orange, policy/lilac).
#
# EVERY INVOCATION IS A FRESH PROCESS. The Interview domain (questions,
# findings, proposals) is where this session actually lives — a real
# app's own `.world` binding via `--at`, or, with none given, Heki
# (the file-backed store) writing under `./data`, relative to wherever
# you're standing when you run this — `Heki#resolve_path`'s own default
# `dir` when no world supplies one, nothing this file has to scaffold.
# True in-RAM Memory is NOT offered here on purpose: a one-shot CLI
# where each command is its own OS process cannot use it as a session
# store at all — the very next command sees an empty registry, gone
# before it could be read back. (Memory is still `Interview::Session`'s
# own default for programmatic/spec use, a single Ruby process — that
# case is real and unaffected.) `./data` is throwaway bookkeeping, not
# the saved domain — `save` is what writes something meant to last, and
# every chapter's records share it freely: `Interview`/`Finding`/
# `Proposal` are already chapter-scoped by their own `chapter`/
# `interview_id` fields, the same reason one running app can hold more
# than one bluebook.
#
# The partial bluebook being discovered is NOT stored anywhere: it is
# rebuilt every time by re-dispatching every WRITTEN proposal's own verb
# and arguments through `Interview::Lowering` into a fresh
# `Interview::Session` — a head, derived from a journal that already had
# to be durable for its own sake. A language change fails LOUDLY here
# (`UnknownVerb`/`NotFound` naming exactly what broke), never silently.
#
#   bin/interview draft     <slug> --topic T --why "..." "prompt text" [--at DIR]  — the catalogue,
#   bin/interview publish   <slug> [--at DIR]                                        not chapter-scoped
#   bin/interview open      <Chapter> --subject "..." --respondent <id> [--at DIR]
#   bin/interview state     <Chapter> [--at DIR]
#   bin/interview gaps      <Chapter> [--at DIR]
#   bin/interview shape     "Bluebook::Aggregate.Declare"        — the verb's own --arg template, resolved
#                                                                    from the language itself: no chapter, no --at
#   bin/interview check     <Chapter> [--at DIR]                 — render+reload, no write; catches a renderer/
#                                                                    reloader disagreement early, not a dispatch bug
#   bin/interview smoke     <Chapter> [--at DIR]                 — boots the rendered domain for real (Memory,
#                                                                    a throwaway temp dir) and dispatches every
#                                                                    declared command + report once, synthesized
#                                                                    args — catches what `check` cannot
#   bin/interview ask       <Chapter> "question text" [--topic T] [--source mechanical|catalogue|judgment] [--ref CATALOGUE-REF] [--at DIR]
#   bin/interview answer    <Chapter> <sequence> "answer text" [--at DIR]
#   bin/interview establish <Chapter> --ref F1 --topic T "statement" [--at DIR]
#   bin/interview preview   <Chapter> --verb "Bluebook::X.Y" [--arg name:field:value ...] [--at DIR]  — what
#                                                                    propose+accept would do, nothing written
#   bin/interview propose   <Chapter> --ref P1 --finding F1 --verb "Bluebook::X.Y" "rationale" [--arg name:field:value ...] [--at DIR]
#   bin/interview accept    <Chapter> <proposal-ref> [--at DIR]
#   bin/interview correct   <Chapter> <proposal-ref> "why it was wrong" [--at DIR]  — a WRITTEN mistake stays
#                                                                    written; correct just excludes it from replay
#   bin/interview save      <Chapter> --to DIR
#   bin/interview suggest   <Chapter> --kind aggregate|command|event|... "meaning" [--near X,Y] [--at DIR]
#   bin/interview critique  <Chapter> [--at DIR]
#
# `suggest`/`critique` are the ONLY two commands that touch
# `Ports::Agent` — everything above them is plain Ruby, no model
# involved, because a human running this tool interactively IS the
# interviewer. These two exist for the headless case: nobody in the
# room to ask "what should I call this" or "does this look right."
# `.claude/skills/interview/SKILL.md` never calls either — Claude Code
# conducting a live session already reasons about names and taste
# itself, with better context than a one-shot prompt ever gets.
#
# `--at DIR` boots a real app directory the normal way (`Hecks.boot`), so
# the Interview domain's own persistence is whatever that app's `.world`
# says — Postgres, durably, once one exists. With no `--at`, Heki under
# `./data` is what makes the conversation survive from one command to
# the next.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain/interview"
require "json"

ROOT = File.expand_path("..", __dir__)

# ── colour, in the event-storming vernacular ──────────────────────────
#
# NO_COLOR HONOURED — colour is emphasis on text that already reads
# correctly without it, never the only carrier of a fact.
module Paint
  CODES = { yellow: 33, blue: 34, orange: 208, lilac: 141, green: 32, red: 31, dim: 2 }.freeze

  module_function

  def on? = ENV["NO_COLOR"].to_s.empty? && $stdout.tty?

  def call(text, colour)
    return text unless on?

    code = CODES.fetch(colour)
    prefix = code > 37 ? "\e[38;5;#{code}m" : "\e[#{code}m"
    "#{prefix}#{text}\e[0m"
  end
end

def paint(text, colour) = Paint.call(text, colour)

# ── booting the Interview domain (real records live here) ────────────

# `--at DIR` boots a real app the ordinary way; with none, a Heki-bound
# boot rooted at `Dir.pwd` — the same preamble every spec/probe in this
# build already uses (matching `bin/scaffold_translation`'s own shape
# for a script that is not a full app), just no longer bound to Memory.
#
# HEKI, NOT MEMORY, ON PURPOSE. `bin/interview` is a one-shot CLI: every
# subcommand is its own OS process, so Memory (pure in-RAM) is gone
# before the next command could ever read it back — proven live, not
# assumed.
#
# A REAL HECKSAGON *AND* A REAL WORLD, both built inline rather than
# loaded from `.hecksagon`/`.world` files on disk — the same
# `Hecks.hecksagon`/`Hecks.world` DSL entry points those files call,
# producing identical IR (`Registry#add_hecksagon`/`#add_world`); the
# runtime never distinguishes "loaded from a file" from "built by a
# script." Declaring the world explicitly, rather than leaning on
# `Heki#resolve_path`'s own default (`dir` falls back to `"data"` when
# `registry.world(domain)&.for_binding(...)` finds nothing — an absent
# world is empty settings, not an error, so it WOULD have booted with
# no world at all), matches how every real corpus member — banking,
# pizzas — actually binds Heki: an explicit `persisted_by("Heki") { dir
# "..." }` in a `.world`, not silence relying on a fallback nobody
# reading this file would otherwise see. `.interview`, not a bare
# `data` — this is bookkeeping for the interview itself, not the saved
# domain, and a dot-directory is the one shape most tools and most
# `.gitignore`s already know to leave alone.
def boot_interview_domain(at:)
  return Hecks.boot(at) if at

  registry = Hecksagain::Runtime::Registry.new(root: Dir.pwd)
  Hecksagain.with_registry(registry) do
    # EVERY FRAMEWORK PORT AND ADAPTER, the identical call a real
    # `Hecks.boot` makes (`Loader.boot` -> `Folder#load_library`) —
    # not a hand-picked subset. Registering `agent`/`ClaudeCode` here
    # is what lets `suggest`/`critique` below resolve
    # `Ports::Agent.adapter(RUNTIME.registry)` without a second,
    # parallel boot path to keep in sync by hand.
    Hecksagain::Adapters::Folder.new.load_library
    Kernel.load(File.join(ROOT, "lib/hecksagain/framework/bluebook/interview.bluebook"))
    Hecks.hecksagon("Interview") do
      ::Interview::Interview.persisted_by("Heki")
      ::Interview::StandingQuestion.persisted_by("Heki")
      ::Interview::Finding.persisted_by("Heki")
      ::Interview::Proposal.persisted_by("Heki")
    end
    Hecks.world("Interview") do
      realm "CLI"
      persisted_by("Heki") { dir ".interview" }
    end
  end
  registry.verify!
  runtime = Hecksagain::Runtime::Dispatcher.new(registry)
  Hecksagain::Runtime::Loader.bind_runtime(runtime)
  runtime
end

# THE ONE GATHERING SESSION FOR THIS CHAPTER — most commands act against
# "the" interview rather than naming one, so this resolves it the same
# way a human would ask: whichever session against this chapter is
# still `gathering`. More than one is named explicitly rather than
# guessed at; that is a real ambiguity, not a default to paper over.

# QUERIES ARE NOT ON THE DOOR — `Facade::Surface::AggregateDoor` exposes
# creating verbs, `find`/`all`/`count`/`events`, and the `.hecksagon`
# binding collector, but no declared `query` at all (confirmed against a
# live boot: `Interview::Interview.gathering` raises `NoMethodError`).
# Every read below goes straight through `RUNTIME.query`, which answers
# an array of plain hashes — `{id:}.merge(state)`, value-object fields
# still wrapped as `Runtime::Value` — the same shape `forms.rb`'s own
# `run_query` reads.
def query(verb, **args) = RUNTIME.query(verb, **args)

def current_session_ref(chapter)
  gathering = query("Interview::Interview.Gathering").select { |row| row[:chapter].value == chapter }
  abort "no open interview for #{chapter.inspect} — run `bin/interview open #{chapter} ...` first" if gathering.empty?
  if gathering.size > 1
    refs = gathering.map { |row| row[:id] }.join(", ")
    abort "#{gathering.size} open interviews for #{chapter.inspect} (#{refs}) — this tool does not choose between them"
  end

  gathering.first[:id]
end

# EVERY WRITTEN PROPOSAL FOR THIS CHAPTER'S SESSIONS, oldest first — the
# journal `rebuild` replays. No declared query answers "every proposal,
# any status" (`Pending`/`Awaiting`/the two `RestingOn...`s each filter
# by status, because each answers a real operational question, and "all
# of them, whatever their status" was never one of those until this
# replay needed it) — so this reads the raw repository via `.all` (a
# door method that IS real — see above) and filters here instead of
# inventing a query for a need only this file has.
def written_proposals_for(chapter)
  session_refs = query("Interview::Interview.ForChapter", chapter: { value: chapter }).map { |row| row[:id] }
  Interview::Proposal.all
                      .select { |p| session_refs.include?(p.interview_id) && p.status == "written" }
                      .sort_by { |p| p.sequence.value }
end

# REBUILD THE PARTIAL BLUEBOOK — the head, derived from the journal
# (`written_proposals_for`) that already had to be durable for its own
# sake. A language change fails loudly here, never silently.
def rebuild(chapter)
  session  = Hecksagain::Interview::Session.open(chapter)
  lowering = Hecksagain::Interview::Lowering.new
  written_proposals_for(chapter).each do |proposal|
    verb, args = lowering.lower(proposal.verb.value, proposal.arguments.map(&:to_h))
    session.offer(verb, **args)
  end
  session
end

# ── the event-storming wall ────────────────────────────────────────────

def render_state(chapter)
  session = rebuild(chapter)
  decl = session.declaration

  puts "#{paint(decl[:name], :yellow)}  ·  #{decl[:aggregates].size} aggregate(s)"
  puts

  decl[:aggregates].each do |aggregate|
    puts paint("▐ #{aggregate[:name]}", :yellow)
    commands = aggregate[:commands] || []
    if commands.any?
      puts "  #{commands.map { |c| paint(c[:name], :blue) }.join('  ')}"
      commands.flat_map { |c| c[:emits] }.compact.each { |event| puts "    #{paint(event, :orange)}" }
    else
      puts "  #{paint('(no commands yet)', :dim)}"
    end
    puts
  end

  render_gaps(session)
end

def render_gaps(session)
  gaps = session.gaps
  return puts paint("no gaps — this chapter could seal", :green) if gaps.empty?

  puts paint("gaps", :red)
  gaps.each { |gap| puts "  #{gap}" }
end

# ── the verb's own shape, as a ready-to-fill --arg template ───────────
#
# WHAT `propose` NEEDS TO KNOW, IN ONE CALL — the same fact
# `.claude/skills/interview/SKILL.md` says to "read off the language
# itself, never guess," but which used to mean a chain of hand-written
# `bin/ir --meta | jq` pipelines: one to list a command's attributes,
# then one MORE per attribute to resolve which value object it wraps
# and what field that VO actually declares (rarely but not always
# `value` — `Position` alone breaks that assumption). Five to ten
# shell calls to propose one command, every single time, forever,
# until this collapsed it into one. Reads the SAME real IR objects
# `bin/ir --meta` exports — `MetaValidator.grammar_registry`, not a
# second index kept in sync by hand.
def render_shape(verb_text)
  chapter_name, aggregate_name, command_name = verb_text.match(/\A([A-Za-z]+)::([A-Za-z]+)\.([A-Za-z]+)\z/)&.captures
  abort "#{verb_text.inspect} isn't fully qualified — Chapter::Aggregate.Command" unless chapter_name

  registry = Hecksagain::Bluebook::MetaValidator.grammar_registry
  chapter  = registry.bluebook(chapter_name) or abort "no chapter #{chapter_name.inspect} in the language"
  aggregate = chapter.aggregate(aggregate_name) or abort "#{chapter_name} declares no aggregate #{aggregate_name.inspect}"
  command   = aggregate.command(command_name) or abort "#{aggregate_name} declares no command #{command_name.inspect}"

  puts "#{paint(verb_text, :blue)}  —  #{command.goal}"
  puts addressing_line(chapter, command.references) if command.references
  puts closed_set_note(verb_text) if CLOSED_SET_VERBS.include?(verb_text)
  puts READ_MODEL_NOTE if verb_text == "Bluebook::ReadModel.Declare"
  command.attributes.each { |attribute| puts shape_line(chapter, aggregate, attribute) }
end

# A REAL CONSTRAINT, NOT A GUESS — traced through
# `read_model_interpreter.rb`'s own `args.fetch(model.reference_name)`
# (no default) before building this. A read model joins several
# aggregates around ONE root, queried by that root's own id — there is
# no "give me every row" mode, no matter how the `where`/`order_by`
# options declared on it are shaped; those only ever scope the "many"
# side WITHIN one root's own projection. `PackingItem.all` (the plain
# aggregate door, free, no declaration needed) is what "every row"
# actually means here — enumerate with that, then ask the read model
# once per id for the joined fact.
READ_MODEL_NOTE = "  A READ MODEL ANSWERS ONE ROOT AT A TIME, not \"all\" — " \
                   "call it once per id (from the root aggregate's own .all), never in bulk."

# WHAT `--arg "id::..."` HAS TO SPELL, when a command ACTS ON an
# existing record rather than creating one — `command.references`
# names the category (`"ValueObject"`, `"Aggregate"`, ...); every
# category's own `id` is `Naming.identity(identity_paths)`, a
# colon-join of its declared identity parts IN ORDER
# (`Runtime::Identity.of`, the exact function a real dispatch calls to
# address the same record). Spelling that join out here is what used
# to mean grepping `lib/hecksagain/language/bluebook/*.bluebook` by
# hand for one `identified_by` block.
#
# A WORKED EXAMPLE, NOT JUST THE FORMULA — `bluebook_id + ":" +
# name.value` tells you the SHAPE but not what to actually type; typing
# the wrong composite id by hand (wrong part order, a forgotten level)
# was a real mistake made mid-interview and only caught by a refusal
# several steps later. `<bluebook_id>:<name>` is the same formula with
# each part's own head named instead of spelled abstractly — copy the
# angle-bracket placeholders out and fill them in.
def addressing_line(chapter, references)
  target = chapter.aggregate(references)
  return "  addresses #{references} — identity unknown (not declared in #{chapter.name})" unless target

  parts = target.identity_paths.empty? ? ["id"] : target.identity_paths
  example = parts.map { |path| "<#{path.to_s.split('.').first}>" }.join(":")
  "  addresses #{paint(references, :yellow)} — id = #{parts.join(' + ":" + ')}  (e.g. #{example})"
end

# THE FULL CLOSED-SET SEQUENCE, discovered the hard way mid-interview:
# `Member.Declare` alone renders an EMPTY `value_object` block — no
# refusal at propose time, only a crash once the domain actually loads.
# All five verbs below print this note, so whichever one you reach for
# first is the one that tells you what else it needs.
CLOSED_SET_VERBS = %w[
  Bluebook::ValueObject.Declare Bluebook::ValueObject.Field
  Bluebook::Member.Declare Bluebook::Member.Pair Bluebook::ValueObject.Close
].freeze

def closed_set_note(_verb_text)
  paint("  A CLOSED SET NEEDS ALL FIVE, not just this one:", :dim) + "\n" +
    paint("    ValueObject.Declare  — the value object's own root\n" \
          "    ValueObject.Field    — its field (almost always name: value, type: String)\n" \
          "    Member.Declare       — one call per admitted row, each with its own position (0, 1, 2, ...)\n" \
          "    Member.Pair          — one call per row: key: value, value: <the actual text>\n" \
          "    ValueObject.Close    — rows: <count>, the count of Member rows above", :dim)
end

def shape_line(chapter, aggregate, attribute)
  required = attribute.optional? ? "optional" : "required"
  return "  #{attribute.name.to_s.ljust(14)} reference -> #{attribute.type.target_name.ljust(20)} #{required}   " \
         "--arg \"#{attribute.name}::<id>\"" if attribute.reference?

  value_object = aggregate.value_object(attribute.type) || chapter.aggregates.filter_map { |a| a.value_object(attribute.type) }.first
  return "  #{attribute.name.to_s.ljust(14)} #{attribute.type.to_s.ljust(20)} #{required}   " \
         "(unknown shape — not declared anywhere in #{chapter.name}; try field 'value')" unless value_object

  value_object.attributes.map do |field|
    "  #{attribute.name.to_s.ljust(14)} #{attribute.type}{#{field.name}: #{field.type}}".ljust(48) +
      " #{required}   --arg \"#{attribute.name}:#{field.name}:<#{field.type}>\""
  end.join("\n")
end

# ── smoke-dispatching a real, rendered domain ──────────────────────────
#
# TWO SEPARATE BOOTS, ON PURPOSE. A plain `Runtime::Registry` (the same
# preamble `Writer.verify!` already uses) is for READING the domain's
# own shape — aggregates, commands, references, read models — real
# `IR` objects, not a second hand-parsed index. `Router.boot` is a
# SEPARATE process entirely, for the actual realm-addressed dispatch
# (`Development::Chapter::Aggregate.Command`) — the same door a real
# app calls through, proven live in this build (`Router.boot` is what
# exposes a report's own query method at all; the plain aggregate door
# never does). Neither one is asked to do the other's job.
def run_smoke_test(declaration)
  Dir.mktmpdir do |dir|
    write_smoke_domain(dir, declaration)

    registry = Hecksagain::Runtime::Registry.new
    Hecksagain.with_registry(registry) do
      Kernel.load(File.join(ROOT, "lib/hecksagain/ports/persistence.port"))
      Kernel.load(File.join(ROOT, "lib/hecksagain/ports/extraction.port"))
      Kernel.load(File.join(ROOT, "lib/hecksagain/adapters/driven/memory.adapter"))
      Kernel.load(File.join(ROOT, "lib/hecksagain/adapters/driven/prism.adapter"))
      Kernel.load(File.join(dir, "bluebook", "#{Hecksagain::Naming.snake(declaration[:name])}.bluebook"))
    end
    chapter_ir = registry.bluebook(declaration[:name])

    router = Hecksagain::Router.boot(dir)
    realm  = "Development" # Writer#world_text's own fixed realm — this is smoke-testing THAT rendered file
    prefix = "#{realm}::#{declaration[:name]}"

    created  = {}
    failures = []

    chapter_ir.aggregates.each do |aggregate_ir|
      creating, noncreating = aggregate_ir.commands.partition(&:creates?)

      creating.each do |command_ir|
        args = synth_args(chapter_ir, aggregate_ir, command_ir, created)
        begin
          result = router.dispatch("#{prefix}::#{aggregate_ir.name}.#{command_ir.hecks_name}", **args)
          created[aggregate_ir.name] = result.instance.id
        rescue StandardError => e
          failures << "#{aggregate_ir.name}.#{command_ir.hecks_name}: #{e.class}: #{e.message}"
          next
        end

        noncreating.each do |nc_command|
          nc_args = synth_args(chapter_ir, aggregate_ir, nc_command, created).merge(id: created[aggregate_ir.name])
          router.dispatch("#{prefix}::#{aggregate_ir.name}.#{nc_command.hecks_name}", **nc_args)
        rescue StandardError => e
          failures << "#{aggregate_ir.name}.#{nc_command.hecks_name}: #{e.class}: #{e.message}"
        end
      end
    end

    chapter_ir.read_models.each do |model|
      root_id = created[model.reference_target]
      next unless root_id # nothing was created for this root — nothing to smoke-test yet, not a failure

      router.query("#{prefix}.#{model.query_name}", model.reference_name => root_id)
    rescue StandardError => e
      failures << "report #{model.name}: #{e.class}: #{e.message}"
    end

    if failures.empty?
      puts paint("smoke test passed — every declared command and report dispatched cleanly", :green)
    else
      puts paint("SMOKE TEST FOUND #{failures.size} PROBLEM(S):", :red)
      failures.each { |f| puts "  #{f}" }
    end
  end
end

def write_smoke_domain(dir, declaration)
  FileUtils.mkdir_p(File.join(dir, "bluebook"))
  storage = Hecksagain::Naming.snake(declaration[:name])
  File.write(File.join(dir, "bluebook", "#{storage}.bluebook"), Hecksagain::Interview::Source.render(declaration))
  File.write(File.join(dir, "bluebook", "#{storage}.hecksagon"), Hecksagain::Interview::Writer.hecksagon_text(declaration))
  File.write(File.join(dir, "bluebook", "#{storage}.world"), Hecksagain::Interview::Writer.world_text(declaration))
end

# ONE SYNTHESIZED ARGUMENT PER DECLARED ATTRIBUTE — never a random
# guess. A String becomes a fixed marker; an Integer becomes 0; a
# closed set uses ITS OWN first admitted member (never a value a
# real `one_of` would legitimately refuse); a reference uses the real
# id smoke-dispatch already minted for that target earlier in the SAME
# run — `chapter_ir.aggregates` walks in declaration order for exactly
# this reason, so whatever TripItem's own shape needs from PackingItem
# already exists by the time TripItem's own turn comes.
def synth_args(chapter, aggregate, command, created)
  command.attributes.to_h do |attribute|
    if attribute.reference?
      [attribute.name, created.fetch(attribute.type.target_name, "smoke-test-id")]
    else
      [attribute.name, synth_value(chapter, aggregate, attribute.type)]
    end
  end
end

def synth_value(chapter, aggregate, type_name)
  value_object = aggregate.value_object(type_name) || chapter.aggregates.filter_map { |a| a.value_object(type_name) }.first
  return "smoke-test" unless value_object

  return value_object.members.first.to_h if value_object.respond_to?(:closed_set?) && value_object.closed_set? && value_object.members.any?

  value_object.attributes.to_h { |field| [field.name, synth_scalar(field.type)] }
end

def synth_scalar(primitive)
  case primitive.to_s
  when "Integer" then 0
  when "Float" then 0.0
  when "TrueClass", "FalseClass" then false
  else "smoke-test"
  end
end

# ── argument parsing ─────────────────────────────────────────────────

def flag(name, default = nil)
  idx = ARGV.index(name)
  return default unless idx

  ARGV.delete_at(idx)
  ARGV.delete_at(idx)
end

at = flag("--at")
command = ARGV.shift or abort "usage: bin/interview <open|state|gaps|ask|answer|establish|propose|accept> ..."

RUNTIME = boot_interview_domain(at: at)

case command
# ── creating commands: module-level door calls, confirmed against a
#    live domain throughout this build (Interview.open, Finding.establish,
#    Proposal.propose all mint their own identity from their own args) ──
when "open"
  chapter    = ARGV.shift or abort "usage: bin/interview open <Chapter> --subject ... --respondent ..."
  subject    = flag("--subject") or abort "--subject is required"
  respondent = flag("--respondent") or abort "--respondent is required"
  session_ref = flag("--session") || "#{chapter}-#{Process.pid}"

  Interview::Interview.open(session: { value: session_ref }, subject: { value: subject },
                             chapter: { value: chapter }, respondent: { value: respondent })
  puts "opened #{paint(session_ref, :green)} against #{chapter}"

# THE CATALOGUE — NOT CHAPTER-SCOPED, on purpose: a standing question is
# "the practice always asks," independent of any one session, so
# neither takes a `<Chapter>` argument. Built now because `Draft`/
# `Publish`/`Retire` were real commands in the domain from the very
# first task of this build and `bin/interview` never once exposed a
# way to reach them — the reason `--source catalogue` never got used
# all session was not that the catalogue wasn't worth it; it was that
# there was no door to it at all.
when "draft"
  slug   = ARGV.shift or abort 'usage: bin/interview draft <slug> --topic T --why "..." "prompt text"'
  topic  = flag("--topic", "general")
  why    = flag("--why") or abort "--why is required — a standing question earns its place by saying why it matters"
  prompt = ARGV.shift or abort "a standing question needs its own prompt text"

  Interview::StandingQuestion.draft(slug: { value: slug }, prompt: { value: prompt },
                                     topic: { value: topic }, why: { value: why })
  puts "drafted #{paint(slug, :green)}: #{prompt}"

when "publish"
  slug = ARGV.shift or abort "usage: bin/interview publish <slug>"

  RUNTIME.dispatch("Interview::StandingQuestion.Publish", slug: { value: slug })
  puts "published #{paint(slug, :green)} — citable now via `ask ... --source catalogue --ref #{slug}`"

when "state"
  chapter = ARGV.shift or abort "usage: bin/interview state <Chapter>"
  render_state(chapter)

when "gaps"
  chapter = ARGV.shift or abort "usage: bin/interview gaps <Chapter>"
  render_gaps(rebuild(chapter))

when "shape"
  verb = ARGV.shift or abort 'usage: bin/interview shape "Bluebook::Aggregate.Declare"'
  render_shape(verb)

# THE SAME RENDER-AND-RELOAD `save` ALREADY VERIFIES BEFORE WRITING —
# `Writer.verify!` — run standalone, on demand, nothing written. Built
# because of a real gap this exact interview hit: three mistakes
# dispatched cleanly (no refusal at accept time) and only broke at
# `save`, by which point they were permanently WRITTEN and needed hand
# edits to the rendered file — see `Proposal::Correct`'s own comment.
# This catches the ONE class of those three that's checkable without
# actually dispatching a command against the rendered domain — a
# construct the renderer/reloader disagree about, the way the closed-set
# bug here did (a `value_object` that rendered with no fields at all).
# It will NOT catch the other two — a lifecycle field colliding with an
# explicit attribute of the same name, or a non-creating command missing
# `Command.ActsOn` — because both only surface once something is
# actually DISPATCHED against the loaded domain, not merely reloaded.
# Named honestly rather than oversold: run this often, but `save` and a
# real smoke dispatch are still the only complete proof.
when "check"
  chapter = ARGV.shift or abort "usage: bin/interview check <Chapter>"
  session = rebuild(chapter)

  begin
    Hecksagain::Interview::Writer.verify!(Hecksagain::Interview::Source.render(session.declaration), session.declaration)
    puts paint("check passed — the rendered text reloads to exactly what it was rendered from", :green)
  rescue Hecksagain::Bluebook::DSL::Malformed => e
    abort "not well-formed yet — #{e.message}\n(run `bin/interview gaps #{chapter}` to see what's still open)"
  rescue Hecksagain::Interview::Writer::Unfaithful => e
    abort "#{paint('CHECK FAILED', :red)} — #{e.message}"
  end

# THE ONE GAP `check` NAMES BUT CANNOT CLOSE — a construct can be
# declared PERFECTLY (reloads clean, `check` passes) and still be
# WRONG the moment anything actually dispatches against it. Three real
# bugs this build hit were exactly that shape: a lifecycle field
# colliding with an explicit attribute, a non-creating command with no
# `Command.ActsOn`, a report whose join returned nothing back. None of
# those is a reload disagreement — `check` is silent on all three.
# `smoke` boots the rendered domain for real (Memory-bound, a
# throwaway temp dir, nothing written to the real save target) and
# DISPATCHES — one synthesized call per declared command, one call per
# declared report, per created root — catching whatever a real
# conversation would eventually catch anyway, just now instead of
# later.
when "smoke"
  chapter = ARGV.shift or abort "usage: bin/interview smoke <Chapter>"
  session = rebuild(chapter)
  run_smoke_test(session.declaration)

# ── non-creating AGGREGATE commands: `.find(id).verb(...)`, the Handle
#    chaining `Pizza.create_pizza(...).add_topping(...)` proves ──
when "ask"
  chapter = ARGV.shift or abort "usage: bin/interview ask <Chapter> \"question\" [--topic T] [--source S] [--ref REF]"
  text    = ARGV.shift or abort "a question needs text"
  topic   = flag("--topic", "general")
  source  = flag("--source", "judgment")
  ref     = flag("--ref", "")
  session_ref = current_session_ref(chapter)

  Interview::Interview.find(session_ref).ask(text: { value: text }, source: { value: source },
                                              topic: { value: topic }, catalogue_ref: { value: ref })
  puts "asked (#{source}, #{topic}): #{text}"

# ── an ENTITY command: no Handle chaining sugar exists for these (every
#    real example in the corpus — SafeDepositBox's Visit/KeyIssuance —
#    dispatches them raw, dotted verb, parent identity alongside the
#    entity's own), so this goes straight through RUNTIME.dispatch too ──
when "answer"
  chapter  = ARGV.shift or abort "usage: bin/interview answer <Chapter> <sequence> \"answer\""
  sequence = ARGV.shift or abort "which question?"
  text     = ARGV.shift or abort "an answer needs text"
  session_ref = current_session_ref(chapter)

  RUNTIME.dispatch("Interview::Interview.Question.Answer", session: { value: session_ref },
                    sequence: { value: sequence.to_i }, answer: { value: text })
  puts "answered ##{sequence}: #{text}"

when "establish"
  chapter = ARGV.shift or abort "usage: bin/interview establish <Chapter> --ref F1 --topic T \"statement\""
  ref     = flag("--ref") or abort "--ref is required"
  topic   = flag("--topic", "general")
  # FLAGS EXTRACTED BEFORE THIS SHIFT, on purpose — `flag` only removes a
  # `--name value` pair when it finds one; shifting the trailing
  # positional (the statement text) first would grab a `--ref`/`--topic`
  # token instead, whichever happened to still be at ARGV's front. Bit
  # here once already, while first testing this file end to end.
  statement = ARGV.shift or abort "a finding needs a statement"
  session_ref = current_session_ref(chapter)
  sequence  = query("Interview::Finding.ByTopic", topic: { value: topic }).size + 1

  Interview::Finding.establish(interview_id: session_ref, reference: { value: ref }, sequence: { value: sequence },
                                topic: { value: topic }, statement: { value: statement })
  puts "established #{paint(ref, :green)}: #{statement}"

# WHAT `propose`+`accept` WOULD DO, WITHOUT DOING IT — no Proposal
# record, nothing written to `.interview`, nothing appended anywhere.
# `session.offer` dispatches into the SAME throwaway rebuilt meta-domain
# `gaps`/`state` already read from — this process exits the moment the
# command returns, so there is nothing left to leak. Built because
# every proposal this whole build went straight to `propose`, full
# ceremony (`--ref`, `--finding`, a rationale), and a wrong guess (the
# wrong verb, a mistyped composite id) meant a written mistake needing
# `correct` afterward. `preview` is the same one call, with none of
# that cost if it's wrong.
when "preview"
  chapter = ARGV.shift or abort "usage: bin/interview preview <Chapter> --verb VERB [--arg name:field:value ...]"
  verb    = flag("--verb") or abort "--verb is required"
  arguments = []
  while (raw = flag("--arg"))
    name, field, value = raw.split(":", 3)
    arguments << { name: name, field: field.to_s, value: value.to_s }
  end

  begin
    lowered_verb, args = Hecksagain::Interview::Lowering.new.lower(verb, arguments)
    verdict = rebuild(chapter).offer(lowered_verb, **args)
    if verdict.accepted?
      puts "#{paint('WOULD WRITE', :green)}  #{lowered_verb}"
    else
      puts "#{paint('WOULD REFUSE', :red)}  #{lowered_verb}\n  #{verdict.refusal}"
      puts "  (#{verdict.wants} — declare what's missing first, then preview again)" if verdict.wants == :prerequisite
    end
  rescue Hecksagain::Interview::Lowering::MalformedProposal => e
    abort "malformed — #{e.message}"
  end

when "propose"
  chapter = ARGV.shift or abort "usage: bin/interview propose <Chapter> --ref P1 --finding F1 --verb VERB \"rationale\""
  ref     = flag("--ref") or abort "--ref is required"
  finding = flag("--finding") or abort "--finding is required"
  verb    = flag("--verb") or abort "--verb is required"
  # `--arg` extracted in the loop below, AFTER `rationale` is shifted —
  # same reason `establish` extracts its flags before its own trailing
  # positional: a shift must never run while a `--flag` token could
  # still be sitting at ARGV's front.
  rationale = ARGV.shift or abort "a proposal needs a rationale"
  session_ref = current_session_ref(chapter)
  sequence = query("Interview::Proposal.Pending", interview_id: { value: session_ref }).size + 1

  proposal = Interview::Proposal.propose(interview_id: session_ref, finding_id: finding, reference: { value: ref },
                                          sequence: { value: sequence }, verb: { value: verb },
                                          rationale: { value: rationale })

  while (raw = flag("--arg"))
    name, field, value = raw.split(":", 3)
    proposal = proposal.supply(name: { value: name }, field: { value: field.to_s }, value: { value: value.to_s })
  end
  puts "proposed #{paint(ref, :green)}: #{verb} — #{rationale}"

when "accept"
  chapter = ARGV.shift or abort "usage: bin/interview accept <Chapter> <proposal-ref>"
  ref     = ARGV.shift or abort "which proposal?"

  proposal = Interview::Proposal.find(ref) or abort "no proposal #{ref.inspect}"
  proposal = proposal.accept

  session = rebuild(chapter) # every ALREADY-written proposal; not yet including this one
  lowering = Hecksagain::Interview::Lowering.new
  verb, args = lowering.lower(proposal.verb.value, proposal.arguments.map(&:to_h))
  verdict = session.offer(verb, **args)

  if verdict.accepted?
    proposal.written
    puts "#{paint('WRITTEN', :green)}  #{verb}"
  else
    proposal.refused(refusal: { value: verdict.refusal })
    puts "#{paint('REFUSED', :red)}  #{verb}\n  #{verdict.refusal}"
    puts "  (#{verdict.wants} — declare what's missing, then propose this again)" if verdict.wants == :prerequisite
  end

# A WRITTEN MISTAKE, NOT A REFUSAL — the meta-domain took it, and only
# later (a save, a real boot) did it turn out to be wrong. `written` is a
# true terminal for `accept`/`reject`/`supersede`, by design (see
# interview.bluebook's own comment) — this is the one, narrow exception:
# the record stays exactly as written, forever; only `rebuild` (and so
# `save`) stop replaying it. Fixing what it got wrong is a NEW proposal,
# same as everything else — `correct` only says "don't count this one."
when "correct"
  chapter = ARGV.shift or abort "usage: bin/interview correct <Chapter> <proposal-ref> \"why it was wrong\""
  ref     = ARGV.shift or abort "which proposal?"
  reason  = ARGV.shift or abort "say why — this stays in the record"

  proposal = Interview::Proposal.find(ref) or abort "no proposal #{ref.inspect}"
  proposal.correct(reason: { value: reason })
  puts "#{paint('CORRECTED', :yellow)}  #{ref} — excluded from replay from here on"

# ── writing it out for real ─────────────────────────────────────────

when "save"
  chapter = ARGV.shift or abort "usage: bin/interview save <Chapter> --to <dir>"
  to      = flag("--to") or abort "--to <dir> is required — save writes a whole bootable domain directory there"

  begin
    session = rebuild(chapter)
    path = Hecksagain::Interview::Writer.save!(session.declaration, to: to)
    puts "#{paint('WROTE', :green)} #{path}"
    puts "boots as-is: Hecks.boot(#{to.inspect})"
  rescue Hecksagain::Bluebook::DSL::Malformed => e
    abort "not well-formed yet — #{e.message}\n(run `bin/interview gaps #{chapter}` to see what's still open)"
  rescue Hecksagain::Interview::Writer::Drifted => e
    abort e.message
  end

# ── the agent port, headless-only — see the file header ─────────────

when "suggest"
  chapter = ARGV.shift or abort "usage: bin/interview suggest <Chapter> --kind KIND \"meaning\" [--near X,Y]"
  kind    = flag("--kind") or abort "--kind is required (aggregate, command, event, value_object, ...)"
  near    = flag("--near", "").split(",").map(&:strip).reject(&:empty?)
  meaning = ARGV.shift or abort "what does it mean? give a short phrase"

  begin
    suggestions = Hecksagain::Ports::Agent.suggest_name(RUNTIME.registry, meaning: meaning, kind: kind, near: near)
    suggestions.each do |s|
      puts paint(s.name, :blue) + "  —  #{s.because}"
      puts "  (passed over: #{s.rejected.join(', ')})" unless s.rejected.empty?
    end
  rescue Hecksagain::Runtime::WiringError, Hecksagain::Ports::Agent::Unavailable,
         Hecksagain::Ports::Agent::ValidationError => e
    abort "#{paint('no suggestion', :red)} — #{e.message}"
  end

when "critique"
  chapter = ARGV.shift or abort "usage: bin/interview critique <Chapter>"
  session = rebuild(chapter)

  begin
    findings = Hecksagain::Ports::Agent.critique(RUNTIME.registry, declared: session.declaration, refusals: [],
                                                  findings: session.gaps.map(&:to_s))
    if findings.empty?
      puts paint("no critique — nothing stood out", :green)
    else
      findings.each { |f| puts f.to_s }
    end
  rescue Hecksagain::Runtime::WiringError, Hecksagain::Ports::Agent::Unavailable,
         Hecksagain::Ports::Agent::ValidationError => e
    abort "#{paint('no critique', :red)} — #{e.message}"
  end

else
  abort "unknown command #{command.inspect}"
end
