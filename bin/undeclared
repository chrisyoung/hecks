#!/usr/bin/env ruby

# WHAT THE TWO RUNTIMES AGREE ON THAT NOTHING DECLARES.
#
# bin/parity proves the two runtimes answer alike. It cannot say WHY. Every bug
# found this week hid in that gap : they agreed about composite rendering until a
# hash reached a message, agreed about `gt` because neither had implemented it,
# agreed about row order until two rows tied. Agreement is not correctness, and
# agreement nobody declared is agreement by luck.
#
# So this perturbs a DECLARATION and watches what the runtimes do. Both parse a
# domain's bluebook, which is what makes the experiment possible at all — the
# language chapter would not work here, since Rust never reads it.
#
#   both changed, and alike  -> the declaration is load-bearing and shared. Good.
#   neither changed          -> DECORATIVE : the behaviour lives in the runtimes,
#                               or the corpus never asks. Both are findings.
#   changed differently      -> DUPLICATED : each runtime holds its own copy, and
#                               they only agreed while the copies matched.
#
# A survivor is not automatically a bug. It is a question with exactly two
# answers, and both are worth having.

require "fileutils"
require "tmpdir"
require "open3"
require "digest"

ROOT = File.expand_path("..", __dir__)

# Each mutation deletes or flips ONE declared thing, on one line, so the mutant
# is still a readable bluebook and the finding names a line rather than a diff.
MUTATIONS = [
  { name: "drop a one_of member",   pattern: /^\s*member\s/,        change: :delete },
  { name: "drop an order_by",       pattern: /^\s*order_by\s/,      change: :delete },
  { name: "drop an identified_by",  pattern: /^\s*identified_by\s/, change: :delete },
  { name: "drop an invariant",      pattern: /^\s*invariant\(/,     change: :delete },
  { name: "drop a limit",           pattern: /^\s*limit\s/,         change: :delete },
  { name: "flip a where comparator", pattern: /\b(lt|gt|lte|gte):/,  change: :flip }
].freeze

FLIPS = { "lt" => "gt", "gt" => "lt", "lte" => "gte", "gte" => "lte" }.freeze

def bluebook_in(domain)
  Dir.glob(File.join(domain, "bluebook", "*.bluebook")).first ||
    Dir.glob(File.join(domain, "*.bluebook")).first
end

# The answer both runtimes gave, as one comparable thing. bin/parity exits
# nonzero when they disagree ; when they agree, Ruby's own output IS the answer,
# so its digest says whether the mutation changed anything at all.
# bin/parity exits nonzero for TWO different reasons, and conflating them turns
# every load-bearing declaration into a false finding : the runtimes genuinely
# disagreeing, and the corpus's own expectations no longer being met. The second
# is what SHOULD happen when a guard is deleted — it is the corpus noticing, and
# it is proof the declaration carries weight. Only the first is a finding.
# THROUGH ONE ADAPTER, NAMED. Perturbing a declaration asks whether the two
# RUNTIMES still agree, which the store does not bear on — and this runs once per
# perturbation, 54 of them for banking, so the second adapter cost about 75
# seconds a run for nothing.
#
# Naming it also makes the answer file below DELIBERATE. It used to glob every
# variant and take `.sort.first`, which happened to select heki because 'h' sorts
# before 's' — correct by alphabet rather than by intent.
PARITY_ADAPTER = "Heki".freeze

def outcome(domain, script)
  output, status = Open3.capture2e(File.join(ROOT, "bin/parity"), domain, script, PARITY_ADAPTER)
  name = File.basename(domain)
  answer = "/tmp/parity.output.#{name}.#{PARITY_ADAPTER.downcase}.ruby.json"

  return [:split, nil] if output.include?("SPLIT")
  return [:noticed, nil] unless status.success?
  return [:unreadable, nil] unless answer && File.exist?(answer)

  [:agreed, Digest::SHA256.hexdigest(File.read(answer))]
end

def mutants_of(source)
  lines = File.readlines(source)
  found = []

  lines.each_with_index do |line, index|
    MUTATIONS.each do |mutation|
      next unless line.match?(mutation[:pattern])

      mutated = lines.dup
      case mutation[:change]
      when :delete then mutated.delete_at(index)
      when :flip   then mutated[index] = line.sub(/\b(lt|gt|lte|gte):/) { "#{FLIPS[Regexp.last_match(1)]}:" }
      end
      found << { line: index + 1, what: mutation[:name], text: line.strip, source: mutated.join }
    end
  end

  found
end

def examine(domain, script)
  name = File.basename(domain)
  puts "── #{name}"

  source = bluebook_in(domain)
  return puts("   NO BLUEBOOK in #{domain}") unless source

  baseline_verdict, baseline = outcome(domain, script)
  unless baseline_verdict == :agreed
    puts "   the corpus does not agree before any mutation — fix that first"
    return false
  end

  decorative = []
  duplicated = []
  held       = 0

  mutants_of(source).each do |mutant|
    original = File.read(source)
    begin
      File.write(source, mutant[:source])
      verdict, answer = outcome(domain, script)
    ensure
      File.write(source, original)
    end

    case verdict
    when :split   then duplicated << mutant
    when :noticed then held += 1
    when :agreed  then answer == baseline ? decorative << mutant : held += 1
    end
  end

  report(name, held, decorative, duplicated)
end

def report(name, held, decorative, duplicated)
  total = held + decorative.length + duplicated.length
  puts "   #{total} declarations perturbed — #{held} load-bearing, " \
       "#{decorative.length} changed nothing, #{duplicated.length} split the runtimes"

  unless duplicated.empty?
    puts
    puts "   MASKING A DIVERGENCE — what happens WITHOUT this declaration is held separately by each runtime, so the declaration is the only reason they agree:"
    duplicated.each { |m| puts "     #{name}.bluebook:#{m[:line]}  #{m[:what]}  —  #{m[:text]}" }
  end

  unless decorative.empty?
    puts
    puts "   CHANGED NOTHING — either the runtimes hold this themselves, or the corpus never asks:"
    decorative.each { |m| puts "     #{name}.bluebook:#{m[:line]}  #{m[:what]}  —  #{m[:text]}" }
  end

  puts
  duplicated.empty?
end

domain_arg = ARGV.shift
domains = domain_arg ? [domain_arg.chomp("/")] : Dir.glob("#{ROOT}/examples/*/").map { |d| d.chomp("/") }

ok = domains.reduce(true) do |all_ok, domain|
  script = File.join(ROOT, "spec/parity/#{File.basename(domain)}.json")
  next all_ok unless File.exist?(script)

  examine(domain, script) && all_ok
end

puts ok ? "No declaration splits the runtimes." : "A DECLARATION IS HELD TWICE."
exit(ok ? 0 : 1)
