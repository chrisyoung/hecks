#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

domain = ARGV.fetch(0)
exit 0 unless Dir.exist?(domain)

runtime = Hecks.boot(domain)
registry = runtime.registry

lines = registry.bluebooks.flat_map do |name, bluebook|
  bluebook.aggregates.map do |aggregate|
    "#{aggregate.storage_name} #{registry.repository(name, aggregate).count}"
  end
end

puts lines.sort.join("\n")
