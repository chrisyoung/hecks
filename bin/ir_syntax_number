#!/usr/bin/env ruby

# WHICH NAMED ARGUMENTS ARE NUMBER — projected into Rust source, the same
# shape bin/ir_syntax_flags/bin/ir_syntax_text established, one kind further.
#
# `language/bluebook/syntax.bluebook` already declares this: `Syntax::Argument`
# holds a `kind` per row, and `"number"` means "a bare numeric word".
# `max_age:`/`timeout:` both read through `extract_word_after` — the same
# generic bare-word extractor `symbol`-kind arguments use, since Rust holds
# neither as a typed integer today (ConsistencySpec/FreshnessSpec keep them
# as Option<String>). This generates an ASSERTION each call site checks
# itself against (`assert_number_kwarg`, parse_blocks.rs), the discipline
# `parse_flag_kwarg` already holds flag-kind arguments to — it does not add
# numeric parsing, which is a separate, larger change to what these fields
# hold, not to whether the reader and the declaration agree about kind.
#
# Regenerate with:
#
#   bin/ir_syntax_number > rust/src/bluebook/ir_syntax_number.rs
#
# spec/ir_syntax_number_export_spec.rb holds the checked-in file equal to
# this script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

syntax = Hecksagain::Bluebook::MetaValidator
         .grammar_registry.bluebook("Bluebook").aggregate("Syntax")

argument = syntax.value_object("Argument") or raise "the language declares no Syntax::Argument to project"

def number_argument_names(argument)
  rows = argument.members
                 .map(&:to_h)
                 # A proposed or retired argument reaches no projected table —
                 # to a projected reader it does not exist. Deprecated reads.
                 .reject { |row| %w[proposed retired].include?(row[:status].to_s) }
                 .select { |row| row.fetch(:kind) == "number" }
                 .reject { |row| row.fetch(:named).to_s.empty? }
                 .uniq { |row| row.fetch(:named) }
                 .sort_by { |row| row.fetch(:named) }

  raise "Syntax::Argument admits no argument of kind \"number\"" if rows.empty?

  rows.map { |row| row.fetch(:named) }
end

names = number_argument_names(argument)
entries = names.map { |n| "    \"#{n}\",\n" }.join

puts <<~RUST
  // GENERATED BY bin/ir_syntax_number — DO NOT EDIT BY HAND.
  //
  // Every named argument the language declares as kind "number" — a bare
  // numeric word.
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook
  // Regenerate: bin/ir_syntax_number > rust/src/bluebook/ir_syntax_number.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_syntax_number_export_spec.rb. Checked at every call by
  // assert_number_kwarg itself (parse_blocks.rs) — a kwarg name reaching
  // that assertion which this table does not list is a reader/declaration
  // mismatch, not a missing feature.

  pub const NUMBER_ARGUMENTS: &[&str] = &[
  #{entries}];
RUST
