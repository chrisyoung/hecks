#!/usr/bin/env ruby

# Generates the two capability enums the hand-written Rust kernel
# (rust/src/kernel/attribute_shapes/*.rs, rust/src/kernel/
# expression_operators/*.rs) is matched against — read this alongside
# bin/project_rust's own header, which generates the DOMAIN-SPECIFIC
# side of the same crate from a bluebook's canonical IR. This generates
# the LANGUAGE-LEVEL side: not "what commands does Pizzas declare" but
# "what attribute shapes and expression operators does the Ruby grammar
# itself admit, that every generated domain's hand-written kernel floor
# has to interpret correctly no matter which domain is compiled in."
#
# Two ground truths, read rather than restated, exactly the way
# bin/project_rust's own header insists on for the domain side:
#
#   attribute shapes  <- Hecksagain::Runtime::Value::Coercion::SHAPES
#                        (lib/hecksagain/runtime/value/coercion.rb) — the
#                        four branches `for_attribute` itself takes, named
#                        once, right where the branching happens.
#
#   expression operators <- Hecksagain::Grammar.admitted_operators, the
#                        SAME live-booted call bin/expression_projection
#                        uses to write lib/hecksagain/bluebook/expression/
#                        projection.json — replaying the real admission
#                        ledger through the real Expression chapter, never
#                        a hand-copied list. Grouped by `category`, the
#                        field Evaluator::PROJECTION already partitions
#                        comparison operators by (evaluator.rb:26) — this
#                        script reuses the same field for the coarser,
#                        per-INTERPRETER-NODE grouping the kernel actually
#                        branches on (six comparison symbols collapse to
#                        one `Compare` node, three sign-test symbols to
#                        one `SignTest` node — see expr.rs).
#
# WRITES rust/src/kernel/attribute_shapes/mod.rs and rust/src/kernel/
# expression_operators/mod.rs — the `pub mod <name>;` lines AND the enum,
# together, on purpose: the individual `<name>.rs` files under each
# directory are HAND-WRITTEN interpretation logic (this script never
# touches them), but the roster of which names must exist is grammar-
# derived, so regenerating after a grammar change can point `pub mod` at
# a file nobody has written yet — a plain "unresolved module" compile
# error, the same class of guarantee the enum's own exhaustive match
# sites give once a human closes the gap by adding the file
# (bin/rust_kernel_coverage checks for exactly that file, mechanically).
#
# A THIRD, DIFFERENTLY-SHAPED CAPABILITY IS WRITTEN TOO, and it earns its
# own paragraph because it does NOT follow the two-part contract above.
# `Hecksagain::QuerySpecification::Common::COMPARATORS` (lib/hecksagain/
# query_specification/common/comparators.rb) — `eq`/`ne`/`gt`/`gte`/`lt`/
# `lte`/`in`/`contains`, the same eight names `Vocabulary::QueryComparator`
# (language/bluebook/vocabulary.bluebook) declares and a where-clause's
# `op:` is checked against (`admits: "Vocabulary::QueryComparator"`) — is
# every bit as real and closed a set as the two above. What is missing is
# not a generator gap; it is that NOTHING IN THE KERNEL DISPATCHES OVER IT
# AT ALL. `rust/src/kernel/cli.rs` refuses every query step outright
# ("query steps are not generated yet" — bin/rust_coverage's own
# documented "whole_kind" gap, read there for the full story), so there is
# no `match` site anywhere for a `QueryComparator` variant to route
# through, and therefore no honest `<name>.rs` file to write: forcing one
# into existence would describe interpretation logic that plain does not
# exist yet, the opposite of what every other file in attribute_shapes/
# and expression_operators/ actually is. `emit_gap_enum`, below, writes
# the enum ANYWAY — bare, undispatched, `#[allow(dead_code)]`, no `pub
# mod` lines, no accompanying files — so the eight NAMES are tracked
# now, in the one place a future query-engine author will already be
# looking, rather than staying undiscoverable until that day. See its own
# generated header for the rest of this reasoning, repeated where a
# reader of the OUTPUT (not this generator) will actually see it.
#
#   bin/project_kernel_capabilities

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/grammar"
require "hecksagain/runtime/value/coercion"
require "hecksagain/query_specification/common/comparators"
require "fileutils"
require "tempfile"

ROOT = File.expand_path("..", __dir__)

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# snake_case grammar/Ruby name -> PascalCase Rust variant name. Plain
# ASCII splitting on "_" — every name this ever sees (SHAPES' own
# symbols, Grammar's own `category` strings) is already a simple
# lowercase/underscore token, never anything richer.
def pascal(name)
  name.to_s.split("_").map { |part| part[0].upcase + part[1..] }.join
end

def emit_mod(target, header:, enum_name:, names:, doc_line:)
  variants = names.map { |name| "    #{pascal(name)}," }.join("\n")
  mods     = names.map { |name| "pub mod #{name};" }.join("\n")

  content = <<~RUST
    // GENERATED by bin/project_kernel_capabilities from #{doc_line}.
    // Do not hand-edit — re-run bin/project_kernel_capabilities instead.
    //
    #{header}

    #{mods}

    /// One variant per real #{enum_name == "AttributeShape" ? "attribute shape" : "expression-operator category"} the Ruby
    /// grammar admits, in the order #{doc_line} declares them. Every match
    /// over this enum in the kernel (rust/src/kernel/expr.rs) is written
    /// WITHOUT a wildcard `_ =>` arm — see expr.rs's own header for why:
    /// a wildcard here would let a newly-admitted capability compile
    /// silently into a router that never calls the new file this same
    /// regeneration adds a `pub mod` line for above.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum #{enum_name} {
    #{variants}
    }

    impl #{enum_name} {
        /// The `rust/src/kernel/#{enum_name == "AttributeShape" ? "attribute_shapes" : "expression_operators"}/<name>.rs` file this
        /// variant names — `bin/rust_kernel_coverage`'s own existence
        /// check reads this, so the file-name spelling here is the ONE
        /// place that ever needs to change if a name is renamed.
        pub fn module_name(&self) -> &'static str {
            match self {
    #{names.map { |name| "            #{enum_name}::#{pascal(name)} => #{name.to_s.inspect}," }.join("\n")}
            }
        }

        pub const ALL: &'static [#{enum_name}] = &[#{names.map { |name| "#{enum_name}::#{pascal(name)}" }.join(", ")}];
    }
  RUST

  write_atomically(target, content)
end

# THE BUCKET-2 SHAPE — a closed set the grammar admits with NO kernel
# dispatch site to route through yet (see this script's own header for
# why `QueryComparator` is the one real example today). Writes a single
# flat file, not a directory: `emit_mod`'s own directory-plus-`pub-mod`
# shape exists to let each variant point at hand-written interpretation
# logic, and there is no such logic here to point at. No `module_name`
# method either, for the same reason — inventing a file-path-shaped
# method for files nobody has written would be exactly the kind of
# "forced into existence" this function's whole job is to avoid. `ALL`
# stays, because listing every variant costs nothing and is exactly what
# the day this DOES get dispatched will want first.
def emit_gap_enum(target, header:, enum_name:, names:, doc_line:)
  variants = names.map { |name| "    #{pascal(name)}," }.join("\n")

  content = <<~RUST
    // GENERATED by bin/project_kernel_capabilities from #{doc_line}.
    // Do not hand-edit — re-run bin/project_kernel_capabilities instead.
    //
    #{header}
    //
    // UNDISPATCHED, ON PURPOSE — read this file's own name before its
    // variants. Every OTHER generated capability enum in this crate
    // (AttributeShape, OperatorCategory) is matched exhaustively, with no
    // wildcard arm, at exactly one real dispatch site in the hand-written
    // kernel — that is the whole mechanism this file's siblings exist to
    // protect. #{enum_name} has NO such site: `rust/src/kernel/cli.rs`
    // refuses every query step before any comparator is ever inspected
    // ("query steps are not generated yet" — the same "whole_kind" gap
    // bin/rust_coverage already documents, one layer up, at the
    // construct-kind level; this is that gap's own operator vocabulary,
    // named at the LANGUAGE level for the first time). So this enum is
    // generated and NOTHING in this crate matches over it — no `_ =>`
    // arm to worry about because there is no `match` at all. It exists so
    // the eight names below are TRACKED starting now, rather than staying
    // undiscoverable until the day a query engine gets built and someone
    // has to go re-derive them from Ruby by hand. Add a real dispatch
    // site against this enum the day that day comes, and it will already
    // refuse to compile non-exhaustively — the ordinary guarantee, just
    // starting later than usual.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    #[allow(dead_code)]
    pub enum #{enum_name} {
    #{variants}
    }

    impl #{enum_name} {
        pub const ALL: &'static [#{enum_name}] = &[#{names.map { |name| "#{enum_name}::#{pascal(name)}" }.join(", ")}];
    }
  RUST

  write_atomically(target, content)
end

# ── ATTRIBUTE SHAPES ──────────────────────────────────────────────────
shape_names = Hecksagain::Runtime::Value::Coercion::SHAPES
emit_mod(
  File.join(ROOT, "rust/src/kernel/attribute_shapes/mod.rs"),
  header: <<~HEADER.strip,
    // Ground truth: Hecksagain::Runtime::Value::Coercion::SHAPES
    // (lib/hecksagain/runtime/value/coercion.rb) — the four branches
    // `for_attribute` itself takes, read directly rather than
    // re-derived here.
  HEADER
  enum_name: "AttributeShape",
  names: shape_names,
  doc_line: "Coercion::SHAPES"
)

# ── EXPRESSION OPERATORS ──────────────────────────────────────────────
# `category`, in FIRST-APPEARANCE order over the live admission ledger —
# never alphabetized, so a re-run doesn't reshuffle variant order for no
# reason and produce a no-op-but-noisy diff.
operator_categories = Hecksagain::Grammar.admitted_operators.map { |op| op[:category] }.uniq
emit_mod(
  File.join(ROOT, "rust/src/kernel/expression_operators/mod.rs"),
  header: <<~HEADER.strip,
    // Ground truth: Hecksagain::Grammar.admitted_operators (lib/hecksagain/
    // grammar.rb), the SAME live-booted call bin/expression_projection
    // uses — grouped by the `category` field Evaluator::PROJECTION already
    // partitions comparison operators by (evaluator.rb).
  HEADER
  enum_name: "OperatorCategory",
  names: operator_categories,
  doc_line: "Grammar.admitted_operators's own `category` field"
)

# ── QUERY COMPARATORS — closed, real, and entirely undispatched. See this
# script's own header for the full reasoning; `emit_gap_enum`'s own
# generated header repeats the short version where a reader of the OUTPUT
# will see it. Written as a bare file under rust/src/kernel/ (not a
# subdirectory — there is no per-variant file to roster a directory of).
emit_gap_enum(
  File.join(ROOT, "rust/src/kernel/query_comparators.rs"),
  header: <<~HEADER.strip,
    // Ground truth: Hecksagain::QuerySpecification::Common::COMPARATORS
    // (lib/hecksagain/query_specification/common/comparators.rb) — the
    // same eight names Vocabulary::QueryComparator (language/bluebook/
    // vocabulary.bluebook) declares and spec/vocabulary_conformance_spec
    // holds the runtime to; a where-clause's `op:` admits exactly this
    // set (`admits: "Vocabulary::QueryComparator"`, Query::Filter).
  HEADER
  enum_name: "QueryComparator",
  names: Hecksagain::QuerySpecification::Common::COMPARATORS,
  doc_line: "QuerySpecification::Common::COMPARATORS"
)
