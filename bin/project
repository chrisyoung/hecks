#!/usr/bin/env ruby

# Refreshes every read-model projection a domain declares, by hand —
# the same catch-up a boot runs lazily, forced now rather than on
# first read.
#
#   bin/project <domain>

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"

runtime = Hecks.boot(ARGV.fetch(0))
runtime.registry.bluebooks.each do |domain, bluebook|
  bluebook.aggregates.each do |aggregate|
    Hecks::Ports::Projection.worker(runtime.registry, domain, aggregate, policy: :refresh)&.catch_up!
  end
end
