#!/usr/bin/env ruby

# ADR 0030 Slice 3's own stop-condition check — writes
# rust/src/kernel/reaction/mod.rs (the `Trigger`/`CommandRef`/
# `Dispatch`/`Bindings`/`Context`/`Persistence`/`Failure`/`Reaction`
# struct/enum definitions ONLY — no interpretation logic, no wiring
# into rust/src/kernel/orchestrate.rs) from ONE definition:
# Hecksagain::PrimalIR::Shape (lib/hecksagain/primal_ir/shape.rb) —
# see that file's own header for why this is a plain manifest, and
# for why this slice is deliberately unwired. Mirrors
# bin/project_binding_shape's own exact structure — see that script's
# own header for the "writes its own file, never `>`" reasoning.
#
#   bin/project_reaction_shape

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/primal_ir/shape"
require "fileutils"
require "tempfile"

ROOT  = File.expand_path("..", __dir__)
Shape = Hecksagain::PrimalIR::Shape

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

def struct_def(name, fields)
  body = if fields.empty?
           "pub struct #{name};"
         else
           members = fields.map { |f| "    pub #{f.name}: #{f.rust_type}," }.join("\n")
           "pub struct #{name} {\n#{members}\n}"
         end
  "#[derive(Debug, Clone)]\n#{body}\n"
end

def enum_variant(name, fields)
  return "    #{name}," if fields.empty?

  members = fields.map { |f| "#{f.name}: #{f.rust_type}" }.join(", ")
  "    #{name} { #{members} },"
end

def enum_def(name, variant_names, variants)
  body = variant_names.map { |variant_name| enum_variant(variant_name, variants.fetch(variant_name)) }.join("\n")
  "#[derive(Debug, Clone)]\npub enum #{name} {\n#{body}\n}\n"
end

# `Reaction` last, deliberately — it's the recursive root
# (`Failure::Managed.compensation: Option<Box<Reaction>>`), and every
# type it names (`Trigger`, `Dispatch`, `Context`, `Persistence`,
# `Failure`) reads more naturally declared before the struct that
# composes all five, even though Rust itself doesn't require the
# ordering.
node_structs = (Shape.node_names - ["Reaction"]).map { |name| struct_def(name, Shape::NODES.fetch(name)) }.join("\n")

content = <<~RUST
  // GENERATED by bin/project_reaction_shape from Hecksagain::PrimalIR::
  // Shape (lib/hecksagain/primal_ir/shape.rb). Do not hand-edit —
  // re-run bin/project_reaction_shape instead. STRUCTURE ONLY here — no
  // wiring into orchestrate.rs, see Shape's own header for why.
  // Interpretation logic (`resolve_dispatch_bindings`) stays hand-
  // written in logic.rs, re-exported below — the same "generate
  // structure, handwrite meaning" split kernel/binding/mod.rs already
  // draws. `ExecutableBinding` reuses Slice 2's own generated type
  // (kernel/binding/mod.rs); `Expr` reuses Slice 1's (kernel/expr/
  // mod.rs) — the whole payoff of doing Expression and Binding first
  // (ADR 0030's own proof-sequence ordering).

  use crate::kernel::binding::ExecutableBinding;

  // `Dispatch::VERBATIM`'s Rust counterpart — a real third case, not
  // reducible to an empty `Vec<ExecutableBinding>` (see Shape's own
  // comment). A TUPLE variant, unlike every other enum below —
  // `enum_def`/`enum_variant` (this script's own helpers) only build
  // NAMED-field variants, the shape `Context`/`Persistence`/`Failure`
  // all actually need; this one 2-variant enum is hand-spelled rather
  // than forcing a tuple case through helpers built for a different
  // shape.
  #[derive(Debug, Clone)]
  pub enum Bindings {
      Explicit(Vec<ExecutableBinding>),
      Verbatim,
  }

  #{node_structs}
  #{enum_def('Context', Shape.context_variant_names, Shape::CONTEXT_VARIANTS)}
  #{enum_def('Persistence', Shape.persistence_variant_names, Shape::PERSISTENCE_VARIANTS)}
  #{enum_def('Failure', Shape.failure_variant_names, Shape::FAILURE_VARIANTS)}
  #{struct_def('Reaction', Shape::NODES.fetch('Reaction'))}
  mod logic;
  pub use logic::resolve_dispatch_bindings;
RUST

write_atomically(File.join(ROOT, "rust/src/kernel/reaction/mod.rs"), content)
