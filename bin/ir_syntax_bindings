#!/usr/bin/env ruby

# THE NEXT RUNG AFTER bin/ir_dispatch_words — which word RECOGNIZES a
# category (that script's whole job); this is what a word's own ARGUMENTS
# mean once it has been recognized, projected into Rust source.
#
# `bin/ir_dispatch_words`'s own header named this the harder problem left
# undone: "so does every word's ARGUMENT shape... a materially harder
# problem solved separately, if it is solved at all." `Syntax::Argument`
# (kind/at/named/required/fills, plus `selects`/`pair_key_fills`/
# `pair_value_fills`/`pairs_shape` — see syntax.bluebook's own comments on
# those) already says enough to bind most of it generically; this script is
# what makes that binding data instead of prose.
#
# ONE MORE FACT NEEDED THAT NEITHER `Syntax::Keyword` NOR `Syntax::Argument`
# CARRIES ALONE: whether a keyword's own invocation sets a field directly on
# whatever construct is already being built (`role "Teller"` sets
# `Command.role`), or builds a brand-new compound appended to a LIST field
# (`attribute :price, Integer` builds a new `Attribute`, appended to
# `Command.attributes`). Both read as "`Keyword.fills` names a field" —
# the difference is whether that NAMED field is itself declared
# `list_of(...)` on the enclosing category, which `bluebook.bluebook` (and
# its siblings) already say. This script joins that in at generation time
# (`field_is_list?`) rather than asking Rust to re-derive it at parse time.
#
# EXCLUDED, BY DESIGN, NOT BY OVERSIGHT:
#   - any Argument row whose `pairs_shape` is "sibling" (`member`, `sets`'
#     `append:`) — its keys name a field of an ALREADY-DECLARED SIBLING
#     construct, which varies per domain and cannot be a static table row.
#     Left for a dynamic resolver, not this generator.
#   - `.hecksagon`/`.world`'s own contexts — open, undeclared adapter-verb
#     vocabulary, the same boundary M4 of the porting-readiness arc named.
#
# WHOLE FILE, NEVER A PATCH — same rule as every other bin/ir_* script.
#
# Regenerate with:
#
#   bin/ir_syntax_bindings > rust/src/bluebook/ir_syntax_bindings.rs
#
# spec/ir_syntax_bindings_export_spec.rb holds the checked-in file equal to
# this script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

BLUEBOOK = Hecksagain::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
SYNTAX   = BLUEBOOK.aggregate("Syntax")

KEYWORD  = SYNTAX.value_object("Keyword")  or raise "the language declares no Syntax::Keyword to project"
ARGUMENT = SYNTAX.value_object("Argument") or raise "the language declares no Syntax::Argument to project"

# A proposed argument has no reader yet, a retired one has no reader any
# more — the same admitted-or-deprecated-only rule every other syntax
# projection already uses (bin/ir_dispatch_words, bin/ir_syntax_flags, ...).
def live?(row) = !%w[proposed retired].include?(row[:status].to_s)

EXCLUDED_CONTEXTS = %w[Hecksagon World].freeze

# A FEW `Syntax::Context`s ARE NOT THEMSELVES BLUEBOOK CATEGORIES — the same
# fact bin/ir_structs' own `CATEGORIES` list carves out (`- %w[Vocabulary
# Syntax Member]`), one layer further. `Lifecycle` is the one live case here:
# a DECLARED FOLD (see syntax.bluebook's own `Context` comment), read back
# onto whichever of Aggregate/Entity opened it — `contracts.rb` says so, this
# just names the one field (`transitions`) that folds onto a real Rust
# `Vec`, so this generator does not have to open `Lifecycle` as a category
# that was never one to answer the same question bin/ir_structs answers for
# every REAL category.
PSEUDO_CATEGORY_LIST_FIELDS = { "Lifecycle" => %w[transitions] }.freeze

# THE ONE CROSS-REFERENCE THIS GENERATOR MAKES: is `field` declared
# `list_of(...)` on `category_name`? Read straight off the same judged
# meta-domain `bin/ir_structs` reads to decide the identical fact for its
# own Rust struct fields — not re-derived, the same one-line lookup that
# script's own `attr[:list]` is, called fresh here because this script
# needs it keyed by (category, field) rather than walked once per struct.
def field_is_list?(category_name, field_name)
  return false if field_name.to_s.empty?

  if (pseudo = PSEUDO_CATEGORY_LIST_FIELDS[category_name.to_s])
    return pseudo.include?(field_name.to_s)
  end

  category = BLUEBOOK.aggregate(category_name.to_s) or
    raise "Syntax names a category #{category_name} the language does not declare"
  attribute = category.attribute(field_name.to_s) or
    raise "#{category_name} declares no field #{field_name} for Syntax to fill"

  !!attribute.to_h[:list]
end

# "" (Direct — bindings set fields on whatever construct is already being
# built, whether that is the category itself or a construct this same line
# is opening) or the LIST FIELD NAME (AppendList — bindings build one new
# compound, appended there).
def append_to_for(keyword_row)
  fills = keyword_row[:fills].to_s
  return "" if fills.empty?

  field_is_list?(keyword_row[:context], fills) ? fills : ""
end

keyword_rows  = KEYWORD.members.map(&:to_h).select { |row| live?(row) }
argument_rows = ARGUMENT.members.map(&:to_h)
                        .select { |row| live?(row) }
                        .reject { |row| EXCLUDED_CONTEXTS.include?(row[:context].to_s) }
                        .reject { |row| row[:pairs_shape].to_s == "sibling" }

keyword_by_join = keyword_rows.each_with_object({}) { |row, h| h[[row[:word], row[:context]]] = row }

def rust_string(value) = "\"#{value.to_s.gsub('\\', '\\\\\\\\').gsub('"', '\\"')}\""
def rust_bool(value)   = value.to_s == "true" ? "true" : "false"

def argument_entry(row)
  "ArgumentBinding { " \
    "at: #{rust_string(row[:at])}, named: #{rust_string(row[:named])}, " \
    "kind: #{rust_string(row[:kind])}, required: #{rust_bool(row[:required])}, " \
    "fills: #{rust_string(row[:fills])}, selects: #{rust_string(row[:selects])}, " \
    "pair_key_fills: #{rust_string(row[:pair_key_fills])}, " \
    "pair_value_fills: #{rust_string(row[:pair_value_fills])}, " \
    "pairs_shape: #{rust_string(row[:pairs_shape])} }"
end

grouped = argument_rows.group_by { |row| [row[:keyword], row[:context]] }
                        .sort_by { |(keyword, context), _| [context, keyword] }

entries = grouped.map do |(keyword, context), rows|
  keyword_row = keyword_by_join[[keyword, context]] or
    raise "Syntax::Argument names #{keyword}/#{context}, which Syntax::Keyword does not declare"
  append_to = append_to_for(keyword_row)
  args = rows.sort_by { |r| [r[:at].to_s.empty? ? 1 : 0, r[:at].to_s, r[:named].to_s] }
             .map { |r| "        #{argument_entry(r)}," }
             .join("\n")

  <<~ENTRY.chomp
    KeywordBinding {
        keyword: #{rust_string(keyword)}, context: #{rust_string(context)}, append_to: #{rust_string(append_to)},
        arguments: &[
    #{args}
        ],
    },
  ENTRY
end

puts <<~RUST
  // GENERATED BY bin/ir_syntax_bindings — DO NOT EDIT BY HAND.
  //
  // Every (keyword, context) pair's own argument-binding shape, projected
  // from the language's own declared syntax (Syntax::Keyword, Syntax::Argument
  // — language/bluebook/syntax.bluebook). `append_to` is "" when this
  // keyword's own bindings set fields directly on whatever construct is
  // already being built, or names the LIST field a new compound gets
  // appended to otherwise — computed by cross-referencing Syntax::Keyword's
  // own `fills` against the enclosing category's declared field type, not
  // carried by the language as a separate fact.
  //
  // EXCLUDED: any `pairs_shape: "sibling"` argument (`member`, `sets`'
  // `append:` — see this file's own generator comment), and `.hecksagon`/
  // `.world`'s open adapter-verb vocabulary.
  //
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook
  // Regenerate: bin/ir_syntax_bindings > rust/src/bluebook/ir_syntax_bindings.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_syntax_bindings_export_spec.rb.

  #[derive(Debug, Clone, Copy)]
  pub struct ArgumentBinding {
      pub at: &'static str,
      pub named: &'static str,
      pub kind: &'static str,
      pub required: bool,
      pub fills: &'static str,
      pub selects: &'static str,
      pub pair_key_fills: &'static str,
      pub pair_value_fills: &'static str,
      pub pairs_shape: &'static str,
  }

  #[derive(Debug, Clone, Copy)]
  pub struct KeywordBinding {
      pub keyword: &'static str,
      pub context: &'static str,
      pub append_to: &'static str,
      pub arguments: &'static [ArgumentBinding],
  }

  pub const KEYWORD_BINDINGS: &[KeywordBinding] = &[
  #{entries.join("\n")}
  ];
RUST
