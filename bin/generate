#!/usr/bin/env ruby

# Prints one randomly generated, valid dispatch sequence for a domain —
# the same generator bin/fuzz drives, exposed standalone so a sequence
# can be inspected or saved without running the property battery.
#
#   bin/generate <domain> [--seed N] [--steps N]

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/fuzzing"
require "json"

domain = ARGV.shift or abort "usage: bin/generate <domain> [--seed N] [--steps N]"

seed  = 1
steps = 30
until ARGV.empty?
  case ARGV.shift
  when "--seed"  then seed  = Integer(ARGV.shift)
  when "--steps" then steps = Integer(ARGV.shift)
  else abort "usage: bin/generate <domain> [--seed N] [--steps N]"
  end
end

generated = Hecksagain::Fuzzing::SequenceGenerator.generate(domain, seed: seed, steps: steps)

puts JSON.pretty_generate(
  name: "#{File.basename(domain)}-generated",
  note: "generated by bin/generate — seed #{seed}, #{steps} steps requested (#{generated.length} produced)",
  steps: generated
)
