#!/usr/bin/env ruby

# Executes a step list — commands and queries, declared as JSON — and
# reports instances, events, refusals, reactions, sagas, and query rows.
# The corpus scripts under spec/corpus/ are exactly this format.
#
#   bin/run <domain> <script.json>
#   bin/run <domain> -            # the same script, on stdin
#   bin/run <domain> '{"steps":[…]}'
#
# THE LAST TWO ARE FOR A CALLER WITH ONE VERB TO ISSUE. A corpus member is a
# file because it is kept; an agent dispatching a single command should not
# have to leave a file behind to do it, and a temp file is exactly the friction
# that sends somebody back to editing the store by hand. `bin/docs <domain>`
# prints what each verb wants — its arguments, the states it may be issued
# from, and every way it can refuse.
#
#   bin/run qa '{"steps":[{"query":"QualityControl::Bug.Unfixed"}]}'
#
#   bin/run qa - <<'JSON'
#   {"steps":[
#     {"verb":"QualityControl::Session.Start",
#      "args":{"reference":{"value":"QA-1"},"engineer":{"value":"Claude QA"}}}
#   ]}
#   JSON

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "json"

USAGE = "usage: bin/run [domain] <verb [name=value …] | script.json | - | '{\"steps\":[…]}'>".freeze

# ── the command-line form ───────────────────────────────────────────────
#
# `bin/run bug.discover reference=BUG#1 severity=high …` — no JSON anywhere.
# The verb tree, every argument, its declared type and every way the verb can
# refuse are projected out of the bluebook (`Projector::CliProjector`), so this
# script knows nothing about any domain and the help cannot go stale.
#
# Tried FIRST, and falls through to the JSON form when the first argument does
# not name a projected verb — which is what keeps `bin/run <domain> <script>`
# working exactly as it did.
def cli_form(domain, argv)
  runtime  = Hecks.boot(domain, install_facade: false)
  bluebook = runtime.registry.bluebooks.values.first
  cli      = Hecksagain::Projector.call(:cli, bluebook: bluebook, options: { program: "bin/run" })

  name = argv.first
  if name.nil? || %w[--help -h help].include?(name)
    puts cli[:usage]
    exit 0
  end

  # `ask` PUTS A QUESTION IN ITS OWN NAMESPACE. See the projector: a chapter
  # may declare a command and a query of one name, and banking does.
  asking = name == "ask"
  if asking
    argv = argv[1..]
    name = argv.first or abort cli[:usage]
  end

  spec = (asking ? cli[:questions] : cli[:verbs])[name]
  return nil unless spec

  if argv[1..].include?("--help")
    puts Hecksagain::Projector.call(
      :cli, bluebook: bluebook, options: { program: "bin/run", verb: name, ask: asking }
    )[:usage]
    exit 0
  end

  begin
    args = Hecksagain::Facade::CliDoor.arguments(spec, argv[1..])
  rescue Hecksagain::Runtime::NotFound, Hecksagain::Runtime::TypeMismatch => e
    abort "#{e.message}\n\n  bin/run #{name} --help"
  end

  # THE ANSWER IS SCOPED TO WHAT WAS ASKED. The step-list form below reports
  # the whole store because a corpus run is judged on all of it; a caller who
  # issued one verb wants that verb's outcome, and on a Postgres-backed domain
  # the full dump is every record there has ever been.
  begin
    if spec[:kind] == :query
      rows = runtime.query(spec[:verb], **args)
      puts JSON.pretty_generate(rows.map { |row| Hecksagain::Facade::JsonDoor.materialize(row) })
    else
      handle = runtime.dispatch(spec[:verb], **args)
      puts JSON.pretty_generate(
        id:     handle.id,
        state:  Hecksagain::Facade::JsonDoor.materialize(handle.state),
        events: handle.events.map(&:name)
      )
    end
  rescue *Hecksagain::Runtime::DOMAIN_REFUSALS => e
    # THE REFUSAL IS THE PRODUCT. In the chapter's own words, on stderr so a
    # pipeline can tell it from an answer, and a non-zero exit so a script can.
    abort e.message
  end
  exit 0
end

# STANDING IN A DOMAIN IS ENOUGH — `Adapters::Folder#domain_root` walks up for
# the nearest `.hecksagon`, so inside `examples/banking` the path can be left
# off. The first argument is the SCRIPT when it obviously is one: stdin, inline
# JSON, or a file that exists. Otherwise it names the domain.
script_shaped = ->(arg) { arg == "-" || arg.match?(/\A\s*\{/) || File.file?(arg) }

# THE FIRST ARGUMENT IS A DOMAIN ONLY WHEN IT IS A DIRECTORY. Everything else
# — a verb, a script path, inline JSON — belongs to the domain you are standing
# in, found by walking up for a `.hecksagon`.
here = Hecksagain::Adapters::Folder.new.domain_root
argv = ARGV.dup
domain = argv.first && File.directory?(argv.first) ? argv.shift : here

abort "no bluebook here — #{Dir.pwd} is not inside a domain. #{USAGE}" unless domain

# The command-line form answers unless the first argument names no projected
# verb, in which case this returns and the step-list form takes over.
cli_form(domain, argv) unless argv.first && script_shaped[argv.first]

script = argv.first or abort USAGE

# A PATH, STDIN, OR THE JSON ITSELF — decided by looking, because a script
# beginning with `{` is not a filename anybody meant.
source =
  case script
  when "-"      then $stdin.read
  when /\A\s*\{/ then script
  else
    File.exist?(script) ? File.read(script) : abort("no such script: #{script}")
  end

# PARSED BEFORE THE BOOT. Booting opens a real store — Postgres for some
# domains — and a typo in the JSON should cost a sentence, not a connection.
begin
  document = JSON.parse(source)
rescue JSON::ParserError => e
  abort "that is not JSON: #{e.message.lines.first.strip}"
end

steps = document["steps"] or abort %(the script has no "steps" — #{USAGE})

runtime   = Hecks.boot(domain)
refusals  = []

queries = []

steps.each do |step|
  args = (step["args"] || {}).transform_keys(&:to_sym)

  if (question = step["query"])
    begin
      rows = runtime.query(question, **args)
      queries << { query: question, args: args, rows: rows }
    rescue StandardError => e
      queries << { query: question, args: args, error: e.message }
    end
    next
  end

  verb = step["verb"]
  begin
    runtime.dispatch(verb, **args)
  rescue StandardError => e
    refusals << { verb: verb, error: "#{e.message}" }
  end
end

instances = {}
runtime.registry.bluebooks.each do |domain_name, bluebook|
  bluebook.aggregates.each do |aggregate|
    runtime.registry.repository(domain_name, aggregate).all.each do |record|
      instances["#{domain_name}::#{aggregate.name}##{record.id}"] = record.state
    end
  end
end

events = runtime.events.map do |event|
  { name: event.name, aggregate: event.aggregate, id: event.id, payload: event.payload }
end

reactions = runtime.reactions

sagas = runtime.sagas

# The run is REPORTED before it is JUDGED. A matrix expectation that fails says
# what was wanted and never what happened — and aborting before the print takes
# the whole run's evidence down with it, which is how a refusal that merely
# changed its words reads as a runtime that crashed. So: answer to stdout first,
# every unmet expectation collected rather than aborted on at the first, and the
# complaints to stderr, apart from the evidence they complain about.
puts JSON.pretty_generate(
  instances: instances, events: events, refusals: refusals, reactions: reactions,
  sagas: sagas, queries: queries
)

expectations = document["expectations"] || {}
unmet = []

missing_events = Array(expectations["event_names"]) - events.map { |event| event[:name] }
unmet << "matrix expected events missing: #{missing_events.join(', ')}" unless missing_events.empty?

Array(expectations["refusals"]).each do |expected|
  verb = expected.fetch("verb")
  matched = refusals.any? do |refusal|
    refusal[:verb] == verb && refusal[:error].include?(expected.fetch("includes"))
  end
  next if matched

  # What DID that verb say? A refusal that changed its words is a different
  # story from a refusal that never happened, and the two are indistinguishable
  # until the actual errors are printed beside the wanted one.
  said = refusals.select { |refusal| refusal[:verb] == verb }.map { |refusal| refusal[:error] }.uniq
  unmet << "matrix expected refusal missing: #{expected}\n" \
           "  #{verb} actually refused with: #{said.empty? ? '(nothing — every attempt was accepted)' : said.inspect}"
end

(expectations["instances"] || {}).each do |key, fields|
  actual = instances[key] || {}
  fields.each do |field, value|
    next if actual[field.to_sym] == value

    unmet << "matrix expected #{key}.#{field}=#{value.inspect}, got #{actual[field.to_sym].inspect}"
  end
end

abort unmet.join("\n") unless unmet.empty?
