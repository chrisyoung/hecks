#!/usr/bin/env ruby

# Generates random-but-valid command/query sequences from a domain's own IR
# and checks them the exact same way the hand-written corpus is checked —
# by shelling out to bin/parity, unchanged. No new comparison logic here on
# purpose: bin/parity's IR/behavior/history/store parity and its SILENT guard
# are already verified, so a generated script gets exactly the same scrutiny
# a hand-written one does.
#
# On the first disagreement, shrinks the failing sequence (repeatedly trying
# to remove one step at a time, keeping the removal if the disagreement still
# reproduces) and saves the result under tmp/fuzz-failures/ — small enough to
# actually debug, not just a seed number to re-run blind. Promoting a
# genuinely interesting failure into spec/parity/<domain>.json permanently is
# a decision for a human to make, not something this script does for you.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "hecksagain/fuzzing"
require "json"
require "tmpdir"
require "fileutils"
require "open3"

ROOT = File.expand_path("..", __dir__)

def write_script(steps, path, seed, domain_name)
  File.write(path, JSON.pretty_generate(
    name: "#{domain_name}-fuzz",
    note: "generated by bin/fuzz — seed #{seed}",
    steps: steps
  ))
end

# :agreed / :silent / :split — bin/parity exits nonzero for BOTH a genuine
# SPLIT and its own SILENT guard (every step refused, so both runtimes
# "agree" about nothing). Those are not the same finding : a SILENT script is
# a fuzzer effectiveness problem (this sequence never reached an interesting
# state), not a cross-runtime disagreement, and treating the two alike was a
# real bug here — the very first banking run "found" a SPLIT that turned out
# to be a single query with no state to query yet, shrunk down to that one
# vacuous step and reported as though it meant something.
# THROUGH ONE ADAPTER. A generated sequence is looking for the two RUNTIMES to
# disagree, which is a property of the interpreter and not of the store — and
# this is called once per seed and ~60 more times per failure it shrinks, so the
# second adapter doubled the cost of the whole sweep for nothing. Cross-ADAPTER
# agreement is spec/adapters/banking_matrix_spec's job, and bin/parity's own
# corpus run still takes banking through both on every push.
PARITY_ADAPTER = "Heki".freeze

# How many seeds may be drawn per executing seed asked for, before the sweep
# gives up and says so. Generous, because a domain whose sequences mostly refuse
# is a generator problem worth reporting rather than a reason to run forever.
DRAW_LIMIT = 5

def parity_verdict(domain, script_path)
  output, status = Open3.capture2e(File.join(ROOT, "bin/parity"), domain, script_path, PARITY_ADAPTER)
  return [:agreed, output] if status.success?
  return [:silent, output] if output.include?("SILENT")

  [:split, output]
end

def parity_result(domain, script_path) = parity_verdict(domain, script_path).first

# WHICH DISAGREEMENT THIS IS, so twenty seeds that all found one bug read as one
# bug. The first changed line pair names the shape ; digits and quoted text are
# blanked so the same disagreement over different generated values groups
# together, which is the whole difference between a report and a pile.
def signature_of(output)
  changed = output.lines.select { |line| line.start_with?("+", "-") }
                  .reject { |line| line.start_with?("+++", "---") }
  return "unknown" if changed.empty?

  # Keys survive, values blur. Blanking both made every disagreement read as
  # `"…": "…"`, which groups correctly and tells you nothing — the field that
  # moved is the whole point of the line.
  changed.first(2)
         .map { |line| line.strip.gsub(/: "[^"]*"/, ': "…"').gsub(/\b\d+\b/, "N") }
         .join("  vs  ")
end

# One sweep at a time, trying to remove each remaining step ; keep the
# removal only when the result is STILL :split without it (not merely
# nonzero — see parity_result). Repeats full sweeps until one changes
# nothing. Not globally minimal, but reliably strips the steps that were
# never relevant to the failure.
def shrink(domain, steps, seed)
  Dir.mktmpdir("hecksagain-shrink") do |tmp|
    path = File.join(tmp, "candidate.json")
    current = steps.dup
    begin
      changed = false
      index = 0
      while index < current.length
        candidate = current[0...index] + current[(index + 1)..]
        if candidate.empty?
          index += 1
          next
        end
        write_script(candidate, path, seed, File.basename(domain))
        if parity_result(domain, path) == :split
          current = candidate
          changed = true
        else
          index += 1
        end
      end
    end while changed
    shrink_arguments(domain, current, seed, path)
  end
end

# THEN INSIDE EACH SURVIVING STEP. Removing whole steps leaves every argument of
# the ones that remain, so an irrelevant value rides along looking implicated:
# banking seed 21 shrank to three steps and kept `adjustment: -2147483648`, which
# had nothing to do with the split, and left whether i32::MIN separately splits
# unknown — masked by the disagreement that did fire.
#
# Arguments are dropped one at a time and kept dropped only while the split still
# reproduces, the same rule the step pass uses. An argument the domain requires
# will change the refusal and stop reproducing, so it comes straight back.
def shrink_arguments(domain, steps, seed, path)
  steps.each_with_index do |step, position|
    args = step["args"] || step[:args]
    next unless args.is_a?(Hash)

    args.keys.each do |key|
      trimmed = args.reject { |name, _| name == key }
      candidate = steps.map(&:dup)
      candidate[position] = step.merge("args" => trimmed)

      write_script(candidate, path, seed, File.basename(domain))
      next unless parity_result(domain, path) == :split

      args = trimmed
      steps = candidate
      step = candidate[position]
    end
  end
  steps
end

def fuzz_domain(domain, seeds, steps)
  domain = domain.chomp("/")
  name = File.basename(domain)
  puts "── #{name}"

  # EVERY SEED RUNS. Stopping at the first split let one bug hide every bug
  # behind it, and made a green re-run after a fix weak evidence — the rest of
  # the space had never been reached to begin with.
  failures = []
  agreed = 0
  silent = 0
  drawn = 0

  # DRAWN UNTIL N HAVE EXECUTED, rather than simply numbered 1..N.
  #
  # A silent sequence refused every step, so the two runtimes agreed about
  # nothing — `bin/parity` says so itself. Counting one toward the sweep is how
  # `--seeds 20` came to mean thirteen, and the number that was reported was the
  # number asked for rather than the number achieved.
  #
  # Silence is NOT retired. It is a property of the seed AND the bluebook
  # together: seed 8 is silent against banking as it stands today, and generates
  # something else entirely the moment banking moves. A remembered deny-list
  # would go stale immediately and would skip precisely the seed that had just
  # become interesting.
  #
  # The cap stops a domain that can never execute from drawing forever, and is
  # REPORTED rather than swallowed — a sweep that fell short is not a sweep that
  # passed.
  cap = seeds * DRAW_LIMIT
  while (agreed + failures.length) < seeds && drawn < cap
    drawn += 1
    seed = drawn
    generated = Hecksagain::Fuzzing::SequenceGenerator.generate(domain, seed: seed, steps: steps)
    Dir.mktmpdir("hecksagain-fuzz-trial") do |tmp|
      path = File.join(tmp, "trial.json")
      write_script(generated, path, seed, name)
      verdict, output = parity_verdict(domain, path)
      case verdict
      when :split  then failures << { seed: seed, steps: generated, signature: signature_of(output) }
      when :silent then silent += 1
      else              agreed += 1
      end
    end
  end

  report(domain, name, seeds, drawn, agreed, silent, failures)
end

# WHAT THE SWEEP FOUND, grouped by disagreement rather than by seed — twenty
# seeds tripping one bug is one finding, and reading it as twenty is how a report
# becomes noise. Silent runs are named rather than buried : they are the sweep
# telling you it never reached an interesting state, which is a fuzzer problem,
# not a runtime one.
def report(domain, name, seeds, drawn, agreed, silent, failures)
  executed = agreed + failures.length
  drawn_note = silent.positive? ? " (#{drawn} drawn, #{silent} silent)" : ""
  puts "   #{executed} seeds executed#{drawn_note} — #{agreed} agreed, #{failures.length} split"

  if executed < seeds
    puts "   SHORT — asked for #{seeds} executing seeds and drew #{drawn} to find #{executed}."
    puts "          The generator is not reaching state ; this sweep proves less than it looks."
  end

  if failures.empty?
    puts
    return true
  end

  grouped = failures.group_by { |failure| failure[:signature] }
  puts "   #{grouped.size} distinct disagreement(s):"
  save_dir = File.join(ROOT, "tmp/fuzz-failures")
  FileUtils.mkdir_p(save_dir)

  grouped.each_value.with_index(1) do |group, number|
    seeds_hit = group.map { |failure| failure[:seed] }
    smallest  = group.min_by { |failure| failure[:steps].length }

    puts
    puts "   (#{number}) #{group.first[:signature]}"
    puts "       #{group.length} of #{seeds} seeds: #{seeds_hit.first(8).join(', ')}#{seeds_hit.length > 8 ? ', …' : ''}"

    shrunk    = shrink(domain, smallest[:steps], smallest[:seed])
    save_path = File.join(save_dir, "#{name}-seed#{smallest[:seed]}.json")
    write_script(shrunk, save_path, smallest[:seed], name)

    puts "       shrunk #{smallest[:steps].length} steps -> #{shrunk.length}"
    puts "       reproduce: bin/parity #{domain} #{save_path}"
  end

  puts
  puts "   promoting any of these into spec/parity/#{name}.json permanently is a manual decision, not automatic."
  puts
  false
end

seeds = 20
steps = 30
domain_arg = nil
until ARGV.empty?
  case (arg = ARGV.shift)
  when "--seeds" then seeds = Integer(ARGV.shift)
  when "--steps" then steps = Integer(ARGV.shift)
  else domain_arg = arg
  end
end

domains = domain_arg ? [domain_arg] : Dir.glob("#{ROOT}/examples/*/") + [File.join(ROOT, "lib/hecksagain/grammar")]

ok = domains.reduce(true) { |all_ok, domain| fuzz_domain(domain, seeds, steps) && all_ok }

if ok
  puts "AGREED — every generated sequence read the same in both runtimes."
  exit 0
else
  puts "FUZZ FOUND A DISAGREEMENT."
  exit 1
end
