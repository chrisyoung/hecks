#!/bin/sh
# parity — run one bluebook through both runtimes and diff the answers.
#
#   bin/parity [domain] [script.json]
#
# BOTH RUNTIMES READ THE SAME SOURCE FILE. Neither is handed the other's
# output, so this compares two PARSERS and two INTERPRETERS.
#
# Two parsers is not the mistake hecksagain exists to avoid — two parsers
# AUTHORED TWICE BY HAND, kept in step by a suite that only detects drift after
# the fact, is. Until the Rust parser is a projection of the Ruby one, this
# harness is what keeps them honest: drift shows up as a wrong answer, not as a
# diff nobody reads.
#
# Object key ORDER is normalised before diffing (Rust sorts, Ruby preserves
# insertion order) because key order is not semantics. Nothing else is.
set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DOMAIN=${1:-"$ROOT/examples/pizzas"}
SCRIPT=${2:-"$ROOT/examples/pizzas/parity/script.json"}
BINARY="$ROOT/rust/target/release/hecksagain"
BLUEBOOK=$(ls "$DOMAIN"/bluebook/*.bluebook | head -1)

# ALWAYS rebuild. An earlier version built only when the binary was missing, so
# editing the Rust side and re-running compared fresh Ruby against a stale
# binary — a harness that can report AGREED about code that no longer exists is
# worse than no harness at all. cargo is incremental; the honesty is free.
(cd "$ROOT/rust" && cargo build --release --quiet)

# A stale store would make the second run disagree with the first for reasons
# that have nothing to do with either runtime.
rm -rf "$DOMAIN/data"

# ---------------------------------------------------------------------------
# STAGE ONE — did the two parsers UNDERSTAND the same document?
#
# Agreeing on behaviour is good ; agreeing on the IR is stronger, because two
# parsers can read two DIFFERENT documents that happen to run the same way. If
# this passes, any later disagreement is in the interpreters and nowhere else.
# ---------------------------------------------------------------------------
"$ROOT/bin/ir" "$DOMAIN"     > /tmp/hecksagain.ruby.ir.json
"$BINARY" --dump "$BLUEBOOK" > /tmp/hecksagain.rust.ir.json

"$ROOT/bin/canonicalise" /tmp/hecksagain.ruby.ir.json > /tmp/hecksagain.ruby.ir.c.json
"$ROOT/bin/canonicalise" /tmp/hecksagain.rust.ir.json > /tmp/hecksagain.rust.ir.c.json

if diff -u /tmp/hecksagain.ruby.ir.c.json /tmp/hecksagain.rust.ir.c.json; then
  echo "parsers agree — both read the same IR from $(basename "$BLUEBOOK")"
else
  echo
  echo "SPLIT — the two PARSERS read the same file differently."
  echo "Fix that before reading any behavioural diff: the interpreters are"
  echo "being fed different documents."
  exit 1
fi

# ---------------------------------------------------------------------------
# STAGE TWO — do the two interpreters DO the same thing?
#
# Successes and every refusal path. A runtime that ACCEPTS what the other
# refuses is the failure most worth catching.
# ---------------------------------------------------------------------------
"$ROOT/bin/run" "$DOMAIN" "$SCRIPT" > /tmp/hecksagain.ruby.raw.json
"$BINARY" "$BLUEBOOK" "$SCRIPT"     > /tmp/hecksagain.rust.raw.json

"$ROOT/bin/canonicalise" /tmp/hecksagain.ruby.raw.json > /tmp/hecksagain.ruby.json
"$ROOT/bin/canonicalise" /tmp/hecksagain.rust.raw.json > /tmp/hecksagain.rust.json

if diff -u /tmp/hecksagain.ruby.json /tmp/hecksagain.rust.json; then
  echo
  echo "AGREED — ruby and rust read the same bluebook and returned the same"
  echo "answer for every step."
  exit 0
fi

echo
echo "SPLIT — the runtimes disagreed."
echo "The parsers agreed, so this is the interpreters. If the disagreement is"
echo "about what an expression MEANS, that is a defect in"
echo "language/bluebook/expression.bluebook, not in whichever runtime you like"
echo "less — tighten the chapter until the ambiguity is gone."
exit 1
