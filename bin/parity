#!/bin/sh

ROOT=$(cd "$(dirname "$0")/.." && pwd)
BINARY="$ROOT/rust/target/release/hecksagain"

# ALWAYS REBUILT, NEVER ASSUMED. `$BINARY` is a compiled artifact, not
# something this script can trust to already match the source tree — a
# manual `cargo build` run outside this script (bare `--release`, no
# `--workspace`, or from a different directory) can leave `target/release/`
# holding a binary from a previous edit, and every check below would then be
# diffing a stale Rust against a fresh Ruby and reporting a real-looking
# SPLIT for a bug that was already fixed. `--workspace` is required — the
# CLI binary lives in the `cli` member, and building without it silently
# skips rebuilding the binary this whole script runs.
(cd "$ROOT/rust" && cargo build --release --workspace --quiet) || exit 1

# Postgres needs no more configuration than Heki or Sqlite do. Those two
# write into the staged domain and nobody sets a variable for them; this
# one gets a conventional local database, created and dropped by
# pg_reset like any other parity scratch space.
#
# HECKS_PARITY_POSTGRES overrides the URL — a CI service container, a
# non-default port. It is NOT how the variant is turned on. Requiring it
# to be SET was the bug: an unset variable skipped every Postgres gate,
# the era dance included, and the run still exited 0. A commit that
# broke the era dance passed twice that way before a run with the
# variable set caught it.
HECKS_PARITY_POSTGRES=${HECKS_PARITY_POSTGRES:-postgres://localhost/hecks_parity}
export HECKS_PARITY_POSTGRES
PG_ADMIN="${HECKS_PARITY_POSTGRES%/*}/postgres"
if psql -q "$PG_ADMIN" -c 'SELECT 1' >/dev/null 2>&1; then PG_AVAILABLE=1; else PG_AVAILABLE=; fi

# Drop and recreate the parity database — the Postgres variant's
# equivalent of `rm -rf data`. Reachable-then-failing refuses loudly.
pg_reset() {
  dbname=${HECKS_PARITY_POSTGRES##*/}
  psql -q "$PG_ADMIN" -v ON_ERROR_STOP=1 \
    -c "DROP DATABASE IF EXISTS $dbname WITH (FORCE)" \
    -c "CREATE DATABASE $dbname" >/dev/null 2>&1 || {
      echo "   POSTGRES UNREACHABLE — $PG_ADMIN answered the probe but not this reset."
      return 1
    }
}

run_domain() {
  source_domain=$1
  script=$2
  adapter=$3
  name=$(basename "$source_domain")
  variant=$(printf '%s' "$adapter" | tr '[:upper:]' '[:lower:]')
  domain="/tmp/parity.$name.$variant.domain"

  rm -rf "$domain"
  cp -R "$source_domain" "$domain" || return 1
  if [ "$variant" = "sqlite" ]; then
    # SqlitePersistence, not "Sqlite" — that is the adapter's actual name on both
    # sides (Ruby declares it, Rust registers `sqlitepersistence`). The old
    # substitution named an adapter that has never existed, which no one noticed
    # because nothing ever ran this branch.
    perl -0pi -e 's/"Heki"/"SqlitePersistence"/g; s/dir "data"/database "data\/parity.sqlite3"/g' \
      "$domain/bluebook"/*.hecksagon "$domain/bluebook"/*.world || return 1
  fi
  if [ "$variant" = "postgres" ]; then
    # Rebind the AUTHORITATIVE persistence only; a SqliteProjection bind
    # keeps its own database, so the substitution targets persisted_by
    # blocks rather than every database line.
    perl -0pi -e 's/persisted_by\("(Heki|SqlitePersistence)"\)/persisted_by("Postgres")/g; s/(persisted_by\("Postgres"\) do\s*\n\s*)(?:dir|database) "[^"]*"/${1}database "$ENV{HECKS_PARITY_POSTGRES}"/g' \
      "$domain/bluebook"/*.hecksagon "$domain/bluebook"/*.world || return 1
    # The IR stage below boots the rewritten domain too — the database
    # must exist before ANY boot, not just before the run stages.
    pg_reset || return 1
  fi

  bluebook=$(ls "$domain"/bluebook/*.bluebook 2>/dev/null | head -1)
  [ -z "$bluebook" ] && bluebook=$(ls "$domain"/*.bluebook 2>/dev/null | head -1)
  echo "── $name ($adapter)"
  if [ -z "$bluebook" ]; then
    echo "   NO BLUEBOOK in $domain"
    return 1
  fi

  prefix="/tmp/parity.output.$name.$variant"
  rm -f "$prefix".*
  "$ROOT/bin/ir" "$domain" > "$prefix.ruby.ir.json" || return 1
  "$BINARY" --dump "$bluebook" > "$prefix.rust.ir.json" || return 1
  "$ROOT/bin/canonicalise" "$prefix.ruby.ir.json" > "$prefix.ruby.ir.c.json"
  "$ROOT/bin/canonicalise" "$prefix.rust.ir.json" > "$prefix.rust.ir.c.json"
  if ! diff -u "$prefix.ruby.ir.c.json" "$prefix.rust.ir.c.json"; then
    echo "   SPLIT — the two parsers read $(basename "$bluebook") differently."
    return 1
  fi
  echo "   parsers agree — same IR from $(basename "$bluebook")"

  # Translation edges are their own sublanguage with their own parser in
  # each runtime — diff their IR the same way, whenever the domain
  # carries a translations/ folder beside its bluebook.
  translations_dir="$(dirname "$bluebook")/translations"
  if ls "$translations_dir"/*.bluebook >/dev/null 2>&1; then
    "$ROOT/bin/ir" --translations "$domain" > "$prefix.ruby.tr.json" || return 1
    "$BINARY" --dump-translation "$translations_dir" > "$prefix.rust.tr.json" || return 1
    "$ROOT/bin/canonicalise" "$prefix.ruby.tr.json" > "$prefix.ruby.tr.c.json"
    "$ROOT/bin/canonicalise" "$prefix.rust.tr.json" > "$prefix.rust.tr.c.json"
    if ! diff -u "$prefix.ruby.tr.c.json" "$prefix.rust.tr.c.json"; then
      echo "   SPLIT — the two parsers read the translation edges differently."
      return 1
    fi
    echo "   translations agree — same edge IR from translations/"
  fi

  rm -rf "$domain/data"
  if [ "$variant" = "postgres" ]; then pg_reset || return 1; fi
  "$ROOT/bin/run" "$domain" "$script" > "$prefix.ruby.raw.json" || return 1
  "$ROOT/bin/stores" "$domain" > "$prefix.ruby.rows" 2>/dev/null || true
  "$ROOT/bin/history" "$domain" > "$prefix.ruby.history.raw.json" || return 1

  rm -rf "$domain/data"
  if [ "$variant" = "postgres" ]; then pg_reset || return 1; fi
  "$BINARY" "$bluebook" "$script" > "$prefix.rust.raw.json" || return 1
  "$ROOT/bin/stores" "$domain" > "$prefix.rust.rows" 2>/dev/null || true
  "$ROOT/bin/history" "$domain" > "$prefix.rust.history.raw.json" || return 1

  "$ROOT/bin/canonicalise" "$prefix.ruby.raw.json" > "$prefix.ruby.json"
  "$ROOT/bin/canonicalise" "$prefix.rust.raw.json" > "$prefix.rust.json"

  # Agreement is not execution. Two runtimes that refuse every step agree
  # perfectly, and every downstream stage — histories, stores — then diffs two
  # empty results and passes. Pizzas sat like that, reported AGREED, while its
  # parity script ran no domain logic at all. Ask what actually happened before
  # asking whether the two answers match.
  # AGREEMENT IS NOT EXECUTION, AND A FLOOR IS NOT A CLAIM.
  #
  # This used to refuse only ZERO events. That caught pizzas sitting green while
  # running no domain logic at all — and then let `market` report AGREED at SEVEN
  # events from FORTY steps, a thirty-three-refusal cascade from one bad default,
  # because seven is not zero. A floor cannot tell "most of this refused" from
  # "this is what the script asks for".
  #
  # So the script SAYS how many events it expects, and the number is checked
  # exactly. Fewer means refusals crept in ; more means something fired that
  # nobody wrote down. Changing the corpus changes the number ON PURPOSE, in the
  # same commit, which is the same discipline the IR goldens carry.
  expected=$(ruby -rjson -e 'print JSON.parse(File.read(ARGV[0])).dig("expectations", "events") || -1' \
    "$script")
  attempted=$(ruby -rjson -e 'print JSON.parse(File.read(ARGV[0])).fetch("steps", []).length' \
    "$script")
  if [ "$expected" -lt 0 ]; then
    echo "   NO CLAIM — $script does not say how many events it expects."
    echo "              Add \"expectations\": { \"events\": N }; a corpus member that"
    echo "              cannot say what it does cannot notice when it stops doing it."
    return 1
  fi
  for runtime in ruby rust; do
    executed=$(ruby -rjson -e 'print JSON.parse(STDIN.read).fetch("events", []).length' \
      < "$prefix.$runtime.json")
    if [ "$executed" -ne "$expected" ]; then
      echo "   OFF ITS CLAIM — $name executed $executed events through $runtime from $attempted steps ; the script says $expected."
      echo "                   Fewer means steps are being refused that used to run."
      return 1
    fi
  done
  executed=$expected

  if ! diff -u "$prefix.ruby.json" "$prefix.rust.json"; then
    echo "   SPLIT — the runtimes disagreed on $name through $adapter."
    return 1
  fi
  echo "   runtimes agree — same answer for every step"
  echo "   corpus executes — $executed events from $attempted steps"

  "$ROOT/bin/canonicalise" "$prefix.ruby.history.raw.json" > "$prefix.ruby.history.json"
  "$ROOT/bin/canonicalise" "$prefix.rust.history.raw.json" > "$prefix.rust.history.json"
  if ! diff -u "$prefix.ruby.history.json" "$prefix.rust.history.json"; then
    echo "   SPLIT — the runtimes wrote different append-only persistence histories."
    return 1
  fi
  echo "   histories agree — same append-only persistence history"

  if [ -s "$prefix.ruby.rows" ] || [ -s "$prefix.rust.rows" ]; then
    "$ROOT/bin/canonicalise" "$prefix.ruby.rows" > "$prefix.ruby.rows.json"
    "$ROOT/bin/canonicalise" "$prefix.rust.rows" > "$prefix.rust.rows.json"
    if ! diff -u "$prefix.ruby.rows.json" "$prefix.rust.rows.json"; then
      echo "   SPLIT — the runtimes agreed in memory and wrote different stores."
      return 1
    fi
    echo "   stores agree — Ruby and Rust wrote the same data"
  fi

  rm -rf "$domain"
  return 0
}

# TWO BRANCHES THAT RAN THE SAME ADAPTER IS NOT A CHOICE, IT IS A STUB.
#
# The Sqlite rewrite below was written, shipped, and never once reached — and it
# would not have worked if it had been: it substituted an adapter named "Sqlite",
# and no such adapter exists. Ruby declares SqlitePersistence and Rust registers
# `sqlitepersistence`.
#
# Banking is the domain that earns the second run : it is the only one with
# references, and every reference-bearing SQLite path was Ruby-only until now
# (pizzas does drive Rust through SQLite, but pizzas has no references).
run_variants() {
  source=$1
  script=$2
  run_domain "$source" "$script" Heki || return 1
  # Market earns the second run for the other reason banking does: a composite
  # identity is the only shape where a store keyed by ONE column has to hold a
  # record whose id is the JOIN of two. Heki keys by the id it is handed and
  # would never notice.
  case "$(basename "$source")" in
    banking|market) run_domain "$source" "$script" Sqlite || return 1 ;;
  esac
  # The Postgres variant runs wherever a domain declares explicit wiring
  # (a hecksagon to rebind) and a Postgres answered. The only reason to
  # skip is that there is no server here — an environmental fact, not a
  # configuration one.
  if [ -n "$PG_AVAILABLE" ] && ls "$source"/bluebook/*.hecksagon >/dev/null 2>&1; then
    run_domain "$source" "$script" Postgres || return 1
  fi
}

if [ -z "$PG_AVAILABLE" ]; then
  echo "NOTICE: no Postgres answered at $PG_ADMIN — the Postgres variant AND the era dance are skipped."
  echo "        Everything below this line therefore says nothing about eras."
  echo "        A local install or 'docker run -p 5432:5432 postgres' both work;"
  echo "        HECKS_PARITY_POSTGRES overrides the URL."
fi

# The two-era lineage fixture: era bump → scaffold → audit → mint →
# old-era writes (the fork) → tail-merge. Gates: byte-identical refusals
# in both runtimes (drift, capability, unresolved, merge-conflict),
# cross-runtime diffs of the era-2 run/history/stores over identically
# prepared databases, and ancestor-partition immutability across the
# whole dance.
run_lineage() {
  src="$ROOT/examples/lineage"
  staged="/tmp/parity.lineage.domain"
  prefix="/tmp/parity.output.lineage"
  edge_file=$(ls "$src/bluebook/translations/")
  rm -f "$prefix".*
  rm -rf "$staged"
  cp -R "$src" "$staged"
  perl -0pi -e 's|database "[^"]*"|database "$ENV{HECKS_PARITY_POSTGRES}"|' "$staged/bluebook/lineage.world"

  echo "── lineage (Postgres) — the era dance"

  stage_era_1() {
    cp "$staged/v1/lineage.bluebook" "$staged/bluebook/lineage.bluebook"
    cp "$staged/v1/lineage.hecksagon" "$staged/bluebook/lineage.hecksagon"
    rm -rf "$staged/bluebook/translations"
  }
  stage_era_2() {
    cp "$src/bluebook/lineage.bluebook" "$staged/bluebook/lineage.bluebook"
    cp "$src/bluebook/lineage.hecksagon" "$staged/bluebook/lineage.hecksagon"
  }

  # ── refusal bytes: drift (both runtimes), unresolved (both runtimes)
  pg_reset || return 1
  stage_era_1
  "$ROOT/bin/run" "$staged" "$ROOT/spec/parity/fixtures/lineage_v1.json" >/dev/null 2>&1 || { echo "   FAILED — era-1 writes did not run"; return 1; }
  stage_era_2
  want_drift="cannot boot Lineage: the shape changed (era 2) and no translation edge covers it — run bin/scaffold_translation to write the edge, check it with bin/translation_audit, then boot again"
  "$ROOT/bin/run" "$staged" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -qF "$want_drift" || { echo "   SPLIT — ruby drift refusal bytes"; return 1; }
  "$BINARY" "$staged/bluebook/lineage.bluebook" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -qF "$want_drift" || { echo "   SPLIT — rust drift refusal bytes"; return 1; }
  echo "   drift refuses toward the scaffold — byte-identical in both runtimes"

  mkdir -p "$staged/bluebook/translations"
  printf 'Hecks.data_translation "Lineage", from: "x", to: "y" do\n  aggregate "Account" do\n    unresolved :cost, candidates: [:amount]\n  end\nend\n' \
    > "$staged/bluebook/translations/2-unresolved.bluebook"
  want_unresolved="Account's translation leaves :cost unresolved (candidates: :amount) — replace unresolved with a rename, move, convert, or drop before booting."
  "$ROOT/bin/run" "$staged" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -qF "$want_unresolved" || { echo "   SPLIT — ruby unresolved refusal bytes"; return 1; }
  "$BINARY" "$staged/bluebook/lineage.bluebook" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -qF "$want_unresolved" || { echo "   SPLIT — rust unresolved refusal bytes"; return 1; }
  rm "$staged/bluebook/translations/2-unresolved.bluebook"
  echo "   unresolved refuses at load — byte-identical in both runtimes"

  # ── the adapters with no eras: the same drift Postgres carries across
  #    is simply not their business. Each holds nothing on disk and is
  #    never lectured about a translation it could not apply — the two
  #    runtimes agree on the silence as firmly as they agree on bytes.
  #    Every non-capable adapter is walked, not a representative one:
  #    "eras belong to the adapter that can carry data across them" is a
  #    claim about all of them, so all of them are asked.
  no_lecture="cannot translate\|cannot serve a superseded era"
  for eraless in Heki SqlitePersistence Memory; do
    home="/tmp/parity.lineage.$(printf '%s' "$eraless" | tr '[:upper:]' '[:lower:]').domain"
    rm -rf "$home"
    cp -R "$src" "$home"
    rm -rf "$home/bluebook/translations"
    case "$eraless" in
      Heki) perl -0pi -e 's/persisted_by\("Postgres"\) do\s*\n\s*database "[^"]*"/persisted_by("Heki") do\n    dir "data"/' \
              "$home/bluebook/lineage.world" || return 1 ;;
      SqlitePersistence) perl -0pi -e 's/persisted_by\("Postgres"\) do\s*\n\s*database "[^"]*"/persisted_by("SqlitePersistence") do\n    database "data\/parity.sqlite3"/' \
              "$home/bluebook/lineage.world" || return 1 ;;
      # Memory declares no fields at all, so its bind carries no block —
      # which is the point: there is nothing left to configure.
      Memory) perl -0pi -e 's/persisted_by\("Postgres"\) do\s*\n\s*database "[^"]*"\s*\n\s*end/persisted_by("Memory")/' \
              "$home/bluebook/lineage.world" || return 1 ;;
    esac
    perl -0pi -e "s/persisted_by\\(\"Postgres\"\\)/persisted_by(\"$eraless\")/g" \
      "$home/bluebook/lineage.hecksagon" "$home/v1/lineage.hecksagon" || return 1
    cp "$home/v1/lineage.bluebook" "$home/bluebook/lineage.bluebook"
    cp "$home/v1/lineage.hecksagon" "$home/bluebook/lineage.hecksagon"
    "$ROOT/bin/run" "$home" "$ROOT/spec/parity/fixtures/lineage_v1.json" >/dev/null 2>&1 ||
      { echo "   FAILED — $eraless era-1 writes did not run"; return 1; }
    if [ -d "$home/data/eras" ]; then echo "   SPLIT — $eraless held an era it cannot use"; return 1; fi

    cp "$src/bluebook/lineage.bluebook" "$home/bluebook/lineage.bluebook"
    cp "$src/bluebook/lineage.hecksagon" "$home/bluebook/lineage.hecksagon"
    perl -0pi -e "s/persisted_by\\(\"Postgres\"\\)/persisted_by(\"$eraless\")/g" "$home/bluebook/lineage.hecksagon" || return 1
    "$ROOT/bin/ir" "$home" >/dev/null 2>&1 ||
      { echo "   SPLIT — ruby refused to boot drift under $eraless, which has no eras"; return 1; }
    if "$ROOT/bin/run" "$home" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -q "$no_lecture"; then
      echo "   SPLIT — ruby lectured $eraless, which has no eras"; return 1
    fi
    if "$BINARY" "$home/bluebook/lineage.bluebook" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -q "$no_lecture"; then
      echo "   SPLIT — rust lectured $eraless, which has no eras"; return 1
    fi
    if [ -d "$home/data/eras" ]; then echo "   SPLIT — an era was held for $eraless, which has none"; return 1; fi
  done
  echo "   Heki, Sqlite and Memory hold nothing and are never lectured — both runtimes"

  # ── the authoring loop: scaffold, resolve, audit; rust refuses until minted
  "$ROOT/bin/scaffold_translation" "$staged" >/dev/null 2>&1 || { echo "   FAILED — scaffold refused"; return 1; }
  cp "$src/bluebook/translations/$edge_file" "$staged/bluebook/translations/$edge_file"
  "$ROOT/bin/translation_audit" "$staged" > "$prefix.audit" 2>/dev/null || { echo "   FAILED — audit refused:"; cat "$prefix.audit"; return 1; }
  want_unminted="cannot boot Lineage: era 2 is not minted — minting is Ruby-only; boot the domain from Ruby to mint it, then boot here again"
  "$BINARY" "$staged/bluebook/lineage.bluebook" "$ROOT/spec/parity/lineage.json" 2>&1 | grep -qF "$want_unminted" || { echo "   SPLIT — rust unminted refusal bytes"; return 1; }
  echo "   scaffold + audit pass; an unminted era refuses from rust toward ruby"

  # ── the era-2 run, cross-runtime: identically prepared databases,
  #    ruby runs once, rust runs once, every gate diffed
  for runtime in ruby rust; do
    pg_reset || return 1
    stage_era_1
    "$ROOT/bin/run" "$staged" "$ROOT/spec/parity/fixtures/lineage_v1.json" >/dev/null 2>&1 || { echo "   FAILED — era-1 writes ($runtime leg)"; return 1; }
    stage_era_2
    mkdir -p "$staged/bluebook/translations"
    cp "$src/bluebook/translations/$edge_file" "$staged/bluebook/translations/$edge_file"
    "$ROOT/bin/ir" "$staged" >/dev/null 2>&1 || { echo "   FAILED — mint boot ($runtime leg)"; return 1; }
    if [ "$runtime" = "ruby" ]; then
      "$ROOT/bin/run" "$staged" "$ROOT/spec/parity/lineage.json" > "$prefix.$runtime.raw.json" 2>/dev/null || { echo "   FAILED — ruby era-2 run"; return 1; }
    else
      "$BINARY" "$staged/bluebook/lineage.bluebook" "$ROOT/spec/parity/lineage.json" > "$prefix.$runtime.raw.json" || { echo "   FAILED — rust era-2 run"; return 1; }
    fi
    "$ROOT/bin/history" "$staged" > "$prefix.$runtime.history.raw.json" 2>/dev/null || return 1
    "$ROOT/bin/stores" "$staged" > "$prefix.$runtime.rows" 2>/dev/null || return 1
    "$ROOT/bin/canonicalise" "$prefix.$runtime.raw.json" > "$prefix.$runtime.json"
    "$ROOT/bin/canonicalise" "$prefix.$runtime.history.raw.json" > "$prefix.$runtime.history.json"
    "$ROOT/bin/canonicalise" "$prefix.$runtime.rows" > "$prefix.$runtime.rows.json"
  done
  diff -u "$prefix.ruby.json" "$prefix.rust.json" || { echo "   SPLIT — the runtimes disagreed on the era-2 run"; return 1; }
  diff -u "$prefix.ruby.history.json" "$prefix.rust.history.json" || { echo "   SPLIT — different journal histories after the era-2 run"; return 1; }
  diff -u "$prefix.ruby.rows.json" "$prefix.rust.rows.json" || { echo "   SPLIT — different translated heads after the era-2 run"; return 1; }
  echo "   era-2 run agrees — output, journal history, and translated stores"

  # ── the fork: the old checkout keeps writing; then the tail-merge
  psql -q "$HECKS_PARITY_POSTGRES" -t -c "SELECT ordinal, md5(state::text) FROM hecks_journal_lineage WHERE era = 1 ORDER BY ordinal" > "$prefix.ancestor.before"
  old="/tmp/parity.lineage.old.domain"
  rm -rf "$old"
  cp -R "$staged" "$old"
  cp "$old/v1/lineage.bluebook" "$old/bluebook/lineage.bluebook"
  cp "$old/v1/lineage.hecksagon" "$old/bluebook/lineage.hecksagon"
  rm -rf "$old/bluebook/translations"
  "$ROOT/bin/run" "$old" "$ROOT/spec/parity/fixtures/lineage_v1_tail.json" >/dev/null 2>&1 || { echo "   FAILED — the old world could not keep writing its era"; return 1; }
  diverged=$(psql -q "$HECKS_PARITY_POSTGRES" -t -A -c "SELECT count(*) FROM hecks_journal_lineage WHERE era = 1 AND ordinal > (SELECT watermark FROM hecks_eras WHERE domain = 'Lineage' AND ordinal = 2)")
  [ "$diverged" = "2" ] || { echo "   FAILED — divergence not observable (saw $diverged, wanted 2)"; return 1; }
  echo "   the old world diverges deliberately — $diverged post-cut writes, observable"

  want_conflict="cannot merge the tail of Lineage: touched by both worlds since the cut — account#acct-1. Name each winner (--winner <id>=old or --winner <id>=new), then run bin/merge_tail again"
  "$ROOT/bin/merge_tail" "$staged" 2>&1 | grep -qF "$want_conflict" || { echo "   SPLIT — merge-conflict refusal bytes"; return 1; }
  "$ROOT/bin/merge_tail" "$staged" --winner acct-1=new >/dev/null 2>&1 || { echo "   FAILED — merge with a declared winner"; return 1; }
  merged=$(psql -q "$HECKS_PARITY_POSTGRES" -t -A -c "SELECT count(*) FROM account_head WHERE id = 'acct-9'")
  [ "$merged" = "1" ] || { echo "   FAILED — the merged tail did not reach the head"; return 1; }
  echo "   tail-merge refuses the conflict by name, then interleaves the declared winner"

  max_before=$(awk -F'|' '$1+0 > 0 {max = $1+0} END {print max}' "$prefix.ancestor.before")
  psql -q "$HECKS_PARITY_POSTGRES" -t -c "SELECT ordinal, md5(state::text) FROM hecks_journal_lineage WHERE era = 1 AND ordinal <= $max_before ORDER BY ordinal" > "$prefix.ancestor.after"
  diff -u "$prefix.ancestor.before" "$prefix.ancestor.after" || { echo "   SPLIT — an ancestor-partition row changed; originals are immutable"; return 1; }
  echo "   ancestor partition immutable — every pre-fork row byte-identical through the dance"

  return 0
}

failed=0
if [ $# -ge 1 ]; then
  domain=$1
  script=${2:-"$ROOT/spec/parity/$(basename "$1").json"}
  # ONE ADAPTER, WHEN THE CALLER ASKS FOR ONE.
  #
  # `run_domain` has always taken an adapter ; there was simply no way to say
  # which from the command line. The harnesses that shell out to this in a LOOP
  # — bin/fuzz once per seed, plus ~60 more per failure it shrinks, and
  # bin/undeclared once per perturbed declaration — are hunting cross-RUNTIME
  # disagreement, which is a property of the interpreter and not of the store.
  # Running them through one adapter costs them nothing and halves their
  # wall clock.
  #
  # The no-argument corpus run below is untouched, so the pre-push gate still
  # takes banking through both.
  variant=$3
  case "$variant" in
    Heki|Sqlite|"") ;;
    *) echo "   NO ADAPTER named $variant — it is Heki or Sqlite."; exit 1 ;;
  esac
  if [ -n "$variant" ]; then
    run_domain "$domain" "$script" "$variant" || failed=1
  else
    run_variants "$domain" "$script" || failed=1
  fi
else
  # THREE KINDS OF CORPUS MEMBER. `examples/` is what a reader is shown ;
  # `lib/hecksagain/grammar/` is a real part of the runtime that happens to be
  # a chapter (each staged alone below) ; `spec/parity/domains/` is neither —
  # a home for a domain that would exist ONLY to hold the two runtimes to a
  # shape no example declares, and has no business being read as an example
  # of anything. Empty now: `market` (composite identity) and `relay`
  # (plural emits/read_models/process_managers) were the domains that lived
  # here, and both folded into banking once it grew the same forms itself —
  # so the directory may not exist at all, and the glob below has to survive
  # that rather than expand to its own literal pattern (POSIX `sh` has no
  # nullglob) and walk a domain named `*`.
  domains="$ROOT/examples/*/"
  [ -d "$ROOT/spec/parity/domains" ] && domains="$domains $ROOT/spec/parity/domains/*/"
  for domain in $domains; do
    domain=${domain%/}
    name=$(basename "$domain")
    # examples/lineage is the two-era Postgres fixture, driven by its own
    # gated stage below — a world that binds Postgres cannot be a member
    # of the zero-infrastructure walk.
    [ "$name" = "lineage" ] && continue
    script="$ROOT/spec/parity/$name.json"
    if [ ! -f "$script" ]; then
      echo "── $name"
      echo "   NO SCRIPT at spec/parity/$name.json — write one, or remove the domain."
      failed=1
      continue
    fi
    run_variants "$domain" "$script" || failed=1
    echo
  done

  # Each grammar chapter is its own corpus member. The grammar folder
  # holds one bluebook PER SUBLANGUAGE (expression, translation, ...),
  # but a domain directory can only be walked as one runtime boot — so
  # each chapter is staged alone into a scratch directory and run under
  # its own script, spec/parity/<chapter>.json. A chapter added to the
  # folder with no script fails the walk rather than sliding outside it.
  for bluebook in "$ROOT"/lib/hecksagain/grammar/*.bluebook; do
    stem=$(basename "$bluebook" .bluebook)
    staged="/tmp/parity.corpus/$stem"
    rm -rf "$staged"
    mkdir -p "$staged/bluebook"
    cp "$bluebook" "$staged/bluebook/"
    script="$ROOT/spec/parity/$stem.json"
    if [ ! -f "$script" ]; then
      echo "── $stem"
      echo "   NO SCRIPT at spec/parity/$stem.json — write one, or remove the chapter."
      failed=1
      continue
    fi
    run_variants "$staged" "$script" || failed=1
    echo
  done

  # The bump/no-bump boundary, held by DERIVED assertions: seeded
  # mutants of the corpus, one storage-shape verdict from both runtimes.
  # Zero infrastructure — this stage runs everywhere.
  "$ROOT/bin/fuzz_shapes" || failed=1
  echo

  if [ -n "$PG_AVAILABLE" ]; then
    run_lineage || failed=1
    echo
  fi
fi

if [ "$failed" -eq 0 ]; then
  echo "AGREED — every example reads the same in both runtimes and writes the same adapter histories."
  exit 0
fi

echo "PARITY FAILED."
exit 1
