#!/usr/bin/env ruby

# WHICH NAMED ARGUMENTS ARE FLAGS — projected into Rust source, so a reader
# that turns bare `true`/`false` text into a `bool` is only ever invoked on a
# kwarg the language actually declares that shape for.
#
# `language/bluebook/syntax.bluebook` already declares this : `Syntax::Argument`
# holds a `kind` per row, and `"flag"` is the one that means "true or false,
# nothing else". `bin/ir_dispatch_words` generated WORD recognition — this is
# the first slice of the materially harder next rung named in RESTART.md,
# ARGUMENT generation, and deliberately the smallest one: `flag` is a single
# bit, with no per-context variation in what reading it even means (unlike
# `pairs`, where `then_set`'s `append:` and `on`'s `transition:` bind their
# pairs to completely different fields).
#
# THIS DOES NOT GENERATE THE READER. `parse_flag_kwarg` (parse_blocks.rs)
# stays hand-written — one function, already shared by both of Rust's two
# `optional:` call sites (`f34938f`). What this generates is the CHECK that
# the reader is only ever pointed at a kwarg the language calls a flag :
# `parse_flag_kwarg` asserts its own argument against `FLAG_ARGUMENTS` before
# reading anything. A future flag-kind argument that gets wired to
# `parse_quoted_kwarg` by mistake — reading "true" as the STRING "true"
# instead of the bool `true`, the exact encoding-loss shape this codebase
# keeps finding — has nothing left to catch it silently ; a future call
# passing a NON-flag kwarg to `parse_flag_kwarg` (the mirror mistake) panics
# instead of quietly reading `false` for anything that isn't the literal text
# "true".
#
# Regenerate with:
#
#   bin/ir_syntax_flags > rust/src/bluebook/ir_syntax_flags.rs
#
# spec/ir_syntax_flags_export_spec.rb holds the checked-in file equal to this
# script's current output.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

syntax = Hecksagain::Bluebook::MetaValidator
         .grammar_registry.bluebook("Bluebook").aggregate("Syntax")

argument = syntax.value_object("Argument") or raise "the language declares no Syntax::Argument to project"

def flag_argument_names(argument)
  rows = argument.members
                 .map(&:to_h)
                 # A proposed or retired argument reaches no projected table —
                 # to a projected reader it does not exist. Deprecated reads.
                 .reject { |row| %w[proposed retired].include?(row[:status].to_s) }
                 .select { |row| row.fetch(:kind) == "flag" }
                 .reject { |row| row.fetch(:named).to_s.empty? }
                 .uniq { |row| row.fetch(:named) }
                 .sort_by { |row| row.fetch(:named) }

  raise "Syntax::Argument admits no argument of kind \"flag\"" if rows.empty?

  rows.map { |row| row.fetch(:named) }
end

names = flag_argument_names(argument)
entries = names.map { |n| "    \"#{n}\",\n" }.join

puts <<~RUST
  // GENERATED BY bin/ir_syntax_flags — DO NOT EDIT BY HAND.
  //
  // Every named argument the language declares as kind "flag" — read as a
  // bare true/false, never a quoted string or a bare word.
  // Source: lib/hecksagain/language/bluebook/syntax.bluebook
  // Regenerate: bin/ir_syntax_flags > rust/src/bluebook/ir_syntax_flags.rs
  //
  // Held equal to the generator's current output by
  // spec/ir_syntax_flags_export_spec.rb. Checked at every call by
  // parse_flag_kwarg itself (parse_blocks.rs) — a kwarg name reaching that
  // function which this table does not list is a reader/declaration
  // mismatch, not a missing feature, and it asserts rather than silently
  // mis-parsing.

  pub const FLAG_ARGUMENTS: &[&str] = &[
  #{entries}];
RUST
