#!/usr/bin/env ruby

# Writes a domain's usage document, projected from its own bluebook.
#
#   bin/docs <domain-path> [aggregate]
#
#   bin/docs examples/banking            # the whole chapter, to stdout
#   bin/docs examples/banking Account    # one aggregate
#   bin/docs qa > docs/domains/qa.md
#
# The same projection `<Domain>.docs` answers with in a console — this is for
# the times you want it on disk. Nothing is written for you: redirect it, so
# the caller decides where a generated file lands and git decides whether it
# drifted.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

path      = ARGV.fetch(0) { abort "usage: bin/docs <domain-path> [aggregate]" }
aggregate = ARGV[1]

runtime  = Hecks.boot(path, install_facade: false)
# The domain's OWN chapter, not a framework member it attached — insertion
# order, the same distinction `Runtime::Loader.dispatcher_for` draws.
bluebook = runtime.registry.bluebooks.values.first

options = aggregate ? { aggregate: aggregate } : {}
puts Hecksagain::Projector.call(:docs, bluebook: bluebook, options: options)
