#!/usr/bin/env ruby

# A domain's usage document, projected from its own bluebook.
#
#   bin/docs                             # list every domain in this checkout
#   bin/docs examples/banking            # the whole chapter, to stdout
#   bin/docs examples/banking Account    # one aggregate
#   bin/docs qa > docs/domains/qa.md     # on disk, if you want it there
#
# The same projection `<Domain>.docs` answers with in a console — this is for
# the times you are not in one. Nothing is written for you: redirect it, so the
# caller decides where a generated file lands and git decides whether it
# drifted.
#
# EVERY FAILURE IS A SENTENCE, NOT A BACKTRACE, and not silence. A misspelled
# aggregate used to print nothing and exit 0 — the silent-wrong-answer shape
# this repository has already been bitten by twice in its query engine. An
# agent calling this cannot tell an empty document from an empty domain, so it
# refuses instead and names what is actually there.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecksagain"

ROOT = File.expand_path("..", __dir__)

# EVERY DIRECTORY `Hecks.boot` WOULD ACCEPT. Derived by walking for `.bluebook`
# files rather than hand-listed, for the reason `Framework.members` gives about
# its own directory: a list somebody maintains is a list that goes stale the
# first time a domain lands and nobody remembers it.
#
# EXCLUSIONS MATCH THE RELATIVE PATH, NOT THE ABSOLUTE ONE. Written the other
# way first and it answered with nothing at all: this checkout is a worktree
# under `/private/tmp`, so a `path.include?("/tmp/")` meant to skip build
# output matched every file in the repository. A substring test against an
# absolute path is a test against wherever somebody happened to clone.
IGNORED = %r{\A(rust|deploy|tmp|coverage)/}.freeze

# FOUND BY THEIR WIRING, NOT BY THEIR CHAPTERS. Globbing `*.bluebook` finds
# every chapter in the repository and most of them are not domains you can
# boot — era translations, the language's own self-hosted grammar, and
# `spec/fixtures`, which holds a dozen unrelated chapters in one directory and
# would answer with whichever `bluebooks.values.first` happened to pick.
#
# A `.hecksagon` is the thing that says "this is a domain, and here is how its
# aggregates are stored", so it is the honest marker of somewhere `Hecks.boot`
# will do what a caller expects.
def domains
  Dir.glob(File.join(ROOT, "**/*.hecksagon"))
     .map    { |path| File.basename(File.dirname(path)) == "bluebook" ? File.dirname(File.dirname(path)) : File.dirname(path) }
     .map    { |path| path.delete_prefix("#{ROOT}/") }
     .reject { |path| path.match?(IGNORED) }
     .uniq.sort
end

if ARGV.empty?
  warn "usage: bin/docs <domain-path> [aggregate]"
  warn ""
  warn "domains in this checkout:"
  domains.each { |path| warn "  #{path}" }
  exit 1
end

path      = ARGV.fetch(0)
aggregate = ARGV[1]

begin
  runtime = Hecks.boot(path, install_facade: false)
rescue StandardError => e
  abort "cannot read #{path}: #{e.message.lines.first.strip}"
end

# The domain's OWN chapter, not a framework member it attached — insertion
# order, the same distinction `Runtime::Loader.dispatcher_for` draws.
bluebook = runtime.registry.bluebooks.values.first
abort "#{path} loaded no bluebook" unless bluebook

begin
  puts Hecksagain::Projector.call(
    :docs,
    bluebook: bluebook,
    options:  aggregate ? { aggregate: aggregate } : {}
  )
rescue Hecksagain::Runtime::NotFound => e
  abort e.message
end
