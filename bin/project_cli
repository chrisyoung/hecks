#!/usr/bin/env ruby

# Mints a command-line binary for a domain, named after its bluebook.
#
#   bin/project_cli                    # every domain in this checkout
#   bin/project_cli qa                 # just this one
#
# `Hecks.bluebook "QualityControl"` becomes `bin/quality_control`, and from
# then on:
#
#   bin/quality_control                       every verb, and every question
#   bin/quality_control bug.discover --help   what it wants, and how it refuses
#   bin/pizzas create_pizza name=Margherita pizza.price_cents.cents=1200 …
#
# WHAT IS GENERATED IS A LAUNCHER, NOT A CLI. Each file is a dozen lines
# pinning one directory and handing over to `Facade::CliRunner` — the surface
# still comes from `Projector.call(:cli, …)` at the moment it runs, so editing
# a chapter changes the binary's behaviour without regenerating anything. That
# is the whole reason the projection answers a SURFACE rather than a program:
# a generated dispatcher would need re-minting on every bluebook edit, and
# would be a second copy of the parse-and-dispatch besides.
#
# Re-run it when a domain is added or renamed. Nothing else.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"
require "fileutils"

ROOT   = File.expand_path("..", __dir__)
FOLDER = Hecksagain::Adapters::Folder.new

def domains
  Dir.glob(File.join(ROOT, "**/*.hecksagon"))
     .map    { |path| FOLDER.domain_root(File.dirname(path)) }
     .compact
     .map    { |path| path.delete_prefix("#{ROOT}/") }
     .reject { |path| path.match?(%r{\A(rust|deploy|tmp|coverage)/}) }
     .uniq.sort
end

# The name comes from `Hecks.bluebook "…"`, not from the directory — a domain
# renamed with `formerly_known_as` gets a binary under its new name, and the
# directory it happens to sit in is nobody's business.
def bluebook_name(path)
  Hecks.boot(File.join(ROOT, path), install_facade: false).registry.bluebooks.keys.first
rescue StandardError => e
  warn "  #{path}: cannot boot — #{e.message.lines.first.strip}"
  nil
end

def launcher(path, name)
  <<~RUBY
    #!/usr/bin/env ruby

    # #{name}'s command line — GENERATED by bin/project_cli. Do not edit.
    #
    # A launcher, not a CLI: the verbs, their arguments and their refusals are
    # projected from #{path}'s own bluebook every time this runs, so a change to
    # the chapter shows up here without re-minting anything.
    #
    #   bin/#{Hecksagain::Naming.snake(name)}                  every verb, and every question
    #   bin/#{Hecksagain::Naming.snake(name)} <verb> --help    what it wants, and how it refuses

    $LOAD_PATH.unshift File.expand_path("../lib", __dir__)

    require "hecksagain"

    DOMAIN = File.expand_path("../#{path}", __dir__)

    runtime = begin
      Hecks.boot(DOMAIN, install_facade: false)
    rescue StandardError => e
      abort "cannot open #{name}: \#{e.message.lines.first.strip}"
    end

    text, status = Hecksagain::Facade::CliRunner.call(
      runtime: runtime, argv: ARGV, program: "bin/#{Hecksagain::Naming.snake(name)}"
    )
    status.zero? ? puts(text) : abort(text)
  RUBY
end

wanted = ARGV.empty? ? domains : ARGV.map { |path| path.delete_prefix("#{ROOT}/").chomp("/") }

wanted.each do |path|
  name = bluebook_name(path) or next
  file = File.join(ROOT, "bin", Hecksagain::Naming.snake(name))

  File.write(file, launcher(path, name))
  FileUtils.chmod("+x", file)
  puts "  bin/#{Hecksagain::Naming.snake(name)}  ->  #{path}  (#{name})"
end
