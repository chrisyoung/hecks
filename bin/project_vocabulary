#!/usr/bin/env ruby

# Projects the language's own closed sets into lib/hecksagain/vocabulary.rb.
#
# A one-line wrapper over the projector registry, deliberately — the four
# tools that came before this one (bin/project_parser_table, bin/reference,
# bin/expression_projection, and this script's own first draft) each
# invented their own call shape for "canonical IR in, artifact out". This
# one asks the registry.
#
#   bin/project_vocabulary

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain"

chapter = Hecksagain::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
out     = File.expand_path("../lib/hecksagain/vocabulary.rb", __dir__)

puts "wrote #{Hecksagain::Projector.write(
  Hecksagain::Projector.call(:vocabulary, bluebook: chapter), out
)}"
