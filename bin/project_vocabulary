#!/usr/bin/env ruby

# Projects the language's own closed sets into lib/hecks/vocabulary.rb.
#
# A one-line wrapper over the projector registry, deliberately — the four
# tools that came before this one (bin/project_parser_table, bin/reference,
# bin/expression_projection, and this script's own first draft) each
# invented their own call shape for "canonical IR in, artifact out". This
# one asks the registry.
#
#   bin/project_vocabulary

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

chapter = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
out     = File.expand_path("../lib/hecks/vocabulary.rb", __dir__)

puts "wrote #{Hecks::Projector.write(
  Hecks::Projector.call(:vocabulary, bluebook: chapter), out
)}"
