# WHERE THE LEDGER LIVES.
#
# A database of its own rather than a schema inside the storehouse the deployed
# domains share. This is a development tool for this repository: it should be
# creatable with one `createdb`, droppable without a change-control
# conversation, and absent from any bill. `examples/pizzas/bluebook/pizzas.world`
# points at a local database for the same reason.
#
# `hecks_quality_control`, matching the domain rather than the directory — the
# ledger outlives whatever folder it is read from.
#
# NO `deployed_to`. This has no production. A deploy target here would be a
# claim that somebody, somewhere, runs this, and the first thing
# `bin/project_deploy` would do is take it seriously.
Hecks.world "QualityControl" do
  realm "Development"

  persisted_by("Postgres") do
    database "postgres://localhost/hecks_quality_control"
  end
end
