{
  "name": "banking-parity",
  "note": "Every declared banking command and query is exercised in both runtimes, including refusal paths. The adversarial cases assert that nested Narrative values are validated before an entity is appended, an amendment cannot reduce a ledger entry below zero, and a transfer cannot settle until a destination credit produced TransferCredited. Persistence retains every write as an append-only version entry while reads materialize the last entry for each identity. One external transfer names a direction outside Account::LedgerDirection: `admits` is a rule about a set declared in ANOTHER aggregate, and a rule only one runtime enforces is one bluebook meaning two things — which is precisely what this file exists to catch.",
  "expectations": {
    "event_names": [
      "TransferCredited"
    ],
    "refusals": [
      {
        "verb": "Banking::Account.Credit",
        "includes": "a movement explains itself"
      },
      {
        "verb": "Banking::Account.LedgerEntry.Amend",
        "includes": "non-negative amount"
      },
      {
        "verb": "Banking::Transfer.Settle",
        "includes": "only from \"credited\""
      },
      {
        "verb": "Banking::Account.ApplyFee",
        "includes": "an amount is positive"
      },
      {
        "verb": "Banking::Account.CorrectInterest",
        "includes": "cannot exceed accrued interest"
      },
      {
        "verb": "Banking::CardPayment.Authorize",
        "includes": "a payment amount is positive"
      },
      {
        "verb": "Banking::ExternalTransfer.Request",
        "includes": "an external transfer amount is positive"
      },
      {
        "verb": "Banking::ScheduledPayment.Schedule",
        "includes": "a scheduled payment amount is positive"
      }
    ],
    "instances": {
      "Banking::Transfer#xfer-4": {
        "status": "reversed"
      },
      "Banking::CardPayment#pay-refund": {
        "status": "refunded"
      },
      "Banking::CardPayment#pay-void": {
        "status": "voided"
      },
      "Banking::CardPayment#pay-chargeback": {
        "status": "charged_back"
      },
      "Banking::CardPayment#pay-reversal": {
        "status": "reversed"
      },
      "Banking::ExternalTransfer#ext-recall": {
        "status": "recalled"
      },
      "Banking::ExternalTransfer#ext-return": {
        "status": "returned"
      },
      "Banking::ScheduledPayment#schedule-execute": {
        "status": "executed"
      },
      "Banking::ScheduledPayment#schedule-cancel": {
        "status": "cancelled"
      }
    }
  },
