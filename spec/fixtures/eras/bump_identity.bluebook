Hecks.bluebook "Shaped" do
  aggregate "Customer" do
    identified_by :full_name

    attribute :full_name, FullName

    value_object "FullName" do
      attribute :value, String
    end
  end

  aggregate "Account" do
    reference_to Customer

    attribute :number,  AccountNumber
    attribute :balance, Money
    attribute :tags,    list_of(Tag)

    identified_by :number, :balance

    lifecycle :status, default: "open" do
      transition "Close" => "closed", from: "open"
    end

    value_object "AccountNumber" do
      attribute :value, String
    end

    # SINGLE-FIELD HERE, unlike base.bluebook's own Money — a bare
    # `identified_by :balance` only auto-unwraps when there is exactly
    # one field to unwrap to (ADR 0025, "Identity"); this fixture is
    # unused by any spec today, so trimming `currency` is the minimal
    # way to keep it syntactically valid rather than giving it a
    # dedicated identity field that would muddy what "bumped" here.
    value_object "Money" do
      attribute :cents, Integer
    end

    value_object "Tag" do
      attribute :value, String
    end

    command "Open" do
      attribute :number,  AccountNumber
      attribute :balance, Money

      emits "AccountOpened"
    end

    command "Close" do
      reference_to Account

      given("an account must be open to close") { status == "open" }

      emits "AccountClosed"
    end
  end
end
