Hecks.bluebook "Shaped" do
  aggregate "Customer" do
    identified_by :full_name

    attribute :full_name, FullName

    value_object "FullName" do
      attribute :value, String
    end
  end

  aggregate "Account" do
    identified_by :number

    # `as:` DELIBERATELY, not the bare default — these fixtures get
    # parsed BOTH live (minting the shape a real boot stores) AND under
    # EraGuard.shadow_parse (re-attestation's own mechanism for reading
    # HELD text), and a bare `reference_to`'s default name forks on
    # `MetaValidator.shadow_parsing?` (ADR 0025) — bare would mint
    # `customer` live and `customer_id` under shadow, a spurious shape
    # drift these era tests must not see. An explicit `as:` is stable
    # either way.
    reference_to Customer, as: :customer

    attribute :number,  AccountNumber
    attribute :balance, Money
    attribute :tags,    list_of(Tag)

    lifecycle :status, default: "open" do
      transition "Close" => "closed", from: "open"
    end

    value_object "AccountNumber" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents,    Integer
      attribute :currency, String, default: "USD"
    end

    value_object "Tag" do
      attribute :value, String
    end

    command "Open" do
      attribute :number,  AccountNumber
      attribute :balance, Money

      emits "AccountOpened"
    end

    command "Close" do
      reference_to Account

      given("an account must be open to close") { status == "open" }

      emits "AccountClosed"
    end
  end
end
