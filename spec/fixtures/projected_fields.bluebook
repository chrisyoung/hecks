
# A DEDICATED FIXTURE for S12 (ADR 0025, "Consistency across aggregate
# boundaries") — small enough to exercise `projects` end to end
# (declare, seal, seed-on-save, sweep, refuse-on-a-record-nothing-
# ever-seeded) without the real corpus's own scale. Banking's own
# Account carries the identical `projects :customer_status, from:
# :"customer.status"` wired into its own `given("customer is
# active")` for real now — this fixture stays a smaller, dedicated
# proof of the mechanism, not a stand-in for it.
Hecks.bluebook "ProjectedFields" do
  vision "A Customer's status, held locally on the Account that refers to it, rather than read live."
  core

  aggregate "Customer" do
    description "The record a Account's own projected field is a copy of."

    identified_by :ref

    attribute :ref, CustomerRef

    lifecycle :status, default: "active" do
      transition "Suspend" => "suspended", from: "active"
    end

    value_object "CustomerRef" do
      attribute :value, String
    end

    command "Register" do
      role "Clerk"
      goal "Open a customer record"

      attribute :ref, CustomerRef

      emits "CustomerRegistered"
    end

    command "Suspend" do
      role "Clerk"
      goal "Suspend a customer"

      reference_to Customer

      emits "CustomerSuspended"
    end
  end

  aggregate "Account" do
    description "Refers to a Customer, and holds a local copy of that Customer's own status."

    identified_by :ref

    attribute :ref, AccountRef
    reference_to Customer

    projects :customer_status, from: :"customer.status"

    value_object "AccountRef" do
      attribute :value, String
    end

    command "Open" do
      role "Clerk"
      goal "Open an account for a customer"

      reference_to Customer
      attribute :ref, AccountRef

      emits "AccountOpened"
    end

    # WHERE THIS FIXTURE READS THE PROJECTED FIELD — proving
    # `ProjectionAbsent` (a record a sweep, or a save, never reached)
    # and a successful read (seeded synchronously at save, or after a
    # sweep) both work, the same shape banking's own real `given
    # ("customer is active")` now relies on.
    command "CheckCustomerActive" do
      role "Clerk"
      goal "Confirm the locally-held customer status reads active"

      reference_to Account
      given("the projected customer status is active") { customer_status == "active" }

      emits "CustomerActiveChecked"
    end
  end
end
