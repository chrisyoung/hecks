
Hecks.bluebook "DispatchOrder" do
  vision "One command that creates, transitions, and mutates in a single dispatch, so a trace of it exercises every declared dispatch step exactly once."
  generic

  aggregate "Widget" do
    description "A row with a creating command that also transitions on arrival."

    identified_by { label.value }

    attribute :label,  Label
    attribute :amount, Amount

    lifecycle :status, default: "new" do
      transition "Open" => "active", from: "new"
    end

    value_object "Label" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a label is present") { !value.to_s.empty? }
    end

    value_object "Amount" do
      attribute :value, Integer
      invariant("an amount is non-negative") { value >= 0 }
    end

    value_object "PartSequence" do
      attribute :value, Integer
      invariant("a part sequence is positive") { value.positive? }
    end

    value_object "Note" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a note is present") { !value.to_s.empty? }
    end

    command "Open" do
      role "System"
      goal "Create a widget, transition it to active, and set its amount — one dispatch, every step"

      attribute :label,         Label
      attribute :amount,        Amount
      attribute :part_sequence, PartSequence
      attribute :part_note,     Note

      then_set :amount, to: :amount
      then_set :parts,  append: { sequence: :part_sequence, note: :part_note }

      ensures("the amount landed") { amount.cents == amount.cents }

      emits "WidgetOpened"
    end

    # NEITHER CREATING NOR TRANSITIONING — the DISPATCH_ORDER skip branch's
    # own fixture. `Open` above exercises every step, including both
    # conditionals firing ; nothing exercised either conditional's SKIP.
    command "Close" do
      role "System"
      goal "Act on an existing widget, creating and transitioning neither"

      reference_to Widget

      emits "WidgetClosed"
    end

    attribute :parts, list_of(Part)

    entity "Part" do
      description "A piece a widget holds, transitioned and mutated in one dispatch — no other test fixture needs real persistence to exercise entity dispatch order."

      identified_by { sequence.value }

      attribute :sequence, PartSequence
      attribute :note,     Note

      lifecycle :status, default: "new" do
        transition "Advance" => "done", from: "new"
      end

      command "Advance" do
        role "System"
        goal "Move a part to done and set its note — one dispatch, every entity step"

        attribute :note, Note

        then_set :note, to: :note

        ensures("the note landed") { note.value == note.value }

        emits "PartAdvanced"
      end

      # THE ENTITY TWIN of Widget's own `Close` — nothing in EntityDispatchOrder
      # is conditional on creation (an entity is never created through this
      # path at all), but advance_lifecycle still is, so this is that skip
      # branch's fixture.
      command "Touch" do
        role "System"
        goal "Act on a part without transitioning it"

        attribute :note, Note

        then_set :note, to: :note

        emits "PartTouched"
      end
    end
  end
end
