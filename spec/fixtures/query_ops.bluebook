
Hecks.bluebook "QueryOps" do
  vision "Every where-clause comparator, exercised at least once — this fixture is the corpus the real domains never needed."
  generic

  aggregate "Item" do
    description "A row with fields sized for every comparator: a status to equate, an amount to order, and tags to test membership both directions."

    # Its label is what says which row this is. Nothing is minted, so an
    # aggregate has to name the unchanging fact that identifies it.
    identified_by { label.value }

    attribute :label,  Label
    attribute :amount, Amount
    attribute :status, Status
    attribute :tags,   list_of(Tag)

    value_object "Label" do
      attribute :value, String
    end

    value_object "Amount" do
      attribute :value, Integer
    end

    value_object "Status" do
      attribute :value, String
    end

    value_object "Tag" do
      attribute :value, String
    end

    command "Add" do
      role "System"
      goal "Add one item"

      attribute :label,  Label
      attribute :amount, Amount
      attribute :status, Status
      attribute :tags,   list_of(Tag)

      emits "ItemAdded"
    end

    query "Eq" do
      where(status: "open")
    end

    query "Ne" do
      where(status: { ne: "open" })
    end

    query "Gt" do
      where(amount: { gt: 5 })
    end

    query "Gte" do
      where(amount: { gte: 5 })
    end

    query "Lt" do
      where(amount: { lt: 5 })
    end

    query "Lte" do
      where(amount: { lte: 5 })
    end

    query "In" do
      where(status: { in: "open,pending" })
    end

    query "Contains" do
      where(tags: { contains: "urgent" })
    end
  end
end
