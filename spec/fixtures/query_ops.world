Hecks.world "QueryOps" do
  realm "Specs"

  # The query-semantics tests boot this fixture concurrently and swap
  # in their own adapter after boot — persistence here is a prop, not
  # the subject. Ephemeral eras keep the boots out of the era gate (and
  # out of each other's way: parallel first boots racing to hold era 1
  # in one shared store is not a lineage fact worth recording).
  persisted_by("Memory") do
    eras "ephemeral"
  end
end
