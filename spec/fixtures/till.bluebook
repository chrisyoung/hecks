
Hecks.bluebook "TillRoom" do
  vision "A till takes money in and gives money out, and the drawer count is arithmetic — never a guess."
  core

  aggregate "Till" do
    description "One cash drawer and the count of cents inside it."

    identified_by { number.value }

    attribute :number,  TillNumber
    attribute :balance, Money, default: { cents: 0 }
    attribute :marks,   list_of(Mark)
    # A clerk may say why a taking was unusual, or say nothing — the one OPTIONAL
    # fact in this fixture, and the only door left through which an absent
    # argument can still reach a mutation. A REQUIRED one is refused at the
    # payload gate long before `then_set` ever resolves its source.
    attribute :note,    Note

    value_object "TillNumber" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a till number is present") { !value.to_s.empty? }
    end

    value_object "Money" do
      attribute :cents, Integer
      invariant("a cash amount is never negative") { cents >= 0 }
    end

    value_object "Mark" do
      attribute :amount,    Integer
      attribute :direction, String, pattern: '[^ \t\n\r]'
      invariant("a mark amount is positive") { amount.positive? }
      invariant("a mark direction is in or out") { direction == "in" || direction == "out" }
    end

    value_object "Note" do
      attribute :text, String, pattern: '[^ \t\n\r]'
      invariant("a note is present") { !text.to_s.empty? }
    end

    command "OpenTill" do
      role "Clerk"
      goal "Start the day with an empty drawer"

      attribute :number, TillNumber

      emits "TillOpened"
    end

    command "TakeIn" do
      role "Clerk"
      goal "Add cents to the drawer"

      reference_to Till
      attribute :amount, Money
      attribute :note,   Note, optional: true

      then_set :balance, increment: :amount
      then_set :marks,   append: { amount: :amount, direction: "in" }
      then_set :note,    to: :note

      emits "TakenIn"
    end

    command "PayOut" do
      role "Clerk"
      goal "Take cents out of the drawer"

      reference_to Till
      attribute :amount, Money

      then_set :balance, decrement: :amount
      then_set :marks,   append: { amount: :amount, direction: "out" }

      emits "PaidOut"
    end

    command "Bump" do
      role "Clerk"
      goal "Add the fixed float the branch always starts with"

      reference_to Till
      then_set :balance, increment: { cents: 500 }

      emits "Bumped"
    end
  end
end
