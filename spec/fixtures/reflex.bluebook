Hecks.bluebook "Reflex" do
  vision "An event arrives and a command fires — the whole of a policy, in one aggregate."
  core

  aggregate "Light" do
    description "A light that logs its own flip"

    attribute :condition, String

    command "Flip" do
      role "Operator"
      goal "Turn the light on"
      attribute :id, String

      then_set :condition, to: "on"

      emits "Flipped"
    end

    command "Log" do
      role "System"
      goal "Record that the flip was noticed"
      attribute :id, String

      then_set :condition, to: "logged"
    end

    policy "LogOnFlip" do
      on      "Flipped"
      trigger "Light.Log"
    end
  end

  aggregate "Echo" do
    description "A bell whose ring makes it ring"

    attribute :rings, Integer

    command "Ring" do
      role "Operator"
      goal "Ring the bell, which rings the bell"
      attribute :id, String

      emits "Rang"
    end

    policy "RingOnRang" do
      on      "Rang"
      trigger "Echo.Ring"
    end
  end
end
