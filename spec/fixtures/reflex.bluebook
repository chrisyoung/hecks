Hecks.bluebook "Reflex" do
  vision "An event arrives and a command fires — the whole of a policy, in one aggregate."
  core
  # Exercises `category` (docs/hecks-migration-findings.md, migration
  # plan task 4) somewhere in the corpus — spec/optionality_coverage_spec
  # holds every nullable field the wire carries to actually being filled
  # somewhere, and no fixture called this keyword before it existed.
  category "test-fixture"

  aggregate "Light" do
    description "A light that logs its own flip"

    identified_by { name.value }

    attribute :name,      LightName
    attribute :condition, LightCondition

    value_object "LightName" do
      attribute :value, String
    end

    value_object "LightCondition" do
      attribute :value, String
    end

    command "Flip" do
      role "Operator"
      goal "Turn the light on"

      attribute :name, LightName

      then_set :condition, to: { value: "on" }

      emits "Flipped"
    end

    # MUTATING, NOT CREATING — the policy this triggers re-dispatches it
    # against the SAME light `Flip` just created, and a creating command now
    # refuses a second creation over the same identity (see AlreadyExists).
    command "Log" do
      role "System"
      goal "Record that the flip was noticed"

      reference_to Light

      then_set :condition, to: { value: "logged" }
    end

    policy "LogOnFlip" do
      on      "Flipped"
      trigger "Light.Log"
    end

    # THE SPECIFICATION OPTIONS, EXERCISED SOMEWHERE.
    #
    # The language holds every option an ask can carry — offset, nulls,
    # authorize, consistency, freshness, inspect_query, use_index — as an open map,
    # (`cursor` is declared syntax too, but refused unconditionally at build —
    # see QueryBuilder#seal_cursor / ReadModelBuilder#seal_cursor — so it is
    # never exercised here or anywhere else),
    # and `Query.Option` is the verb that stores one. No bluebook in the corpus
    # declared any, so the judge never offered that verb and
    # spec/judge_coverage_spec called it decoration, correctly: a rule hanging off a
    # verb nothing dispatches cannot fire.
    #
    # Here rather than in banking on purpose. Adding an option to an example would
    # change that example's frozen IR for the sake of coverage alone. A fixture is
    # not in the frozen corpus, so this exercises the verb without disturbing any
    # golden.
    query "Lit" do
      description "Lights that are on, most recent first, with every option a query can carry"
      where(condition: "on")
      order_by :condition, :desc
      limit 10
      offset 5
      nulls :last
      authorize :operator_access, tenant: :condition
      consistency :snapshot, timeout: 2
      freshness :eventual, max_age: 30
      inspect_query :sql
      # TWO HINTS, because `index_hints` is a list and one hint could never tell
      # a list from a scalar. A hint is advisory — it cannot change an answer,
      # only the work done to reach it — so a second one costs nothing to mean.
      use_index :condition_index
      use_index :recency_index
    end
  end

  aggregate "Echo" do
    description "A bell whose ring makes it ring"

    identified_by { name.value }

    attribute :name,  BellName
    attribute :rings, RingCount

    value_object "BellName" do
      attribute :value, String
    end

    value_object "RingCount" do
      attribute :value, Integer
    end

    command "Install" do
      role "Operator"
      goal "Hang a bell that can be rung"

      attribute :name, BellName

      emits "Installed"
    end

    # MUTATING, NOT CREATING — a self-triggering policy re-dispatches this
    # with the same identity every time the reaction feeds itself, and a
    # creating command refuses a second creation over the same identity now
    # (see AlreadyExists). The infinite-loop guard this fixture exists to
    # prove (`MAX_REACTION_DEPTH`) needs the SAME record ringable arbitrarily
    # many times, which is exactly what a mutating command is for.
    command "Ring" do
      role "Operator"
      goal "Ring the bell, which rings the bell"

      reference_to Echo

      emits "Rang"
    end

    policy "RingOnRang" do
      on      "Rang"
      trigger "Echo.Ring"
    end
  end

  aggregate "Beacon" do
    description "A beacon that signals a domain which is not loaded — the undeliverable reaction, which must be recorded rather than swallowed"

    identified_by { signal.value }

    attribute :signal, SignalName

    value_object "SignalName" do
      attribute :value, String
    end

    command "Raise" do
      role "Operator"
      goal "Raise the beacon and announce it outward"

      emits "Raised"
    end

    policy "NotifyOnRaise" do
      on      "Raised"
      trigger "Notifications.Send"
      across  "Notifications"
    end
  end

  # A read model carrying the same options an ask does — the other half of the
  # coverage gap. `ReadModel.Option` is declared in the language and no corpus read
  # model exercised it, so the judge never offered it. Its filters (where, order_by,
  # limit) are deliberately absent: `ReadModel#to_h` omits those,
  # so declaring them here would claim a wire contract that does not
  # exist. See spec/orchestration_spec's gap list.
  report "Signals" do
    description "Every echo gathered around a light, with the options a projection can carry"
    reference_to Light

    include Echo

    offset 5
    nulls :last
    authorize :operator_access, tenant: :condition
    freshness :bounded, max_age: 60
    inspect_query :sql
    use_index :condition_index
  end
end
