Hecks.bluebook "Reflex" do
  vision "An event arrives and a command fires — the whole of a policy, in one aggregate."
  core

  aggregate "Light" do
    description "A light that logs its own flip"

    attribute :condition, LightCondition

    value_object "LightCondition" do
      attribute :value, String
    end

    command "Flip" do
      role "Operator"
      goal "Turn the light on"

      then_set :condition, to: { value: "on" }

      emits "Flipped"
    end

    command "Log" do
      role "System"
      goal "Record that the flip was noticed"

      then_set :condition, to: { value: "logged" }
    end

    policy "LogOnFlip" do
      on      "Flipped"
      trigger "Light.Log"
    end

    # THE SPECIFICATION OPTIONS, EXERCISED SOMEWHERE.
    #
    # The language holds every option an ask can carry — offset, cursor, nulls,
    # authorize, consistency, freshness, inspect_query, use_index — as an open map,
    # and `Query.Option` is the verb that stores one. No bluebook in the corpus
    # declared any, so the judge never offered that verb and
    # spec/judge_coverage_spec called it decoration, correctly: a rule hanging off a
    # verb nothing dispatches cannot fire.
    #
    # Here rather than in banking on purpose. Adding an option to an example would
    # change that example's IR, and the Rust parser's Query struct does not carry
    # these yet — parity would split at stage one. A fixture is not in the parity
    # corpus, so this exercises the verb without claiming both runtimes read it.
    query "Lit" do
      description "Lights that are on, most recent first, with every option a query can carry"
      where(condition: "on")
      order_by :condition, :desc
      limit 10
      offset 5
      cursor :after
      nulls :last
      authorize :operator_access, tenant: :condition
      consistency :snapshot, timeout: 2
      freshness :eventual, max_age: 30
      inspect_query :sql
      use_index :condition_index
    end
  end

  aggregate "Echo" do
    description "A bell whose ring makes it ring"

    attribute :rings, RingCount

    value_object "RingCount" do
      attribute :value, Integer
    end

    command "Ring" do
      role "Operator"
      goal "Ring the bell, which rings the bell"

      emits "Rang"
    end

    policy "RingOnRang" do
      on      "Rang"
      trigger "Echo.Ring"
    end
  end

  aggregate "Beacon" do
    description "A beacon that signals a domain which is not loaded — the undeliverable reaction, which must be recorded rather than swallowed"

    attribute :signal, SignalName

    value_object "SignalName" do
      attribute :value, String
    end

    command "Raise" do
      role "Operator"
      goal "Raise the beacon and announce it outward"

      emits "Raised"
    end

    policy "NotifyOnRaise" do
      on      "Raised"
      trigger "Notifications.Send"
      across  "Notifications"
    end
  end

  # A read model carrying the same options an ask does — the other half of the
  # coverage gap. `ReadModel.Option` is declared in the language and no corpus read
  # model exercised it, so the judge never offered it. Its filters (where, order_by,
  # limit) are deliberately absent: `ReadModel#to_h` omits those and so does Rust's
  # ReadModel struct, so declaring them here would claim a contract that does not
  # exist. See spec/orchestration_spec's gap list.
  read_model "Signals" do
    description "Every echo gathered around a light, with the options a projection can carry"
    reference_to Light

    include Echo

    offset 5
    cursor :after
    nulls :last
    authorize :operator_access, tenant: :condition
    freshness :bounded, max_age: 60
    inspect_query :sql
    use_index :condition_index
  end
end
