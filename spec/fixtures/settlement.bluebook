
Hecks.bluebook "Wire" do
  vision "Money leaves one drawer for another, and something remembers which half happened."
  core

  aggregate "Drawer" do
    identified_by { number.value }

    attribute :number, DrawerNumber
    attribute :cents, Money, default: { cents: 0 }

    value_object "DrawerNumber" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents, Integer
    end

    lifecycle :status, default: "open" do
      transition "Shut" => "shut", from: "open"
      transition "Reopen" => "open", from: "shut"
    end

    command "Open" do
      role "Clerk"
      goal "A new drawer"
      attribute :number, DrawerNumber
      emits "DrawerOpened"
    end

    command "Put" do
      role "Clerk"
      goal "Money in"
      reference_to Drawer
      attribute :amount, Money
      given("the drawer is open") { status == "open" }
      then_set :cents, increment: :amount
      emits "PutIn"
    end

    command "Take" do
      role "Clerk"
      goal "Money out"
      reference_to Drawer
      attribute :amount, Money
      given("the drawer is open")  { status == "open" }
      given("the cents cover it")  { cents.cents >= amount.cents }
      then_set :cents, decrement: :amount
      emits "Taken"
    end

    command "Shut" do
      role "Clerk"
      goal "Shut the drawer"
      reference_to Drawer
      emits "DrawerShut"
    end

    command "Reopen" do
      role "Clerk"
      goal "Open it again"
      reference_to Drawer
      emits "DrawerReopened"
    end
  end

  aggregate "Wire" do
    attribute :amount,      Money, default: { cents: 0 }
    reference_to Drawer, as: :source
    reference_to Drawer, as: :destination

    value_object "Money" do
      attribute :cents, Integer
    end

    lifecycle :status, default: "asked" do
      transition "Moved"    => "moved",    from: "asked"
      transition "Landed"   => "landed",   from: "moved"
      transition "Returned" => "returned", from: "moved"
    end

    command "Ask" do
      role "Customer"
      goal "Move money between drawers"
      attribute :amount,      Money
      reference_to Drawer, as: :source
      reference_to Drawer, as: :destination
      given("a wire moves something") { amount.cents.positive? }
      then_set :amount,      to: :amount
      then_set :source,      to: :source
      then_set :destination, to: :destination
      emits "WireAsked"
    end

    command "Moved" do
      role "System"
      goal "The source gave it up"
      reference_to Wire
      emits "WireMoved"
    end

    command "Landed" do
      role "System"
      goal "The destination has it"
      reference_to Wire
      emits "WireLanded"
    end

    command "Returned" do
      role "System"
      goal "It went back"
      reference_to Wire
      emits "WireReturned"
    end
  end

  process_manager "Carry" do
    correlates_by :wire
    starts_on "WireAsked"
    ends_on   "WireLanded"

    state "asked"
    state "carrying"
    state "landed"
    state "returned"

    on "WireAsked", transition: { "asked" => "asked" } do
      dispatch "Wire::Drawer.Take", with: { number: :source, amount: :amount, wire: :wire }
    end

    on "Taken", transition: { "asked" => "carrying" } do
      dispatch "Wire::Wire.Moved",  with: { wire: :wire }
      dispatch "Wire::Drawer.Put",  with: { number: :destination, amount: :amount, wire: :wire }
    end

    on "PutIn", transition: { "carrying" => "landed" } do
      dispatch "Wire::Wire.Landed", with: { wire: :wire }
    end

    # The compensating leg, and its trigger is a REFUSAL rather than an event —
    # no aggregate announces "the leg you dispatched was declined". It used to
    # hang off "WireReturned", which meant a human had to notice the wire had
    # stalled and dispatch Wire.Returned by hand ; until they did, the money was
    # out of the source drawer and nowhere else.
    on :refused, transition: { "carrying" => "returned" } do
      dispatch "Wire::Drawer.Put",    with: { number: :source, amount: :amount, wire: :wire }
      dispatch "Wire::Wire.Returned", with: { wire: :wire }
    end
  end
end
