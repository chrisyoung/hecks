{
  "name": "playaprep-parity",
  "note": "One expedition through prep, shopping, gas stops, and every lifecycle transition; a shared waypoint pin; a burner met, connected, and skill-tagged; a trivia question authored and answered once. Every declared command exercised, plus three real refusal paths: a duplicate prep-task id, MarkReady before every task is done, and answering the same trivia question twice.",
  "domain": "examples/playaprep",
  "expectations": {
    "events": 21,
    "refusals": [
      {
        "verb": "PlayaPrep::Expedition.AddPrepTask",
        "includes": "task ids are unique"
      },
      {
        "verb": "PlayaPrep::Expedition.MarkReady",
        "includes": "every prep task is done"
      },
      {
        "verb": "PlayaPrep::TriviaSession.AnswerQuestion",
        "includes": "not already answered this session"
      }
    ]
  },
  "steps": [
