{
  "name": "interview-session",
  "note": "One discovery session end to end: questions asked from all three sources, an answer, a finding cited and confirmed, and a proposal carried through accept to written, then corrected once a downstream mistake surfaced (the written record stays, only its replay stops). Also pins the two rules this chapter can actually enforce — a catalogue question must name its catalogue entry, and a session that asked nothing cannot be concluded.",
  "expectations": {
    "event_names": [
      "InterviewOpened",
      "QuestionAsked",
      "QuestionAnswered",
      "StandingQuestionPublished",
      "FindingEstablished",
      "EvidenceCited",
      "FindingConfirmed",
      "ChangeProposed",
      "ArgumentSupplied",
      "ChangeAccepted",
      "ChangeWritten",
      "ChangeCorrected",
      "InterviewConcluded"
    ],
    "refusals": [
      {
        "verb": "Interview::Interview.Ask",
        "includes": "a catalogue question names the entry it came from"
      },
      {
        "verb": "Interview::Interview.Conclude",
        "includes": "an interview that asked nothing has discovered nothing"
      }
    ],
    "events": 16
  },
  "steps": [
