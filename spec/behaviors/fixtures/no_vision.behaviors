Hecks.behaviors "NoVision" do
  loads "../../../examples/pizzas/bluebook/pizzas.bluebook", "../../../examples/pizzas/pizzas_behaviors.hecksagon"

  test "never reached" do
    tests "CreatePizza", on: "Order"
