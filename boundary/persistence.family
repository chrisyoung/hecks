# persistence — an impure-boundary PORT, declared once and used across every
# domain's hexagon.
#
# A family names its how-verb, its signal, and the config FIELD NAMES its
# adapters carry — names only ; the per-deployment values live in .world. A
# family NEVER names its adapters : the adapter declares the family.
Hecks.family "persistence" do
  verb   "persisted_by"   # the how-verb a bind hangs off the aggregate
  signal :reply           # returns a value to the domain (find / save)
  field  :database        # WHERE the store writes ; value supplied in .world
end
