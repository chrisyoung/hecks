  "source_text": "Hecks.bluebook \"Roster\" do\n  vision \"A crew roster: seats added one at a time, members enlisted, each seated once — the smallest domain whose every rule is a question asked of a LIST.\"\n  supporting\n\n  # THE ENUMERATION OPERATORS' OWN EXAMPLE. Every given below is a block\n  # predicate — `.none?`/`.any?`/`.all?`/`.find { |x| … }` — over one of\n  # three list attributes (a value-object list, an entity list, a\n  # value-object list holding references), including one block nested\n  # inside another that reads the outer block's own parameter. That is\n  # the shape the chess and shipping domains lean on for every occupancy,\n  # path-clearance, and itinerary rule, reduced to the fewest moving\n  # parts that still exercise each operator on each element kind — so\n  # `spec/corpus/rust_conformance/roster.json` can hold the Rust kernel's\n  # `expression_operators/enumeration.rs` to Ruby's own\n  # `Resolver#evaluate_block_predicate`/`#found_of`, dispatch for\n  # dispatch, refusal for refusal.\n  aggregate \"Roster\" do\n    description \"One roster: its seats, its crew, and who sits where.\"\n\n    attribute :name,        RosterName\n    attribute :seats,       list_of(Seat)\n    attribute :crew,        list_of(Member)\n    attribute :assignments, list_of(Assignment)\n\n    identified_by :name\n\n    value_object(\"RosterName\") { attribute :value, String }\n    value_object(\"MemberId\")   { attribute :value, String }\n    value_object(\"SeatNumber\") { attribute :value, Integer }\n    value_object(\"Age\")        { attribute :value, Integer }\n\n    value_object \"Row\" do\n      attribute :value, String, one_of: [\"front\", \"back\"]\n    end\n\n    value_object \"Seat\" do\n      attribute :number, SeatNumber\n      attribute :row,    Row\n    end\n\n    value_object \"Assignment\" do\n      attribute :member, MemberId\n      attribute :number, SeatNumber\n    end\n\n    entity \"Member\" do\n      description \"One enlisted member — an entity, so the crew list's elements are entity records, not value objects.\"\n\n      attribute :id,  MemberId\n      attribute :age, Age\n\n      identified_by :id\n    end\n\n    command \"Open\" do\n      goal \"Start an empty roster\"\n\n      attribute :name, RosterName\n\n      emits \"RosterOpened\"\n    end\n\n    command \"AddSeat\" do\n      goal \"Add a numbered seat in the front or back row — numbers never repeat\"\n\n      reference_to Roster\n      attribute :number, SeatNumber\n      attribute :row,    Row\n\n      given(\"seat numbers are unique\") { seats.none? { |s| s.number.value == number.value } }\n\n      sets :seats, append: { number: :number, row: :row }\n\n      emits \"SeatAdded\"\n    end\n\n    command \"Enlist\" do\n      goal \"Enlist a member while a seat is still free for them — nobody enlists twice\"\n\n      reference_to Roster\n      attribute :id,  MemberId\n      attribute :age, Age\n\n      given(\"nobody enlists twice\") { crew.none? { |m| m.id.value == id.value } }\n      # A block INSIDE a block, the inner one reading the outer one's own\n      # parameter — \"some seat has no assignment naming its number\".\n      given(\"an open seat remains\") { seats.any? { |s| assignments.none? { |a| a.number.value == s.number.value } } }\n\n      sets :crew, append: { id: :id, age: :age }\n\n      emits \"MemberEnlisted\"\n    end\n\n    command \"Assign\" do\n      goal \"Seat an enlisted member in an existing, free seat — once; the front row is for members of age\"\n\n      reference_to Roster\n      attribute :member, MemberId\n      attribute :number, SeatNumber\n\n      given(\"the member is enlisted\")       { crew.any? { |m| m.id.value == member.value } }\n      given(\"the seat exists\")              { seats.any? { |s| s.number.value == number.value } }\n      given(\"the seat is free\")             { assignments.none? { |a| a.number.value == number.value } }\n      given(\"the member sits nowhere else\") { assignments.none? { |a| a.member.value == member.value } }\n      # `.find { }` projected through a path, OR'd with an `.all?` whose\n      # predicate is an implication over the whole crew.\n      given(\"a front-row seat takes a member of age\") do\n        seats.find { |s| s.number.value == number.value }.row.value == \"back\" ||\n          crew.all? { |m| m.id.value != member.value || m.age.value >= 21 }\n      end\n\n      sets :assignments, append: { member: :member, number: :number }\n\n      emits \"SeatAssigned\"\n    end\n  end\nend\n"
}