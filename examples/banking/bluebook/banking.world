Hecks.world "Banking" do
  realm "Examples"
  persisted_by("Heki") do
    dir "data"
  end

  projected_by("SqliteProjection") do
    database "data/banking_projection.sqlite3"
  end

  # bin/project_deploy's own real target — `deployed_to` is a generic
  # settings-bag verb, the same way `persisted_by`/`projected_by` are;
  # nothing about WorldBuilder needed to change for this to work.
  deployed_to("AwsLambda") do
    region "us-east-1"
    memory 512
    timeout 10
    # THE STOREHOUSE — no RDS/VPC of Banking's own anymore. Borrows
    # Embryonaut's already-live instance instead, isolated by its own
    # native Postgres schema (banking.*, created directly by this
    # domain's own provisioning on next deploy — Banking isn't
    # production, so there's no existing data to migrate).
    database "Shared"
    owner "Embryonaut"
  end
end
