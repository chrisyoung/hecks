Hecks.hecksagon "Banking" do
  uses_framework "Governance"
  uses_framework "Identity"

  # Domain-level default — every aggregate below inherits both, no
  # per-aggregate line needed. A genuine exception (like Embryonaut's
  # `Member`) would still declare its own `Banking::Whatever.persisted_by(...)`
  # override here; none of Banking's own aggregates need one.
  persisted_by "Heki"
  projected_by "SqliteProjection"
end

# A FRAMEWORK MEMBER BRINGS ITS OWN SHAPE, NOT ITS OWN PERSISTENCE —
# `Framework.load!` (`uses_framework`, above) only loads the bluebook.
# Binding `Governance::RoleAssignment` etc. INSIDE Banking's own
# hecksagon would not work even syntactically-correctly written:
# `Ports::Persistence::BindingPolicy.resolve` looks up
# `registry.hecksagon(aggregate's OWN domain)`, not the domain doing the
# binding — a persistence bind belongs in a hecksagon registered under
# the SAME name as the aggregate's own chapter, the one invariant this
# runtime holds everywhere else too. So this is a second, SIBLING
# hecksagon — same shape framework/bluebook/governance.hecksagon and
# identity.hecksagon used to be, before persistence became the
# consumer's decision instead of the framework member's own default.
# Memory here because this is a spec/example corpus member, not a real
# deployment — a real app (see embryonaut's own hecksagon) binds these
# to something durable instead.
Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end

Hecks.hecksagon "Identity" do
  # `Identity::Identity.Register` declares `role "Identity registrar"` —
  # same reason this sibling attaches Governance as `Banking` and
  # `Governance` (above) both do: a declared role is only real access
  # control once Governance can check it against something (S8).
  uses_framework "Governance"
  Identity::Identity.persisted_by("Memory")
  Identity::ExternalIdentifier.persisted_by("Memory")
end

# COMPLIANCE IS DELIBERATELY NOT `uses_framework`'d HERE, unlike
# Governance/Identity above — it's a genuine standalone domain (its own
# examples/compliance/, its own deploy, its own Lambda), reached only
# through the two `across "Compliance"` policies below (real cross-
# domain delivery, rust/host's own lambda_client.rs). A domain that
# wants Compliance's Review aggregates IN-PROCESS instead can still
# `uses_framework "Compliance"` — the bluebook itself supports either
# consumption mode (lib/hecksagain/framework/bluebook/compliance.
# bluebook's own header) — Banking's own choice here is cross-Lambda,
# on purpose, to prove that path for real.
