Hecks.bluebook "Roster" do
  vision "A crew roster: seats added one at a time, members enlisted, each seated once — the smallest domain whose every rule is a question asked of a LIST."
  supporting

  # THE ENUMERATION OPERATORS' OWN EXAMPLE. Every given below is a block
  # predicate — `.none?`/`.any?`/`.all?`/`.find { |x| … }` — over one of
  # three list attributes (a value-object list, an entity list, a
  # value-object list holding references), including one block nested
  # inside another that reads the outer block's own parameter. That is
  # the shape the chess and shipping domains lean on for every occupancy,
  # path-clearance, and itinerary rule, reduced to the fewest moving
  # parts that still exercise each operator on each element kind — so
  # `spec/corpus/rust_conformance/roster.json` can hold the Rust kernel's
  # `expression_operators/enumeration.rs` to Ruby's own
  # `Resolver#evaluate_block_predicate`/`#found_of`, dispatch for
  # dispatch, refusal for refusal.
  aggregate "Roster" do
    description "One roster: its seats, its crew, and who sits where."

    attribute :name,        RosterName
    attribute :motto,       Motto
    attribute :mood,        Mood
    attribute :standing,    Standing
    attribute :last_marked, SeatNumber
    attribute :seats,       list_of(Seat)
    attribute :crew,        list_of(Member)
    attribute :assignments, list_of(Assignment)

    identified_by :name

    value_object("RosterName") { attribute :value, String }
    # SCALAR LITERALS INTO SINGLE-FIELD VALUE OBJECTS — `sets :motto, to:
    # "all hands"` (a plain one-field VO), `sets :mood, to: "open"` and
    # `to: "busy"` (a closed set), and Enlist's `rank: "hand"` appended
    # into an entity's own closed-set field: the runtime's own rewrap of
    # a bare literal into the sole field, which every projection has to
    # bridge the same way (a chess rook's `sets :moved, to: "moved"`).
    value_object("Motto") { attribute :value, String }

    value_object "Mood" do
      attribute :value, String, one_of: ["open", "busy"]
    end

    value_object "Rank" do
      attribute :value, String, one_of: ["hand", "officer"]
    end

    # ONE CLOSED SET INTO ANOTHER — `Honor` sets `standing` FROM a `Rank`
    # argument: every Rank member is a Standing member, so the bridge can
    # never refuse (chess: a `Color` into a `DrawOffer`, none/white/black).
    value_object "Standing" do
      attribute :value, String, one_of: ["none", "hand", "officer"]
    end
    value_object("MemberId")   { attribute :value, String }
    value_object("SeatNumber") { attribute :value, Integer }
    value_object("Age")        { attribute :value, Integer }

    value_object "Row" do
      attribute :value, String, one_of: ["front", "back"]
    end

    value_object "Seat" do
      attribute :number, SeatNumber
      attribute :row,    Row
    end

    value_object "Assignment" do
      attribute :member, MemberId
      attribute :number, SeatNumber
    end

    entity "Member" do
      description "One enlisted member — an entity, so the crew list's elements are entity records, not value objects."

      attribute :id,   MemberId
      attribute :age,  Age
      attribute :rank, Rank

      identified_by :id

      lifecycle :status, default: "active" do
        transition "Retire" => "retired", from: "active"
      end

      # THE ENTITY COMMAND A DOOR DELEGATES TO — see `Roster.Retire` below.
      # Its given and its ensures both read `parent`: the given the
      # roster as it stands (a front-row holder may not leave), the
      # ensures the roster AFTER this member's own status has changed
      # (someone must still be serving) — the second is only right if the
      # parent seen by the ensures already carries the mutated element.
      command "Retire" do
        goal "Leave the crew — unless seated in the front row, and never as the last one serving"

        # An entity command naming its OWN identity as an optional
        # argument — a chess `Pawn.Promote` declares `id` this way so the
        # crowning policy's projection may read it. Not an identity
        # source: the element is already addressed before this runs.
        attribute :id, MemberId, optional: true

        given("a front-row holder may not retire") do
          parent.assignments.none? { |a| a.member.value == id.value && parent.seats.any? { |s| s.number.value == a.number.value && s.row.value == "front" } }
        end

        ensures("someone still serves") { parent.crew.any? { |m| m.status == "active" } }

        emits MemberRetired
      end
    end

    command "Open" do
      goal "Start an empty roster"

      attribute :name, RosterName

      sets :motto,    to: "all hands"
      sets :mood,     to: "open"
      sets :standing, to: "none"

      emits RosterOpened
    end

    # TWO REACTION SHAPES A CHESS BOARD LEANS ON. `Mark` takes an argument
    # named `to` — a policy projecting `with: { to: :number }` hands it a
    # FACT named `to`, never a routing receiver (chess: OpenEnPassant's
    # `with: { to: :to }`). `Notice` is reached by a policy with NO
    # projection off an event whose payload carries `to`: the legacy
    # forward lifts the receiver INTO `to`, so the payload's own `to` never
    # reaches Notice as a fact (chess: every AdvancePly after a move).
    command "Mark" do
      goal "Remember the last seat handed out"

      reference_to Roster
      attribute :to, SeatNumber

      sets :last_marked, to: :to

      emits SeatMarked
    end

    command "Notice" do
      goal "Take note that a seat was marked — nothing to record"

      reference_to Roster
      attribute :to, SeatNumber, optional: true

      emits MarkNoticed
    end

    command "Honor" do
      goal "Record the roster's standing as one member's rank"

      reference_to Roster
      attribute :rank, Rank

      sets :standing, to: :rank

      emits RosterHonored
    end

    command "AddSeat" do
      goal "Add a numbered seat in the front or back row — numbers never repeat"

      reference_to Roster
      attribute :number, SeatNumber
      attribute :row,    Row

      given("seat numbers are unique") { seats.none? { |s| s.number.value == number.value } }

      sets :seats, append: { number: :number, row: :row }

      emits SeatAdded
    end

    command "Enlist" do
      goal "Enlist a member while a seat is still free for them — nobody enlists twice"

      reference_to Roster
      attribute :id,  MemberId
      attribute :age, Age

      given("nobody enlists twice") { crew.none? { |m| m.id.value == id.value } }
      # A block INSIDE a block, the inner one reading the outer one's own
      # parameter — "some seat has no assignment naming its number".
      given("an open seat remains") { seats.any? { |s| assignments.none? { |a| a.number.value == s.number.value } } }

      sets :crew, append: { id: :id, age: :age, rank: "hand" }

      emits MemberEnlisted
    end

    command "Assign" do
      goal "Seat an enlisted member in an existing, free seat — once; the front row is for members of age"

      reference_to Roster
      attribute :member, MemberId
      attribute :number, SeatNumber

      given("the member is enlisted")       { crew.any? { |m| m.id.value == member.value } }
      given("the seat exists")              { seats.any? { |s| s.number.value == number.value } }
      given("the seat is free")             { assignments.none? { |a| a.number.value == number.value } }
      given("the member sits nowhere else") { assignments.none? { |a| a.member.value == member.value } }
      # `.find { }` projected through a path, OR'd with an `.all?` whose
      # predicate is an implication over the whole crew.
      given("a front-row seat takes a member of age") do
        seats.find { |s| s.number.value == number.value }.row.value == "back" ||
          crew.all? { |m| m.id.value != member.value || m.age.value >= 21 }
      end

      sets :assignments, append: { member: :member, number: :number }
      sets :mood, to: "busy"

      emits SeatAssigned
    end

    # THE DOOR — `delegates_to`: the roster-level command a caller
    # dispatches, handing the SAME dispatch to one member's own Retire,
    # atomically: the member's refusal is this command's refusal, its
    # event is this command's event. `with:` names which door argument
    # feeds which target argument (here the element's own identity).
    command "Retire" do
      goal "Retire one member, on the caller's behalf"

      reference_to Roster
      attribute :id, MemberId

      delegates_to "Member.Retire", with: { id: :id }
    end
  end

  policy "OnSeatAssignedMark" do
    on Roster::SeatAssigned
    trigger Roster::Mark, with: { to: :number }
  end

  policy "OnSeatMarkedNotice" do
    on Roster::SeatMarked
    trigger Roster::Notice
  end

  # A `where` — the reaction happens only when the payload says so
  # (chess: four crowning policies on one PawnPromoted, each `where {
  # piece == "…" }`); `with:` here carries a LITERAL, not a payload field.
  policy "OnSeatAssignedHonorFront" do
    on Roster::SeatAssigned
    where { number.value == 1 }
    trigger Roster::Honor, with: { rank: "officer" }
  end
end
