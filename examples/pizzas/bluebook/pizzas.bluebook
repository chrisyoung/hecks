# Pizzas — the canonical example. Everything hecksagain grows should reference
# this domain, and when it lacks a shape, this domain gets extended.
#
# Deliberately small: a pizza gathers toppings and is eventually sold. The
# interesting parts are the ones that carry weight — `toppings` is a list of
# Topping value objects with an invariant, and Purchase is guarded by givens
# that make a sale impossible before the pizza is ready.
Hecks.bluebook "Pizzas" do
  vision "Put toppings on a pizza and sell it to a customer."
  core

  aggregate "Pizza" do
    description "A pizza that gathers toppings and is eventually sold to a customer."

    attribute :name,          String
    attribute :toppings,      list_of(Topping)
    attribute :price_cents,   Integer
    attribute :status,        String, default: "available"
    attribute :customer_name, String

    # A topping has no identity of its own — two basils in the same amount are
    # the same topping. Its invariant is enforced before it ever reaches the
    # pizza.
    value_object "Topping" do
      attribute :name,   String
      attribute :amount, Integer

      invariant("amount must be positive") { amount > 0 }
    end

    command "CreatePizza" do
      role "Chef"
      goal "Put a new pizza on the menu"

      attribute :name,        String
      attribute :price_cents, Integer

      emits "PizzaCreated"
    end

    command "AddTopping" do
      role "Chef"
      goal "Customize a pizza with an ingredient"

      reference_to Pizza
      attribute :name,   String
      attribute :amount, Integer

      given("a sold pizza cannot be changed") { status == "available" }
      given("at most 10 toppings")            { toppings.size < 10 }

      then_set :toppings, append: { name: :name, amount: :amount }

      emits "ToppingAdded"
    end

    command "Purchase" do
      role "Customer"
      goal "Buy the pizza"

      reference_to Pizza
      attribute :customer_name, String

      given("a pizza needs at least one topping") { toppings.size.positive? }
      given("it must still be available")         { status == "available" }

      then_set :customer_name, to: :customer_name
      then_set :status,        to: "sold"

      emits "PizzaPurchased"
    end
  end
end
