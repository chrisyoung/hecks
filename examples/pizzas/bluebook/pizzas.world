# The per-deployment VALUES the bound adapters need — and only values.
#
# This file MIRRORS the hecksagon's shape : the same how-verb selector, carrying
# values instead of wiring. You read one line in each and know the whole edge.
# The path is relative to the domain directory.
Hecks.world "Pizzas" do
  persisted_by("Sqlite") do
    database "data/pizzas.db"
  end
end
